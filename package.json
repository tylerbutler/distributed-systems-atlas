{
  "name": "distributed-systems-atlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm toolkit:build && astro dev",
    "toolkit:build": "cd toolkit && gleam build",
    "toolkit:test": "cd toolkit && gleam test",
    "toolkit:check": "tsc --ignoreConfig --noEmit --strict --skipLibCheck false --target ES2022 --module NodeNext --moduleResolution NodeNext toolkit/index.ts",
    "toolkit:smoke": "node --experimental-strip-types toolkit/smoke.mjs",
    "check": "pnpm toolkit:build && pnpm toolkit:check && pnpm toolkit:smoke && astro check && tsc --noEmit",
    "test": "pnpm toolkit:test && vitest run",
    "test:browser": "pnpm toolkit:build && playwright test",
    "verify": "pnpm check && pnpm test && pnpm test:browser && astro build",
    "build": "pnpm check && pnpm test && astro build"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@atlas/toolkit": "workspace:*",
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/encode-sans": "^5.3.0",
    "@fontsource-variable/roboto-serif": "^5.3.0",
    "astro": "^7.3.3",
    "astro-tinylytics": "^0.1.0",
    "phoenix": "^1.8.14",
    "rough-notation": "^0.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}