{
  "PostToolUse": [
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Checking UI changes",
          "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/plugin/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/hooks/plugin/skills/impeccable/scripts/impeccable\" hook",
          "timeout": 5
        }
      ],
      "_apm_source": "pbakaus/impeccable/plugin"
    }
  ],
  "Stop": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Design deep pass",
          "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/plugin/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/hooks/plugin/skills/impeccable/scripts/impeccable\" hook",
          "timeout": 30
        }
      ],
      "_apm_source": "pbakaus/impeccable/plugin"
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup|resume|clear|compact",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Loading ponytail mode...",
          "command": "node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-activate.js'))\"",
          "timeout": 15
        }
      ],
      "_apm_source": "dietrichgebert/ponytail"
    },
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Preparing build session",
          "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/plugin/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/hooks/plugin/skills/impeccable/scripts/impeccable\" hook",
          "timeout": 5
        }
      ],
      "_apm_source": "pbakaus/impeccable/plugin"
    }
  ],
  "SubagentStart": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Loading ponytail mode...",
          "command": "node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-subagent.js'))\"",
          "timeout": 15
        }
      ],
      "_apm_source": "dietrichgebert/ponytail"
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Tracking ponytail mode...",
          "command": "node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-mode-tracker.js'))\"",
          "timeout": 15
        }
      ],
      "_apm_source": "dietrichgebert/ponytail"
    }
  ]
}
