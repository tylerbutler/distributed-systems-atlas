---
import DemoTransportControls from "./DemoTransportControls.astro";
import StationMark from "./StationMark.astro";
import {
  createMapDemo,
  mapUserName,
  type MapKind,
  type MapOperation,
  type ReplicaId,
} from "../lib/structure-demo/map-demo";
import "../styles/map-demo.css";

interface Props {
  kind: MapKind;
  title: string;
  description: string;
  rule: string;
  raceLabel: string;
}

const { kind, title, description, rule, raceLabel } = Astro.props;
const initial = createMapDemo(kind);
const statusByReplica: Record<ReplicaId, string> = {
  A: "Trail open",
  B: "Trail closed",
  C: "Inspect bridge",
};
const sharedMapOperations: Pick<MapOperation, "action" | "key" | "value">[] = [
  { action: "set", key: "gate-status", value: "Trail open" },
  { action: "set", key: "gate-status", value: "Trail closed" },
  { action: "set", key: "bridge-status", value: "Bridge clear" },
];

function operationFor(replica: ReplicaId): MapOperation {
  if (kind === "or-map") {
    return replica === "A"
      ? { author: replica, action: "remove", key: "Eagle Creek", value: "" }
      : {
        author: replica,
        action: "increment",
        key: "Eagle Creek",
        value: replica === "B" ? "3" : "1",
      };
  }
  if (kind === "shared-directory") {
    return { author: replica, action: "mkdir", key: "eagle-creek", value: "" };
  }
  return {
    author: replica,
    action: "set",
    key: "gate-status",
    value: statusByReplica[replica],
  };
}

function buttonLabel(operation: MapOperation): string {
  if (operation.action === "remove") return "Remove Eagle Creek";
  if (operation.action === "increment") return `Add ${operation.value} crates`;
  return `Write ${operation.value}`;
}

function raceSlip(replica: ReplicaId): { body: string; evidence: string } {
  if (replica === "C") {
    return { body: "No slip in this race", evidence: "Carol observes delivery" };
  }
  if (kind === "or-map") {
    return replica === "A"
      ? { body: "Cross out Eagle Creek", evidence: "the stockpile entry Alice saw" }
      : { body: "Eagle Creek tally: +3", evidence: "Bob's new crate count" };
  }
  const body = `gate-status: ${statusByReplica[replica]}`;
  return kind === "lww-map"
    ? { body, evidence: `time on writer ${replica}'s note` }
    : { body, evidence: "ranger numbers each accepted change" };
}
---

<map-structure-demo data-kind={kind} data-testid={`${kind}-demo`}>
  <section class="map-instrument" aria-labelledby={`${kind}-demo-title`}>
    <div class="map-operation-layer" data-operation-layer aria-hidden="true"></div>
    <header class="map-heading">
      <div>
        <p class="instrument-kicker">Three hikers' notebooks</p>
        <h2 id={`${kind}-demo-title`}>{title}</h2>
        <p>{description}</p>
      </div>
      <p class="merge-rule">How they agree <strong>{rule}</strong></p>
    </header>

    <div class="map-network">
      {initial.view.replicas.map((replica) => {
        const operations = kind === "shared-map"
          ? sharedMapOperations.map((operation) => ({ ...operation, author: replica.id }))
          : [operationFor(replica.id)];
        return (
          <section
            class={`map-replica replica-${replica.id.toLowerCase()}`}
            data-client={replica.id}
            aria-label={`${mapUserName(replica.id)}'s map replica`}
          >
            <header>
              <StationMark station={replica.id} size="lg" />
              <div>
                <h3>{mapUserName(replica.id)}</h3>
                <p data-replica-state={replica.id}>
                  {replica.entries.length ? "Starting notes received" : "No notes yet"}
                </p>
              </div>
            </header>
            <dl class="map-entries" data-map-entries={replica.id}>
              {kind === "shared-map" && <div class="map-entry-heading"><dt>Line</dt><dd>Report</dd></div>}
              {replica.entries.length
                ? replica.entries.map((entry) => (
                    <div><dt>{entry.key}</dt><dd>{entry.value}</dd></div>
                  ))
                : <div class="empty-entry"><dd>{kind === "shared-directory" ? "No folders" : "No entries"}</dd></div>}
            </dl>
            {kind !== "shared-directory" && kind !== "shared-map" && (
              <p class="map-edit-slip">
                <span>Note to share</span>
                <strong>{raceSlip(replica.id).body}</strong>
                <small>{raceSlip(replica.id).evidence}</small>
              </p>
            )}
            {kind === "shared-directory" ? (
              <div class="map-directory-controls">
                <label>
                  Folder name
                  <input
                    type="text"
                    data-folder-name
                    value="eagle-creek"
                    pattern="[a-z0-9]+(-[a-z0-9]+)*"
                    title="Use lowercase letters, numbers, and hyphens."
                    maxlength={40}
                    required
                    disabled
                  />
                </label>
                <div>
                  <button type="button" data-replica={replica.id} data-map-action="mkdir" disabled>Create folder</button>
                  <button type="button" data-replica={replica.id} data-map-action="rmdir" disabled>Remove folder</button>
                </div>
              </div>
            ) : (
              <div class="map-direct-controls">
                {operations.map((operation) => (
                  <button
                    type="button"
                    data-replica={replica.id}
                    data-map-action={operation.action}
                    data-map-key={operation.key}
                    data-map-value={operation.value}
                    disabled
                  >
                    {buttonLabel(operation)}
                  </button>
                ))}
              </div>
            )}
          </section>
        );
      })}

      <div class="relay-channel">
        <section class="map-relay" data-relay-node aria-label="Map message relay">
          <span>{kind === "shared-map" ? "Ranger sequencer" : "Trail exchange"}</span>
          <strong>
            {kind === "shared-map"
              ? "Ranger numbers each accepted change"
              : kind === "lww-map"
                ? "Compare the times beside each line"
                : kind === "or-map"
                  ? "New stockpile notes stay"
                  : "Ranger numbers folder changes"}
          </strong>
          <output data-message-count>0 operations shared</output>
        </section>
        <div class="map-evidence">
          <p>
            <span>What the notes show</span>
            <strong data-evidence>{kind === "shared-map" ? "No operations shared yet." : "No race delivered yet."}</strong>
            {kind === "shared-map" && <small class="map-sequence-note">The starting map uses numbers through {initial.view.sequenceNumber}. This list shows new changes.</small>}
          </p>
          <ol class={kind === "shared-map" ? "map-sequenced-history" : undefined} data-history aria-label="Map operation log, newest first" reversed>
            <li class="empty-history">No operations shared yet.</li>
          </ol>
        </div>
      </div>
    </div>

    <DemoTransportControls />

    <div class="map-controls">
      <button type="button" data-action="race" disabled>{raceLabel}</button>
      <button type="button" data-action="reset" disabled>Reset</button>
      <p data-enhancement-note>
        Enable JavaScript to run the demo. The race and expected result remain
        in the lesson.
      </p>
    </div>

    <p class="map-result" role="status" aria-live="polite" aria-atomic="true">
      {initial.result}
    </p>
    <p class="map-error" role="alert" hidden></p>
  </section>
</map-structure-demo>

<script>
  import "../lib/structure-demo/map-demo-element";
</script>
