---
import { structureGroups } from "../lib/structure-demo/structure-navigation";

interface Props {
  territory?: string;
  sheetTitle?: string;
  trailStep?: {
    current: number;
    total: number;
  };
}

const { territory, sheetTitle, trailStep } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const structureSlug = path.match(/^\/structures\/([^/]+)$/)?.[1];
const group = structureGroups.find(({ href, lessons }) =>
  href === `/structures/${structureSlug}/` || lessons.some(([, slug]) => slug === structureSlug)
);
const lesson = group?.lessons.find(([, slug]) => slug === structureSlug);
const currentTitle = sheetTitle ?? lesson?.[0] ?? (group?.href === `/structures/${structureSlug}/` ? group?.title : undefined);
const currentTerritory = territory ?? (group ? "Structures" : undefined);
const territoryAnchors: Record<string, string> = {
  Structures: "structures",
  Mechanisms: "mechanisms",
  "Failure modes": "failures",
  Systems: "systems",
};
if (currentTerritory && !territoryAnchors[currentTerritory]) {
  throw new Error(`Unknown breadcrumb territory: ${currentTerritory}`);
}
const territoryHref = path.startsWith("/structures/")
  ? "/structures/"
  : `/atlas/#${territoryAnchors[currentTerritory ?? ""]}`;
---

<nav class="observation-rail instrument-panel" aria-label="Sheet position">
  <div class="observation-rail-inner">
    <ol class="observation-context">
      <li>
        {path === "/atlas"
          ? <span aria-current="page">Atlas</span>
          : <a href="/atlas/">Atlas</a>}
      </li>
      {currentTerritory && (
        <li>
          {path === "/structures"
            ? <span aria-current="page">{currentTerritory}</span>
            : <a href={territoryHref}>{currentTerritory}</a>}
        </li>
      )}
      {group && lesson && <li><a href={group.href}>{group.title}</a></li>}
      {currentTitle && <li aria-current="page">{currentTitle}</li>}
      {trailStep && (
        <li>
          Trail <span class="observation-data">{trailStep.current}</span> of <span class="observation-data">{trailStep.total}</span>
        </li>
      )}
    </ol>
    <span class="observation-trace" aria-hidden="true"></span>
  </div>
</nav>

<style>
  .observation-rail {
    border: 0;
    border-top: var(--rule-width) solid color-mix(in oklch, var(--clear) 25%, var(--instrument));
    font-size: 0.875rem;
  }

  .observation-rail-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }

  .observation-context {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .observation-context li + li {
    border-inline-start: var(--rule-width) solid var(--muted);
    padding-inline-start: var(--space-4);
  }

  .observation-context a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  [aria-current="page"] {
    font-weight: 650;
  }

  .observation-trace {
    position: relative;
    flex: 1 0 4rem;
    height: var(--rule-width);
    background: var(--muted);
  }

  .observation-trace::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    transform: translateY(-50%);
  }

  @media (width < 48rem) {
    .observation-rail-inner {
      gap: var(--space-3);
      padding-block: 0;
    }

    .observation-trace {
      flex-basis: 2rem;
      min-width: 2rem;
    }

    .observation-context {
      gap: var(--space-1) var(--space-3);
    }

    .observation-context li + li {
      padding-inline-start: var(--space-3);
    }
  }
</style>
