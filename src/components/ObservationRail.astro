---
import { structureLocation } from "../lib/structure-demo/structure-navigation";

interface Props {
  territory?: string;
  sheetTitle?: string;
  trailStep?: {
    current: number;
    total: number;
  };
}

const { territory, sheetTitle, trailStep } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const structure = structureLocation(path);
const group = structure && "group" in structure ? structure.group : undefined;
const currentTitle = sheetTitle ?? structure?.title ?? (group?.href === `${path}/` ? group.title : undefined);
const currentTerritory = territory ?? (path.startsWith("/structures") ? "Structures" : undefined);
const territoryAnchors: Record<string, string> = {
  Structures: "structures",
  Mechanisms: "mechanisms",
  "Failure modes": "failures",
  Systems: "systems",
};
if (currentTerritory && !territoryAnchors[currentTerritory]) {
  throw new Error(`Unknown breadcrumb territory: ${currentTerritory}`);
}
const isStructure = path === "/structures" || path.startsWith("/structures/");
const rootTitle = isStructure ? "Structures" : path === "/atlas" || currentTerritory ? "Reference atlas" : path === "/glossary" ? "Glossary" : path === "/bibliography" ? "Bibliography" : "Home";
const rootHref = isStructure ? "/structures/" : path === "/atlas" || currentTerritory ? "/atlas/" : "/";
const territoryHref = `/atlas/#${territoryAnchors[currentTerritory ?? ""]}`;
---

<nav class="observation-rail instrument-panel" aria-label="Sheet position">
  <div class="observation-rail-inner">
    <ol class="observation-context">
      <li>
        {path === "/" || path === "/atlas" || path === "/structures" || (!isStructure && !currentTerritory)
          ? <span aria-current="page">{rootTitle}</span>
          : <a href={rootHref}>{rootTitle}</a>}
      </li>
      {currentTerritory && !isStructure && (
        <li>
          <a href={territoryHref}>{currentTerritory}</a>
        </li>
      )}
      {group && group.href !== `${path}/` && <li><a href={group.href}>{group.title}</a></li>}
      {currentTitle && currentTitle !== rootTitle && <li aria-current="page">{currentTitle}</li>}
      {trailStep && (
        <li>
          Trail <span class="observation-data">{trailStep.current}</span> of <span class="observation-data">{trailStep.total}</span>
        </li>
      )}
    </ol>
    <span class="observation-trace" aria-hidden="true"></span>
  </div>
</nav>

<style>
  .observation-rail {
    border: 0;
    border-top: var(--rule-width) solid color-mix(in oklch, var(--clear) 25%, var(--instrument));
    font-size: 0.875rem;
  }

  .observation-rail-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }

  .observation-context {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .observation-context li + li {
    border-inline-start: var(--rule-width) solid var(--muted);
    padding-inline-start: var(--space-4);
  }

  .observation-context a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  [aria-current="page"] {
    font-weight: 650;
  }

  .observation-trace {
    position: relative;
    flex: 1 0 4rem;
    height: var(--rule-width);
    background: var(--muted);
  }

  .observation-trace::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    transform: translateY(-50%);
  }

  @media (width < 48rem) {
    .observation-rail-inner {
      gap: var(--space-3);
      padding-block: 0;
    }

    .observation-trace {
      flex-basis: 2rem;
      min-width: 2rem;
    }

    .observation-context {
      gap: var(--space-1) var(--space-3);
    }

    .observation-context li + li {
      padding-inline-start: var(--space-3);
    }
  }
</style>
