---
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<section class="demo-room" aria-labelledby={id}>
  <div class="room-description">
    <h3 id={id}>Use three devices</h3>
    <slot />
  </div>
  <div class="room-controls">
    <label>
      <span>Room code</span>
      <input type="text" inputmode="text" autocomplete="off" maxlength="8" data-room-code disabled />
    </label>
    <button type="button" data-room-action="create" disabled>Create room</button>
    <button type="button" data-room-action="join" disabled>Join room</button>
    <button type="button" data-room-action="copy" disabled>Copy room link</button>
    <button type="button" data-room-action="leave" disabled>Leave room</button>
  </div>
  <p data-room-status aria-live="polite">Enable JavaScript to connect to a live room.</p>
</section>

<style>
  .demo-room {
    display: grid;
    margin-block: var(--space-4);
    padding: var(--space-4);
    border: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
    gap: var(--space-3);
  }
  .demo-room h3,
  .demo-room p,
  .room-description :global(p) {
    margin: 0;
  }
  .room-description {
    display: grid;
    gap: var(--space-2);
  }
  .room-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-2);
  }
  .room-controls label {
    display: grid;
    gap: var(--space-1);
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }
  .room-controls input {
    width: 10ch;
    min-height: 44px;
    padding-inline: var(--space-2);
    text-transform: uppercase;
  }
  .room-controls button {
    min-height: 44px;
  }
</style>
