---
interface Props {
  jitterRange?: number;
}

const { jitterRange = 120 } = Astro.props;
---

<demo-transport-controls
  class="demo-transport-controls"
  data-jitter-range={jitterRange}
  aria-label="Network delivery controls"
>
  <label class="speed-control">
    <span>Speed</span>
    <input
      type="range"
      min="0.25"
      max="2"
      step="0.25"
      value="1"
      data-transport-speed
      disabled
    />
    <output data-transport-speed-output>1×</output>
  </label>
  <button
    type="button"
    data-transport-jitter
    aria-pressed="false"
    title={`Add up to ${jitterRange} milliseconds to each delivery.`}
    disabled
  >
    Jitter: off
  </button>
  <label class="auto-deliver-control">
    <input type="checkbox" data-transport-auto-deliver checked disabled />
    <span>Auto-deliver</span>
  </label>
</demo-transport-controls>

<script>
  import "../lib/structure-demo/demo-transport-controls";
</script>

<style>
  .demo-transport-controls {
    display: grid;
    grid-template-columns: minmax(0, 16rem) auto auto;
    gap: var(--space-3);
    justify-content: start;
    align-items: end;
    padding-block: var(--space-4);
    border-bottom: var(--rule-width) solid
      color-mix(in oklch, var(--clear) 35%, var(--instrument));
    color: var(--clear);
    font-family: var(--font-ui);
  }

  .speed-control {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2) var(--space-3);
    align-items: center;
    min-width: 0;
    max-width: 16rem;
  }

  .speed-control input {
    grid-column: 1;
    width: 100%;
    accent-color: var(--signal);
  }

  .speed-control output {
    grid-column: 2;
    grid-row: 1 / 3;
    color: var(--signal);
    font-family: var(--font-data);
  }

  .demo-transport-controls button,
  .auto-deliver-control {
    min-height: 2.75rem;
  }

  .demo-transport-controls button {
    padding: 0.65rem 0.85rem;
    border: var(--rule-width) solid currentColor;
    border-radius: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .demo-transport-controls button[aria-pressed="true"],
  .demo-transport-controls button:hover:not(:disabled) {
    color: var(--instrument-deep);
    background: var(--signal);
  }

  .demo-transport-controls button:disabled {
    border-style: dashed;
    color: color-mix(in oklch, var(--clear) 58%, var(--instrument));
    cursor: not-allowed;
  }

  .auto-deliver-control {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
    cursor: pointer;
  }

  .auto-deliver-control input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--signal);
  }

  @media (width < 48rem) {
    .demo-transport-controls {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
