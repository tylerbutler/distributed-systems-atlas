---
import StationMark from "./StationMark.astro";

const path = Astro.url.pathname.replace(/\/$/, "");
---

<header class="site-header instrument-panel">
  <div class="publication-header">
    <a class="site-name" href="/">
      <span class="station-pair" aria-hidden="true">
        <StationMark station="A" size="sm" />
        <StationMark station="B" size="sm" />
      </span>
      <span>Distributed Systems Atlas</span>
    </a>
    <nav aria-label="Primary">
      <ul class="site-nav">
        <li>
          <a href="/structures/" aria-current={path === "/structures" ? "page" : path.startsWith("/structures/") ? "location" : undefined}>Structures</a>
        </li>
        <li>
          <a href="/atlas/" aria-current={path === "/atlas" ? "page" : path.startsWith("/atlas/") ? "location" : undefined}>Atlas</a>
        </li>
        <li><a href="/glossary/" aria-current={path === "/glossary" ? "page" : undefined}>Glossary</a></li>
        <li><a href="/bibliography/" aria-current={path === "/bibliography" ? "page" : undefined}>Bibliography</a></li>
      </ul>
    </nav>
  </div>
</header>
