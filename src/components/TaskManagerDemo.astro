---
import DemoTransportControls from "./DemoTransportControls.astro";
import StationMark from "./StationMark.astro";
import { demoReplicaName, REPLICA_IDS } from "../lib/structure-demo/replicas";
import "../styles/fifo-work-queue-demo.css";
import "../styles/structure-demo-shell.css";
---

<task-manager-demo class="structure-demo-root" data-testid="task-manager-demo">
  <section class="queue-demo instrument-panel structure-demo-instrument" aria-labelledby="task-manager-demo-title">
    <div class="structure-demo-operation-layer" data-operation-layer aria-hidden="true"></div>
    <header>
      <div>
        <h2 id="task-manager-demo-title">Staff the dispatch desk</h2>
        <p>Build one ordered volunteer line, then watch the next connected hiker take over.</p>
      </div>
      <p class="queue-rule"><span>Assignment rule</span><strong>Queue head owns the task</strong></p>
    </header>

    <div class="queue-board" aria-label="Dispatcher task state">
      <section>
        <h3>Assigned</h3>
        <p>The first connected volunteer.</p>
        <ul data-assigned><li>No dispatcher assigned.</li></ul>
      </section>
      <section>
        <h3>Waiting</h3>
        <p>Promotion follows this order.</p>
        <ol data-waiting><li>No volunteers waiting.</li></ol>
      </section>
      <section>
        <h3>Task</h3>
        <p>Completion closes the whole roster.</p>
        <ul data-task-state><li>Dispatch desk open.</li></ul>
      </section>
    </div>

    <div class="queue-workbench">
      {REPLICA_IDS.map((id, index) => (
        <Fragment>
          <section class="queue-worker" data-worker={id}>
            <header><StationMark station={id} size="lg" /><h3>{demoReplicaName(id)}</h3></header>
            <p><span>Roster status</span><strong data-roster-status>Not volunteering</strong></p>
            <div>
              <button type="button" data-task-action="volunteer" disabled>Volunteer</button>
              <button type="button" data-task-action="abandon" disabled>Leave roster</button>
              <button type="button" data-task-action="complete" disabled>Complete task</button>
              <button type="button" data-task-action="disconnect" disabled>Disconnect</button>
            </div>
          </section>
          {index === 0 && (
            <aside class="queue-exchange" aria-label="Sequencer and operation log">
              <div class="queue-sequencer" data-relay-node>
                <h3>Sequencer</h3>
                <p>Numbers roster operations and shares connection changes.</p>
                <output data-sequence>SN 0</output>
              </div>
              <ol data-log aria-label="TaskManager operation log, newest first" reversed>
                <li>No operations accepted yet.</li>
              </ol>
            </aside>
          )}
        </Fragment>
      ))}
    </div>

    <DemoTransportControls />

    <div class="queue-controls">
      <div>
        <h3>Run the worked example</h3>
        <p>Queue all three volunteers, disconnect Alice, then let promoted dispatcher Bob complete the task.</p>
      </div>
      <button type="button" data-worked-example disabled>Run promotion example</button>
      <button type="button" data-reset disabled>Reset</button>
      <p data-enhancement-note>Enable JavaScript to run the roster. The expected result remains in the lesson.</p>
    </div>
    <p role="status" data-status>Ready: the dispatch desk is unassigned.</p>
    <p role="alert" data-error hidden></p>
  </section>
</task-manager-demo>

<script>
  import {
    abandonTask,
    completeTask,
    createRemainingDemo,
    deliverRemainingRace,
    disconnectTaskClient,
    volunteerForTask,
    type RemainingDemoState,
  } from "../lib/structure-demo/remaining-structure-demo";
  import { animateDemoOperation } from "../lib/structure-demo/demo-operation-flight";
  import {
    autoDeliveryChangeEvent,
    DemoTransportControlsElement,
  } from "../lib/structure-demo/demo-transport-controls";
  import { demoReplicaName, REPLICA_IDS } from "../lib/structure-demo/replicas";

  type Replica = "A" | "B" | "C";
  type TaskAction = "volunteer" | "abandon" | "complete";
  type TaskLog = {
    action: TaskAction | "disconnect";
    author: Replica;
    delivered: boolean;
    sequenceNumber?: number;
  };

  class TaskManagerDemo extends HTMLElement {
    private state!: RemainingDemoState;
    private completed = false;
    private connected = new Set<Replica>(REPLICA_IDS);
    private operations: TaskLog[] = [];
    private delivering = false;
    private delivery?: Promise<void>;
    private outboundArrivals: Promise<void>[] = [];
    private activeAnimations = new Set<Animation>();

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      this.querySelector<HTMLElement>("[data-enhancement-note]")!.hidden = true;
      this.reset();
      this.querySelectorAll<HTMLButtonElement>("[data-task-action]").forEach((button) => {
        button.addEventListener("click", () => {
          const worker = button.closest<HTMLElement>("[data-worker]")?.dataset.worker;
          if (worker !== "A" && worker !== "B" && worker !== "C") return;
          const action = button.dataset.taskAction;
          if (action === "disconnect") void this.disconnect(worker);
          else if (action === "volunteer" || action === "abandon" || action === "complete") {
            this.queue(action, worker);
          }
        });
      });
      this.querySelector<HTMLButtonElement>("[data-worked-example]")!.addEventListener("click", async () => {
        this.reset();
        const autoDeliver = this.transport.autoDeliver;
        this.transport.querySelector<HTMLInputElement>("[data-transport-auto-deliver]")!.checked = false;
        this.queue("volunteer", "A");
        this.queue("volunteer", "B");
        this.queue("volunteer", "C");
        await this.deliver();
        await this.disconnect("A");
        this.queue("complete", "B");
        await this.deliver();
        this.transport.querySelector<HTMLInputElement>("[data-transport-auto-deliver]")!.checked = autoDeliver;
        this.render("Alice disconnected, Bob took over, and Bob completed the dispatch task.");
      });
      this.querySelector<HTMLButtonElement>("[data-reset]")!.addEventListener("click", () => this.reset());
      this.transport.addEventListener(autoDeliveryChangeEvent, () => {
        if (this.transport.autoDeliver && this.state.view.pending > 0) void this.deliver();
      });
    }

    private queue(action: TaskAction, replica: Replica) {
      try {
        if (action === "volunteer") this.state = volunteerForTask(this.state, replica);
        else if (action === "abandon") this.state = abandonTask(this.state, replica);
        else this.state = completeTask(this.state, replica);
        this.operations.unshift({ action, author: replica, delivered: false });
        this.outboundArrivals.push(this.animateOperation(
          this.worker(replica),
          this.relay,
          action === "abandon" ? "leave" : action,
          "outbound",
          this.transport.nextDuration(420),
        ));
        this.render(`Queued ${demoReplicaName(replica)}'s ${this.actionLabel(action)} operation.`);
        if (this.transport.autoDeliver) void this.deliver();
      } catch (error) {
        this.showError(error);
      }
    }

    private deliver(): Promise<void> {
      if (this.delivery) return this.delivery;
      if (this.state.view.pending === 0) return Promise.resolve();
      this.delivery = this.deliverPending().finally(() => {
        this.delivery = undefined;
        if (this.transport.autoDeliver && this.state.view.pending > 0) void this.deliver();
      });
      return this.delivery;
    }

    private async deliverPending() {
      this.delivering = true;
      this.renderControls();
      try {
        while (this.outboundArrivals.length) {
          await Promise.all(this.outboundArrivals.splice(0));
        }
        const pending = [...this.operations].reverse().filter(({ delivered }) => !delivered);
        let sequenceNumber = this.state.view.sequenceNumber;
        for (const operation of pending) {
          sequenceNumber += 1;
          operation.sequenceNumber = sequenceNumber;
        }
        await this.broadcast(pending.map(({ sequenceNumber }) => `SN ${sequenceNumber}`));
        this.state = deliverRemainingRace(this.state);
        for (const operation of pending) {
          operation.delivered = true;
          if (operation.action === "complete") this.completed = true;
        }
        this.render(`Sequenced through SN ${this.state.view.sequenceNumber}.`);
      } catch (error) {
        this.showError(error);
      } finally {
        this.delivering = false;
        this.renderControls();
      }
    }

    private async disconnect(replica: Replica) {
      if (this.delivering || this.state.view.pending > 0) return;
      try {
        await this.animateOperation(
          this.worker(replica),
          this.relay,
          "offline",
          "outbound",
          this.transport.nextDuration(420),
        );
        this.state = disconnectTaskClient(this.state, replica);
        this.connected.delete(replica);
        this.operations.unshift({ action: "disconnect", author: replica, delivered: true });
        await this.broadcast(["roster"]);
        this.render(`${demoReplicaName(replica)} disconnected. The next volunteer took over.`);
      } catch (error) {
        this.showError(error);
      }
    }

    private broadcast(labels: string[]) {
      return Promise.all(REPLICA_IDS.flatMap((id) => labels.map((label) =>
        this.animateOperation(
          this.relay,
          this.worker(id),
          label,
          "shared",
          this.transport.nextDuration(480),
        )
      )));
    }

    private animateOperation(
      from: HTMLElement,
      to: HTMLElement,
      label: string,
      leg: "outbound" | "shared",
      duration: number,
    ): Promise<void> {
      return animateDemoOperation({
        activeAnimations: this.activeAnimations,
        className: "queue-operation-pulse",
        duration,
        from,
        label,
        labelClassName: "queue-operation-label",
        layer: this.querySelector<HTMLElement>("[data-operation-layer]")!,
        leg,
        to,
      });
    }

    private roster(): { assigned?: Replica; waiting: Replica[] } {
      const values = this.state.view.replicas.find(({ id }) => id === "C")?.values ?? [];
      const assignedValue = values.find((value) => value.startsWith("dispatcher: "));
      const assignedName = assignedValue?.slice(12);
      const assigned = assignedName === "Alice" ? "A" : assignedName === "Bob" ? "B"
        : assignedName === "Carol" ? "C" : undefined;
      const waitingValue = values.find((value) => value.startsWith("waiting: "));
      const waiting = waitingValue?.slice(9).split(", ").flatMap((name) =>
        name === "Alice" ? ["A" as const] : name === "Bob" ? ["B" as const]
          : name === "Carol" ? ["C" as const] : []
      ) ?? [];
      return { assigned, waiting };
    }

    private optimisticRoster(id: Replica): "in" | "out" {
      const pending = this.operations.find(({ author, delivered }) => author === id && !delivered);
      if (pending?.action === "volunteer") return "in";
      if (pending?.action === "abandon") return "out";
      const { assigned, waiting } = this.roster();
      return assigned === id || waiting.includes(id) ? "in" : "out";
    }

    private render(status: string) {
      const { assigned, waiting } = this.roster();
      this.fill("[data-assigned]", assigned ? [demoReplicaName(assigned)] : ["No dispatcher assigned."]);
      this.fill("[data-waiting]", waiting.map((id, index) => `${index + 1}. ${demoReplicaName(id)}`), ["No volunteers waiting."]);
      this.fill("[data-task-state]", [this.completed ? "Dispatch task completed." : "Dispatch desk open."]);
      for (const id of REPLICA_IDS) {
        const worker = this.worker(id);
        const position = waiting.indexOf(id);
        worker.querySelector<HTMLElement>("[data-roster-status]")!.textContent =
          !this.connected.has(id) ? "Disconnected"
          : assigned === id ? "Assigned dispatcher"
          : position >= 0 ? `Waiting ${position + 1}`
          : this.optimisticRoster(id) === "in" ? "Volunteer pending"
          : "Not volunteering";
      }
      this.querySelector<HTMLOutputElement>("[data-sequence]")!.textContent = `SN ${this.state.view.sequenceNumber}`;
      this.renderLog();
      this.querySelector<HTMLElement>("[data-status]")!.textContent = status;
      this.renderControls();
      this.clearError();
    }

    private renderControls() {
      const { assigned } = this.roster();
      for (const id of REPLICA_IDS) {
        const worker = this.worker(id);
        const optimistic = this.optimisticRoster(id);
        const connected = this.connected.has(id);
        worker.querySelector<HTMLButtonElement>('[data-task-action="volunteer"]')!.disabled =
          !connected || this.completed || optimistic === "in";
        worker.querySelector<HTMLButtonElement>('[data-task-action="abandon"]')!.disabled =
          !connected || this.completed || optimistic === "out";
        worker.querySelector<HTMLButtonElement>('[data-task-action="complete"]')!.disabled =
          !connected || this.completed || assigned !== id || this.state.view.pending > 0;
        worker.querySelector<HTMLButtonElement>('[data-task-action="disconnect"]')!.disabled =
          !connected || this.completed || optimistic === "out" || this.state.view.pending > 0 || this.delivering;
      }
      this.querySelector<HTMLButtonElement>("[data-worked-example]")!.disabled = this.delivering;
      this.querySelector<HTMLButtonElement>("[data-reset]")!.disabled = this.delivering;
    }

    private renderLog() {
      const target = this.querySelector<HTMLOListElement>("[data-log]")!;
      target.replaceChildren(...(this.operations.length ? this.operations : [null]).map((operation) => {
        const item = document.createElement("li");
        if (!operation) {
          item.textContent = "No operations accepted yet.";
          return item;
        }
        const stamp = operation.action === "disconnect"
          ? "Roster · "
          : operation.sequenceNumber === undefined ? "" : `SN ${operation.sequenceNumber} · `;
        const status = operation.delivered ? "delivered" : "waiting";
        item.textContent = `${stamp}${demoReplicaName(operation.author)}: ${this.actionLabel(operation.action)} — ${status}`;
        return item;
      }));
    }

    private actionLabel(action: TaskLog["action"]) {
      if (action === "volunteer") return "volunteer for dispatcher";
      if (action === "abandon") return "leave the roster";
      if (action === "complete") return "complete the dispatch task";
      return "disconnect";
    }

    private fill(selector: string, values: string[], fallback: string[] = []) {
      const target = this.querySelector<HTMLElement>(selector)!;
      target.replaceChildren(...(values.length ? values : fallback).map((value) => {
        const item = document.createElement("li");
        item.textContent = value;
        return item;
      }));
    }

    private get transport(): DemoTransportControlsElement {
      const controls = this.querySelector<DemoTransportControlsElement>("demo-transport-controls");
      if (!controls) throw new Error("Missing TaskManager transport controls.");
      return controls;
    }

    private get relay(): HTMLElement {
      return this.querySelector<HTMLElement>("[data-relay-node]")!;
    }

    private worker(id: Replica): HTMLElement {
      return this.querySelector<HTMLElement>(`[data-worker="${id}"]`)!;
    }

    private showError(error: unknown) {
      const alert = this.querySelector<HTMLElement>("[data-error]")!;
      alert.hidden = false;
      alert.textContent = error instanceof Error ? error.message : String(error);
    }

    private clearError() {
      const alert = this.querySelector<HTMLElement>("[data-error]")!;
      alert.hidden = true;
      alert.textContent = "";
    }

    private reset() {
      for (const animation of this.activeAnimations) animation.cancel();
      this.activeAnimations.clear();
      this.querySelector<HTMLElement>("[data-operation-layer]")?.replaceChildren();
      this.state = createRemainingDemo("task-manager");
      this.completed = false;
      this.connected = new Set(REPLICA_IDS);
      this.operations = [];
      this.outboundArrivals = [];
      this.delivering = false;
      this.delivery = undefined;
      this.render("Ready: the dispatch desk is unassigned.");
    }
  }

  if (!customElements.get("task-manager-demo")) {
    customElements.define("task-manager-demo", TaskManagerDemo);
  }
</script>
