---
import { entryAnchor } from "../lib/atlas/graph";

interface Props {
  term: string;
  definition: string;
  inlineOnly?: boolean;
}

const { term, definition, inlineOnly = false } = Astro.props;
---

<aside
  class:list={["term-callout", inlineOnly && "term-callout-inline", inlineOnly && "sheet-term-note"]}
  aria-label={`${term} definition`}
>
  <p class="term-callout-label">Definition</p>
  <p class="term-callout-copy">
    <dfn><a href={`/glossary/#${entryAnchor(term)}`}>{term}</a></dfn>
    {" — "}
    {definition}
  </p>
</aside>

<style>
  .term-callout {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    margin-block: var(--space-5);
    padding-block: var(--space-4);
    border-block: var(--rule-width) solid var(--line);
    font-family: var(--font-ui);
  }

  .term-callout p {
    margin: 0;
  }

  .term-callout-label {
    padding: var(--space-1) var(--space-2);
    color: var(--instrument-deep);
    background: var(--signal);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .term-callout-copy dfn {
    color: var(--instrument-deep);
    font-style: normal;
    font-weight: 700;
  }

  .term-callout-copy a {
    color: inherit;
    text-decoration-thickness: var(--rule-width);
    text-underline-offset: 0.16em;
  }

  @media (max-width: 34rem) {
    .term-callout {
      grid-template-columns: 1fr;
    }

    .term-callout-label {
      justify-self: start;
    }
  }

  @media (min-width: 72.001rem) {
    .term-callout-inline {
      display: none;
    }
  }
</style>
