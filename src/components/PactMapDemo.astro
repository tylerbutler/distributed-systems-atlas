---
import DemoTransportControls from "./DemoTransportControls.astro";
import StationMark from "./StationMark.astro";
import { demoReplicaName, REPLICA_IDS } from "../lib/structure-demo/replicas";
import "../styles/fifo-work-queue-demo.css";
import "../styles/structure-demo-shell.css";
---

<pact-map-demo class="structure-demo-root" data-testid="pact-map-demo">
  <section class="queue-demo instrument-panel structure-demo-instrument" aria-labelledby="pact-map-demo-title">
    <div class="structure-demo-operation-layer" data-operation-layer aria-hidden="true"></div>
    <header>
      <div>
        <h2 id="pact-map-demo-title">Approve the closure plan</h2>
        <p>Keep the current plan readable while every required station reviews its replacement.</p>
      </div>
      <p class="queue-rule"><span>Agreement rule</span><strong>Every frozen-roster member must sign or leave</strong></p>
    </header>

    <div class="queue-board" aria-label="PactMap agreement state">
      <section>
        <h3>Accepted</h3>
        <p>This is the readable value.</p>
        <ul data-accepted><li>north-gate</li></ul>
      </section>
      <section>
        <h3>Pending proposal</h3>
        <p>One proposal per key.</p>
        <ul data-pending-value><li>No proposal pending.</li></ul>
      </section>
      <section>
        <h3>Waiting on</h3>
        <p>Frozen when the proposal sequences.</p>
        <ul data-signoffs><li>No signoffs required.</li></ul>
      </section>
    </div>

    <div class="queue-workbench">
      {REPLICA_IDS.map((id, index) => (
        <Fragment>
          <section class="queue-worker" data-worker={id}>
            <header><StationMark station={id} size="lg" /><h3>{demoReplicaName(id)}</h3></header>
            <p><span>Agreement status</span><strong data-pact-status>Connected</strong></p>
            <div>
              <button type="button" data-pact-action="propose" disabled>Propose ridge-pass</button>
              <button type="button" data-pact-action="accept" disabled>Sign off</button>
              <button type="button" data-pact-action="disconnect" disabled>Leave roster</button>
            </div>
          </section>
          {index === 0 && (
            <aside class="queue-exchange" aria-label="Sequencer and operation log">
              <div class="queue-sequencer" data-relay-node>
                <h3>Sequencer</h3>
                <p>Freezes the proposal roster and numbers each signoff.</p>
                <output data-sequence>SN 0</output>
              </div>
              <ol data-log aria-label="PactMap operation log, newest first" reversed>
                <li>No operations accepted yet.</li>
              </ol>
            </aside>
          )}
        </Fragment>
      ))}
    </div>

    <DemoTransportControls />

    <div class="queue-controls">
      <div>
        <h3>Run the worked example</h3>
        <p>Alice proposes ridge-pass. Alice and Bob sign. Carol leaves the frozen roster, which clears the last required signoff.</p>
      </div>
      <button type="button" data-worked-example disabled>Run roster-change example</button>
      <button type="button" data-reset disabled>Reset</button>
      <p data-enhancement-note>Enable JavaScript to run the agreement. The expected result remains in the lesson.</p>
    </div>
    <p role="status" data-status>Ready: north-gate is accepted.</p>
    <p role="alert" data-error hidden></p>
  </section>
</pact-map-demo>

<script>
  import {
    acceptPact,
    createRemainingDemo,
    deliverRemainingRace,
    disconnectPactClient,
    proposePact,
    type RemainingDemoState,
  } from "../lib/structure-demo/remaining-structure-demo";
  import { animateDemoOperation } from "../lib/structure-demo/demo-operation-flight";
  import {
    autoDeliveryChangeEvent,
    DemoTransportControlsElement,
  } from "../lib/structure-demo/demo-transport-controls";
  import { demoReplicaName, REPLICA_IDS } from "../lib/structure-demo/replicas";

  type Replica = "A" | "B" | "C";
  type PactAction = "propose" | "accept";
  type PactLog = {
    action: PactAction | "leave";
    author: Replica;
    delivered: boolean;
    sequenceNumber?: number;
  };

  class PactMapDemo extends HTMLElement {
    private state!: RemainingDemoState;
    private connected = new Set<Replica>(REPLICA_IDS);
    private operations: PactLog[] = [];
    private delivering = false;
    private delivery?: Promise<void>;
    private outboundArrivals: Promise<void>[] = [];
    private activeAnimations = new Set<Animation>();

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      this.querySelector<HTMLElement>("[data-enhancement-note]")!.hidden = true;
      this.reset();
      this.querySelectorAll<HTMLButtonElement>("[data-pact-action]").forEach((button) => {
        button.addEventListener("click", () => {
          const worker = button.closest<HTMLElement>("[data-worker]")?.dataset.worker;
          if (worker !== "A" && worker !== "B" && worker !== "C") return;
          const action = button.dataset.pactAction;
          if (action === "disconnect") void this.disconnect(worker);
          else if (action === "propose" || action === "accept") this.queue(action, worker);
        });
      });
      this.querySelector<HTMLButtonElement>("[data-worked-example]")!.addEventListener("click", async () => {
        this.reset();
        const autoDeliver = this.transport.autoDeliver;
        const broadcast = this.transport.querySelector<HTMLInputElement>("[data-transport-auto-deliver]")!;
        broadcast.checked = false;
        this.queue("propose", "A");
        await this.deliver();
        this.queue("accept", "A");
        this.queue("accept", "B");
        await this.deliver();
        await this.disconnect("C");
        broadcast.checked = autoDeliver;
        this.render("Carol left the frozen roster. Ridge-pass is now accepted.");
      });
      this.querySelector<HTMLButtonElement>("[data-reset]")!.addEventListener("click", () => this.reset());
      this.transport.addEventListener(autoDeliveryChangeEvent, () => {
        if (this.transport.autoDeliver && this.state.view.pending > 0) void this.deliver();
      });
    }

    private queue(action: PactAction, replica: Replica) {
      try {
        this.state = action === "propose"
          ? proposePact(this.state, replica, "ridge-pass")
          : acceptPact(this.state, replica);
        this.operations.unshift({ action, author: replica, delivered: false });
        this.outboundArrivals.push(this.animateOperation(
          this.worker(replica),
          this.relay,
          action === "propose" ? "proposal" : "signoff",
          "outbound",
          this.transport.nextDuration(420),
        ));
        this.render(`Queued ${demoReplicaName(replica)}'s ${this.actionLabel(action)}.`);
        if (this.transport.autoDeliver) void this.deliver();
      } catch (error) {
        this.showError(error);
      }
    }

    private deliver(): Promise<void> {
      if (this.delivery) return this.delivery;
      if (this.state.view.pending === 0) return Promise.resolve();
      this.delivery = this.deliverPending().finally(() => {
        this.delivery = undefined;
        if (this.transport.autoDeliver && this.state.view.pending > 0) void this.deliver();
      });
      return this.delivery;
    }

    private async deliverPending() {
      this.delivering = true;
      this.renderControls();
      try {
        while (this.outboundArrivals.length) {
          await Promise.all(this.outboundArrivals.splice(0));
        }
        const pending = [...this.operations].reverse().filter(({ delivered }) => !delivered);
        let sequenceNumber = this.state.view.sequenceNumber;
        for (const operation of pending) {
          sequenceNumber += 1;
          operation.sequenceNumber = sequenceNumber;
        }
        await this.broadcast(pending.map(({ sequenceNumber }) => `SN ${sequenceNumber}`));
        this.state = deliverRemainingRace(this.state);
        for (const operation of pending) operation.delivered = true;
        this.render(`Sequenced through SN ${this.state.view.sequenceNumber}.`);
      } catch (error) {
        this.showError(error);
      } finally {
        this.delivering = false;
        this.renderControls();
      }
    }

    private async disconnect(replica: Replica) {
      if (this.delivering || this.state.view.pending > 0) return;
      try {
        await this.animateOperation(
          this.worker(replica),
          this.relay,
          "leave",
          "outbound",
          this.transport.nextDuration(420),
        );
        this.state = disconnectPactClient(this.state, replica);
        this.connected.delete(replica);
        this.operations.unshift({
          action: "leave",
          author: replica,
          delivered: true,
          sequenceNumber: this.state.view.sequenceNumber,
        });
        await this.broadcast([`SN ${this.state.view.sequenceNumber}`]);
        this.render(`${demoReplicaName(replica)} left the roster.`);
      } catch (error) {
        this.showError(error);
      }
    }

    private broadcast(labels: string[]) {
      return Promise.all(REPLICA_IDS.flatMap((id) => labels.map((label) =>
        this.animateOperation(
          this.relay,
          this.worker(id),
          label,
          "shared",
          this.transport.nextDuration(480),
        )
      )));
    }

    private animateOperation(
      from: HTMLElement,
      to: HTMLElement,
      label: string,
      leg: "outbound" | "shared",
      duration: number,
    ): Promise<void> {
      return animateDemoOperation({
        activeAnimations: this.activeAnimations,
        className: "queue-operation-pulse",
        duration,
        from,
        label,
        labelClassName: "queue-operation-label",
        layer: this.querySelector<HTMLElement>("[data-operation-layer]")!,
        leg,
        to,
      });
    }

    private agreement() {
      const values = this.state.view.replicas.find(({ id }) => id === "C")?.values ?? [];
      const accepted = values.find((value) => value.startsWith("accepted: "))?.slice(10) ?? "absent";
      const pending = values.find((value) => value.startsWith("pending: "))?.slice(9);
      const needs = values.find((value) => value.startsWith("needs signoff: "))?.slice(15)
        .split(", ").flatMap((name) =>
          name === "Alice" ? ["A" as const] : name === "Bob" ? ["B" as const]
            : name === "Carol" ? ["C" as const] : []
        ) ?? [];
      return { accepted, pending, needs };
    }

    private render(status: string) {
      const { accepted, pending, needs } = this.agreement();
      this.fill("[data-accepted]", [accepted]);
      this.fill("[data-pending-value]", [pending ?? "No proposal pending."]);
      this.fill("[data-signoffs]", needs.length
        ? needs.map((id) => demoReplicaName(id))
        : ["No signoffs required."]);
      for (const id of REPLICA_IDS) {
        const pendingAccept = this.operations.some((operation) =>
          operation.author === id && operation.action === "accept" && !operation.delivered
        );
        this.worker(id).querySelector<HTMLElement>("[data-pact-status]")!.textContent =
          !this.connected.has(id) ? "Left roster"
          : pendingAccept ? "Signoff pending"
          : pending && needs.includes(id) ? "Signoff required"
          : pending ? "Signed off"
          : "Connected";
      }
      this.querySelector<HTMLOutputElement>("[data-sequence]")!.textContent = `SN ${this.state.view.sequenceNumber}`;
      this.renderLog();
      this.querySelector<HTMLElement>("[data-status]")!.textContent = status;
      this.renderControls();
      this.clearError();
    }

    private renderControls() {
      const { pending, needs } = this.agreement();
      const proposalQueued = this.operations.some((operation) =>
        operation.action === "propose" && !operation.delivered
      );
      for (const id of REPLICA_IDS) {
        const worker = this.worker(id);
        const acceptQueued = this.operations.some((operation) =>
          operation.author === id && operation.action === "accept" && !operation.delivered
        );
        const connected = this.connected.has(id);
        worker.querySelector<HTMLButtonElement>('[data-pact-action="propose"]')!.disabled =
          !connected || Boolean(pending) || proposalQueued;
        worker.querySelector<HTMLButtonElement>('[data-pact-action="accept"]')!.disabled =
          !connected || !pending || !needs.includes(id) || acceptQueued;
        worker.querySelector<HTMLButtonElement>('[data-pact-action="disconnect"]')!.disabled =
          !connected || this.state.view.pending > 0 || this.delivering;
      }
      this.querySelector<HTMLButtonElement>("[data-worked-example]")!.disabled = this.delivering;
      this.querySelector<HTMLButtonElement>("[data-reset]")!.disabled = this.delivering;
    }

    private renderLog() {
      const target = this.querySelector<HTMLOListElement>("[data-log]")!;
      target.replaceChildren(...(this.operations.length ? this.operations : [null]).map((operation) => {
        const item = document.createElement("li");
        if (!operation) {
          item.textContent = "No operations accepted yet.";
          return item;
        }
        const stamp = operation.sequenceNumber === undefined ? "" : `SN ${operation.sequenceNumber} · `;
        item.textContent = `${stamp}${demoReplicaName(operation.author)}: ${this.actionLabel(operation.action)} — ${operation.delivered ? "delivered" : "waiting"}`;
        return item;
      }));
    }

    private actionLabel(action: PactLog["action"]) {
      if (action === "propose") return "propose ridge-pass";
      if (action === "accept") return "sign off";
      return "leave the roster";
    }

    private fill(selector: string, values: string[]) {
      const target = this.querySelector<HTMLElement>(selector)!;
      target.replaceChildren(...values.map((value) => {
        const item = document.createElement("li");
        item.textContent = value;
        return item;
      }));
    }

    private get transport(): DemoTransportControlsElement {
      const controls = this.querySelector<DemoTransportControlsElement>("demo-transport-controls");
      if (!controls) throw new Error("Missing PactMap transport controls.");
      return controls;
    }

    private get relay(): HTMLElement {
      return this.querySelector<HTMLElement>("[data-relay-node]")!;
    }

    private worker(id: Replica): HTMLElement {
      return this.querySelector<HTMLElement>(`[data-worker="${id}"]`)!;
    }

    private showError(error: unknown) {
      const alert = this.querySelector<HTMLElement>("[data-error]")!;
      alert.hidden = false;
      alert.textContent = error instanceof Error ? error.message : String(error);
    }

    private clearError() {
      const alert = this.querySelector<HTMLElement>("[data-error]")!;
      alert.hidden = true;
      alert.textContent = "";
    }

    private reset() {
      for (const animation of this.activeAnimations) animation.cancel();
      this.activeAnimations.clear();
      this.querySelector<HTMLElement>("[data-operation-layer]")?.replaceChildren();
      this.state = createRemainingDemo("pact-map");
      this.connected = new Set(REPLICA_IDS);
      this.operations = [];
      this.outboundArrivals = [];
      this.delivering = false;
      this.delivery = undefined;
      this.render("Ready: north-gate is accepted.");
    }
  }

  if (!customElements.get("pact-map-demo")) {
    customElements.define("pact-map-demo", PactMapDemo);
  }
</script>
