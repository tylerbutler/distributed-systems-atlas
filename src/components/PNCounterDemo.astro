---
import DemoTransportControls from "./DemoTransportControls.astro";
import StationMark from "./StationMark.astro";
import {
  createPNCounterDemo,
  pnCounterComponentIds,
  pnCounterUserName,
  presentPNCounterDemo,
} from "../lib/structure-demo/pn-counter";

const initial = presentPNCounterDemo(createPNCounterDemo());
const replicas = ["A", "B", "C"] as const;
const componentLabels = {
  "starting-count": "Agreed starting count",
  A: "Alice",
  B: "Bob",
  C: "Carol",
};
---

<pn-counter-demo data-testid="pn-counter-demo">
  <section class="pn-instrument" aria-labelledby="pn-counter-demo-title">
    <div class="operation-layer" data-operation-layer aria-hidden="true"></div>
    <header class="pn-heading">
      <div>
        <h2 id="pn-counter-demo-title">Correct the shared bird count</h2>
        <p>
          The hikers agree on 10 birds. As soon as a hiker records a new
          sighting or correction, it is sent through the known checkpoint.
        </p>
      </div>
      <p class="merge-rule">
        Merge rule
        <strong>Keep the largest sightings and corrections from each hiker.</strong>
      </p>
    </header>

    <div class="operation-key" aria-label="Correction note states">
      <p>
        <span class="operation-key-mark outbound" aria-hidden="true"></span>
        <span><strong>New note</strong> In transit to a checkpoint</span>
      </p>
      <p>
        <span class="operation-key-mark sequenced" aria-hidden="true"></span>
        <span><strong>Shared note</strong> Being delivered to the other hikers</span>
      </p>
    </div>

    <div class="pn-network">
      {initial.replicas.map((replica) => (
        <section
          class={`pn-replica replica-${replica.id.toLowerCase()}`}
          data-client={replica.id}
          aria-label={`${pnCounterUserName(replica.id)}'s PN-counter replica`}
        >
          <header>
            <StationMark station={replica.id} size="lg" />
            <div>
              <h3>{pnCounterUserName(replica.id)}</h3>
              <p data-replica-state={replica.id}>Agreed count received</p>
            </div>
          </header>
          <output class="pn-total observation-data" data-pn-total={replica.id}>
            {replica.value}
          </output>
          <p>Birds in this hiker's view</p>
          <div class="replica-actions" aria-label={`Update birds for ${pnCounterUserName(replica.id)}`}>
            {[1, 3].map((amount) => (
              <button
                type="button"
                data-replica={replica.id}
                data-update={amount}
                aria-label={`Record ${amount} more ${amount === 1 ? "bird" : "birds"} for ${pnCounterUserName(replica.id)}`}
                disabled
              >
                +{amount}
              </button>
            ))}
            {[1, 3].map((amount) => (
              <button
                type="button"
                data-replica={replica.id}
                data-update={-amount}
                aria-label={`Correct ${amount} duplicate ${amount === 1 ? "sighting" : "sightings"} for ${pnCounterUserName(replica.id)}`}
                disabled
              >
                Correct {amount}
              </button>
            ))}
          </div>
        </section>
      ))}

      <div class="sequencer-channel">
        <section class="sequencer-station" data-sequencer-node aria-label="PN-counter checkpoint">
          <span class="sequencer-label">Known checkpoint</span>
          <output class="sequencer-counter" data-sequence-counter aria-label="Correction notes shared">
            0 notes
          </output>
        </section>
        <ol class="operation-log" data-deliveries aria-label="Correction note log" reversed>
          <li>No correction note shared yet.</li>
        </ol>
      </div>
    </div>

    <DemoTransportControls />

    <section class="pn-controls" aria-label="PN-counter lesson controls">
      <button type="button" data-action="race" disabled>
        Run Alice +3 and Bob -1 correction
      </button>
      <button type="button" data-action="reset" disabled>Reset</button>
      <p data-enhancement-note>
        Enable JavaScript to run the demo. The starting count and expected
        result remain available in the article.
      </p>
    </section>

    <p class="pn-result" role="status" aria-live="polite" aria-atomic="true">
      {initial.result}
    </p>
    <p class="pn-error" role="alert" hidden></p>

    <details class="pn-explanation">
      <summary>Open the hikers' two notebook tables</summary>
      <div>
        <p>
          Each hiker's notebook has a sightings table for the positive
          G-counter and a corrections table for the negative G-counter. Both
          tables only grow and merge by per-hiker maximum.
        </p>
        <pre aria-label="PN-counter bird total rule"><code>birds = P - N</code></pre>
        <table aria-label="Sightings in each hiker's PN-counter">
          <thead>
            <tr>
              <th scope="col">Sightings from</th>
              <th scope="col">Alice's view</th>
              <th scope="col">Bob's view</th>
              <th scope="col">Carol's view</th>
            </tr>
          </thead>
          <tbody>
            {pnCounterComponentIds.map((author) => (
              <tr>
                <th scope="row">{componentLabels[author]}</th>
                {replicas.map((replica) => (
                  <td
                    class="observation-data"
                    data-pn-component={`${replica}-positive-${author}`}
                  >
                    {author === "starting-count" ? 10 : 0}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
        <table aria-label="Corrections in each hiker's PN-counter">
          <thead>
            <tr>
              <th scope="col">Corrections from</th>
              <th scope="col">Alice's view</th>
              <th scope="col">Bob's view</th>
              <th scope="col">Carol's view</th>
            </tr>
          </thead>
          <tbody>
            {replicas.map((author) => (
              <tr>
                <th scope="row">{pnCounterUserName(author)}</th>
                {replicas.map((replica) => (
                  <td
                    class="observation-data"
                    data-pn-component={`${replica}-negative-${author}`}
                  >
                    0
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </section>
</pn-counter-demo>

<script>
  import "../lib/structure-demo/pn-counter-element";
</script>

<style>
  pn-counter-demo {
    display: block;
    width: min(calc(100vw - 2rem), var(--content));
    max-width: none;
    margin-block: var(--space-7);
    margin-inline: 50%;
    font-variant-numeric: tabular-nums;
    transform: translateX(-50%);
  }

  .pn-instrument {
    position: relative;
    padding: clamp(1rem, 3vw, 2rem);
    border: var(--rule-width) solid var(--instrument-deep);
    color: var(--clear);
    background: var(--instrument);
    --focus-color: var(--signal);
    --link-color: var(--clear);
  }

  .operation-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  :global(.pn-operation-pulse) {
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  :global(.pn-operation-pulse.outbound) {
    background: var(--signal);
  }

  :global(.pn-operation-pulse.sequenced) {
    color: var(--instrument-deep);
    background: var(--clear);
  }

  :global(.pn-operation-label) {
    position: absolute;
    bottom: calc(100% + var(--space-1));
    left: 50%;
    padding: 2px 5px;
    border-radius: 0;
    color: var(--instrument-deep);
    background: var(--signal);
    font-family: var(--font-data);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  :global(.pn-operation-pulse.sequenced .pn-operation-label) {
    background: var(--clear);
  }

  .pn-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
    gap: var(--space-6);
    align-items: end;
    padding-bottom: var(--space-5);
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .pn-heading :is(h2, p),
  .pn-replica :is(h3, p) {
    margin: 0;
  }

  .pn-heading p {
    margin-top: var(--space-3);
  }

  .merge-rule {
    padding: var(--space-4);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 45%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }

  .merge-rule strong {
    display: block;
    margin-top: var(--space-2);
    color: var(--signal);
    font-size: 1.05rem;
  }

  .operation-key {
    display: flex;
    gap: var(--space-5);
    padding-block: var(--space-3);
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .operation-key p {
    display: flex;
    margin: 0;
    align-items: center;
    gap: var(--space-2);
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  .operation-key strong {
    color: var(--clear);
  }

  .operation-key-mark {
    width: 12px;
    height: 12px;
    border: var(--rule-width) solid currentColor;
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .operation-key-mark.outbound {
    color: var(--signal);
    background: var(--signal);
  }

  .operation-key-mark.sequenced {
    color: var(--clear);
    background: var(--clear);
  }

  .pn-network {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(11rem, 0.45fr) minmax(0, 1fr);
    grid-template-areas:
      "a sequencer b"
      "c c c";
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: start;
    padding-block: var(--space-6);
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .pn-replica {
    min-width: 0;
    padding: var(--space-5);
    border: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
    background: color-mix(in oklch, var(--clear) 3%, var(--instrument));
  }

  .replica-a { grid-area: a; }
  .replica-b { grid-area: b; }
  .replica-c {
    grid-area: c;
    justify-self: center;
    width: min(100%, 24rem);
  }

  .pn-replica header {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .pn-replica h3 {
    font-size: 1.15rem;
  }

  .pn-replica header p,
  .pn-total + p {
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.825rem;
  }

  .pn-replica header p {
    font-size: 0.75rem;
  }

  .pn-total {
    display: block;
    width: fit-content;
    margin-top: var(--space-4);
    color: var(--signal);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 650;
    line-height: 0.95;
  }

  .pn-total + p {
    margin-top: var(--space-2);
  }

  .replica-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .sequencer-channel {
    grid-area: sequencer;
    display: flex;
    min-width: 0;
    align-self: stretch;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-top: clamp(var(--space-4), 4vw, var(--space-6));
  }

  .sequencer-station {
    display: flex;
    width: fit-content;
    padding: var(--space-3) var(--space-5);
    border: var(--rule-width) solid var(--clear);
    border-radius: 999px;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    text-align: center;
  }

  .sequencer-label {
    color: var(--signal);
    font-family: var(--font-ui);
    font-size: 1.15rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .sequencer-counter {
    color: var(--clear);
    font-family: var(--font-data);
    font-size: 1.15rem;
  }

  .operation-log {
    display: flex;
    width: min(100%, 12rem);
    min-height: 10rem;
    flex: 1;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    mask-image: linear-gradient(black 58%, transparent 100%);
  }

  .operation-log :global(li) {
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-data);
    font-size: 0.68rem;
    line-height: 1.45;
    text-align: center;
  }

  .pn-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: stretch;
    padding-block: var(--space-5);
  }

  :is(.replica-actions, .pn-controls) button {
    min-height: 2.75rem;
    padding: 0.65rem 0.85rem;
    border: var(--rule-width) solid currentColor;
    border-radius: 0;
    color: inherit;
    background: transparent;
    font-family: var(--font-ui);
    line-height: 1.4;
    cursor: pointer;
  }

  .pn-controls [data-action="race"] {
    color: var(--instrument-deep);
    background: var(--signal);
    font-weight: 650;
  }

  :is(.replica-actions, .pn-controls) button:hover:not(:disabled) {
    color: var(--instrument-deep);
    background: var(--signal);
  }

  :is(.replica-actions, .pn-controls) button:active:not(:disabled) {
    color: var(--instrument-deep);
    background: var(--clear);
  }

  :is(.replica-actions, .pn-controls) button:disabled {
    border-style: dashed;
    color: color-mix(in oklch, var(--clear) 58%, var(--instrument));
    cursor: not-allowed;
  }

  [data-enhancement-note] {
    grid-column: 1 / -1;
    margin: 0;
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }

  .pn-result,
  .pn-error {
    max-width: none;
    margin: 0;
    padding: var(--space-4);
    color: var(--instrument-deep);
    background: var(--signal);
    font-family: var(--font-ui);
    font-weight: 650;
  }

  .pn-error {
    margin-top: var(--space-3);
    color: var(--clear);
    background: var(--interference);
  }

  [hidden] {
    display: none;
  }

  .pn-explanation {
    margin-top: var(--space-5);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .pn-explanation summary {
    min-height: 44px;
    padding-block: var(--space-4);
    font-family: var(--font-ui);
    font-weight: 650;
    cursor: pointer;
  }

  .pn-explanation summary:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .pn-explanation > div {
    padding-bottom: var(--space-5);
  }

  .pn-explanation :is(table, pre) {
    width: 100%;
    margin-block: var(--space-4);
  }

  .pn-explanation table {
    border-collapse: collapse;
  }

  .pn-explanation :is(th, td) {
    padding: var(--space-3);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
    text-align: left;
  }

  .pn-explanation th {
    font-family: var(--font-ui);
  }

  @media (width < 48rem) {
    .pn-heading,
    .pn-controls,
    .pn-network {
      grid-template-columns: 1fr;
    }

    .pn-network {
      grid-template-areas:
        "a"
        "sequencer"
        "b"
        "c";
      gap: var(--space-5);
    }

    .operation-key {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }

    .replica-c {
      justify-self: stretch;
      width: auto;
    }

    .sequencer-channel {
      padding-block: var(--space-3);
    }

    .operation-log {
      min-height: 6rem;
      max-height: 8rem;
      flex: none;
    }

    .pn-explanation {
      overflow-x: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.pn-operation-pulse) {
      display: none;
    }
  }
</style>
