---
import DemoTransportControls from "./DemoTransportControls.astro";
import StationMark from "./StationMark.astro";
import { demoReplicaName, REPLICA_IDS } from "../lib/structure-demo/replicas";
import "../styles/fifo-work-queue-demo.css";
import "../styles/structure-demo-shell.css";
---

<fifo-work-queue-demo class="structure-demo-root" data-testid="fifo-work-queue-demo">
  <section class="queue-demo instrument-panel structure-demo-instrument" aria-labelledby="fifo-work-queue-demo-title">
    <div class="structure-demo-operation-layer" data-operation-layer aria-hidden="true"></div>
    <header>
      <div>
        <h2 id="fifo-work-queue-demo-title">Dispatch the trail jobs</h2>
        <p>Claim the oldest queued job. Complete it, or release it to the back of the queue.</p>
      </div>
      <p class="queue-rule"><span>Queue rule</span><strong>First in, first out</strong></p>
    </header>

    <div class="queue-board" aria-label="Work queue state">
      <section>
        <h3>Queued</h3>
        <p>Oldest job is first.</p>
        <ol data-queue>
          <li>inspect bridge</li>
          <li>clear fallen branch</li>
          <li>restock first-aid cache</li>
        </ol>
      </section>
      <section>
        <h3>In progress</h3>
        <p>Each job has one holder.</p>
        <ul data-active></ul>
      </section>
      <section>
        <h3>Done</h3>
        <p>Completion history is separate.</p>
        <ul data-done><li>No completed jobs yet.</li></ul>
      </section>
    </div>

    <div class="queue-workbench">
      {REPLICA_IDS.map((id, index) => (
        <Fragment>
          <section class="queue-worker" data-worker={id}>
            <header><StationMark station={id} size="lg" /><h3>{demoReplicaName(id)}</h3></header>
            <p><span>Held job</span><strong data-held>None</strong></p>
            <div>
              <button type="button" data-queue-action="acquire" disabled>Claim next</button>
              <button type="button" data-queue-action="complete" disabled>Complete</button>
              <button type="button" data-queue-action="release" disabled>Release</button>
            </div>
          </section>
          {index === 0 && (
            <aside class="queue-exchange" aria-label="Sequencer and operation log">
              <div class="queue-sequencer" data-relay-node>
                <h3>Sequencer</h3>
                <p>Applies each queue operation in one shared order.</p>
                <output data-sequence>SN 0</output>
              </div>
              <ol data-log aria-label="Sequenced operation log, newest first" reversed>
                <li>No operations accepted yet.</li>
              </ol>
            </aside>
          )}
        </Fragment>
      ))}
    </div>

    <DemoTransportControls />

    <div class="queue-controls">
      <div>
        <h3>Run the worked example</h3>
        <p>Alice and Bob claim work. Alice releases hers. Carol then gets the next FIFO job, and Bob completes his.</p>
      </div>
      <button type="button" data-worked-example disabled>Run release-to-tail example</button>
      <button type="button" data-reset disabled>Reset</button>
      <p data-enhancement-note>Enable JavaScript to run the queue. The expected result remains in the lesson.</p>
    </div>
    <p role="status" data-status>Ready: three jobs queued.</p>
    <p role="alert" data-error hidden></p>
  </section>
</fifo-work-queue-demo>

<script>
  import {
    acquireQueueJob,
    completeQueueJob,
    createRemainingDemo,
    deliverRemainingRace,
    releaseQueueJob,
    type RemainingDemoState,
  } from "../lib/structure-demo/remaining-structure-demo";
  import { animateDemoOperation } from "../lib/structure-demo/demo-operation-flight";
  import {
    autoDeliveryChangeEvent,
    DemoTransportControlsElement,
  } from "../lib/structure-demo/demo-transport-controls";
  import { demoReplicaName, REPLICA_IDS } from "../lib/structure-demo/replicas";

  type Replica = "A" | "B" | "C";
  type QueueAction = "acquire" | "complete" | "release";
  type QueueOperation = {
    action: QueueAction;
    author: Replica;
    held?: string;
    delivered: boolean;
    sequenceNumber?: number;
  };

  class FifoWorkQueueDemo extends HTMLElement {
    private state!: RemainingDemoState;
    private done: string[] = [];
    private operations: QueueOperation[] = [];
    private delivering = false;
    private delivery?: Promise<void>;
    private outboundArrivals: Promise<void>[] = [];
    private activeAnimations = new Set<Animation>();

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      this.querySelector<HTMLElement>("[data-enhancement-note]")!.hidden = true;
      this.reset();
      this.querySelectorAll<HTMLButtonElement>("[data-queue-action]").forEach((button) => {
        button.addEventListener("click", () => {
          const worker = button.closest<HTMLElement>("[data-worker]")?.dataset.worker;
          if (worker !== "A" && worker !== "B" && worker !== "C") return;
          const action = button.dataset.queueAction;
          if (action !== "acquire" && action !== "complete" && action !== "release") return;
          this.queue(action, worker);
        });
      });
      this.querySelector<HTMLButtonElement>("[data-worked-example]")!.addEventListener("click", async () => {
        this.reset();
        await this.queueAndDeliver("acquire", "A");
        await this.queueAndDeliver("acquire", "B");
        await this.queueAndDeliver("release", "A");
        await this.queueAndDeliver("acquire", "C");
        await this.queueAndDeliver("complete", "B");
        this.render("The released bridge inspection is now behind the remaining queued work.");
      });
      this.querySelector<HTMLButtonElement>("[data-reset]")!.addEventListener("click", () => this.reset());
      this.transport.addEventListener(autoDeliveryChangeEvent, () => {
        if (this.transport.autoDeliver && this.state.view.pending > 0) {
          void this.deliver();
        }
      });
    }

    private queue(action: QueueAction, replica: Replica) {
      try {
        const held = this.heldJobs().get(replica);
        if (action === "acquire") this.state = acquireQueueJob(this.state, replica);
        else if (action === "release") this.state = releaseQueueJob(this.state, replica);
        else {
          if (!held) throw new Error("This worker does not hold a job.");
          this.state = completeQueueJob(this.state, replica);
        }
        this.operations.unshift({ action, author: replica, held, delivered: false });
        const verb = action === "acquire" ? "claim next" : action;
        this.outboundArrivals.push(this.animateOperation(
          this.querySelector<HTMLElement>(`[data-worker="${replica}"]`)!,
          this.querySelector<HTMLElement>("[data-relay-node]")!,
          verb,
          "outbound",
          this.transport.nextDuration(420),
        ));
        this.render(`Queued ${demoReplicaName(replica)}'s ${verb} operation.`);
        if (this.transport.autoDeliver) void this.deliver();
      } catch (error) {
        const alert = this.querySelector<HTMLElement>("[data-error]")!;
        alert.hidden = false;
        alert.textContent = error instanceof Error ? error.message : String(error);
      }
    }

    private async queueAndDeliver(action: QueueAction, replica: Replica) {
      this.queue(action, replica);
      await this.deliver();
    }

    private deliver(): Promise<void> {
      if (this.delivery) return this.delivery;
      if (this.state.view.pending === 0) return Promise.resolve();
      this.delivery = this.deliverPending().finally(() => {
        this.delivery = undefined;
        if (this.transport.autoDeliver && this.state.view.pending > 0) {
          void this.deliver();
        }
      });
      return this.delivery;
    }

    private async deliverPending() {
      this.delivering = true;
      this.renderControls();
      try {
        while (this.outboundArrivals.length > 0) {
          await Promise.all(this.outboundArrivals.splice(0));
        }
        const pending = [...this.operations].reverse().filter(({ delivered }) => !delivered);
        let sequenceNumber = this.state.view.sequenceNumber;
        for (const operation of pending) {
          sequenceNumber += 1;
          operation.sequenceNumber = sequenceNumber;
        }
        await Promise.all(REPLICA_IDS.flatMap((id) => pending.map((operation) =>
          this.animateOperation(
            this.querySelector<HTMLElement>("[data-relay-node]")!,
            this.querySelector<HTMLElement>(`[data-worker="${id}"]`)!,
            `SN ${operation.sequenceNumber}`,
            "shared",
            this.transport.nextDuration(480),
          )
        )));
        this.state = deliverRemainingRace(this.state);
        for (const operation of pending) {
          operation.delivered = true;
          if (operation.action === "complete" && operation.held) {
            this.done.unshift(operation.held);
          }
        }
        this.render(`Sequenced through SN ${this.state.view.sequenceNumber}.`);
      } catch (error) {
        const alert = this.querySelector<HTMLElement>("[data-error]")!;
        alert.hidden = false;
        alert.textContent = error instanceof Error ? error.message : String(error);
      } finally {
        this.delivering = false;
        this.renderControls();
      }
    }

    private animateOperation(
      from: HTMLElement,
      to: HTMLElement,
      label: string,
      leg: "outbound" | "shared",
      duration: number,
    ): Promise<void> {
      return animateDemoOperation({
        activeAnimations: this.activeAnimations,
        className: "queue-operation-pulse",
        duration,
        from,
        label,
        labelClassName: "queue-operation-label",
        layer: this.querySelector<HTMLElement>("[data-operation-layer]")!,
        leg,
        to,
      });
    }

    private values(): string[] {
      return this.state.view.replicas.find(({ id }) => id === "C")?.values ?? [];
    }

    private heldJobs(): Map<Replica, string> {
      const jobs = new Map<Replica, string>();
      for (const value of this.values()) {
        const match = /^(Alice|Bob|Carol) owns (.+)$/.exec(value);
        if (!match) continue;
        jobs.set(match[1] === "Alice" ? "A" : match[1] === "Bob" ? "B" : "C", match[2]);
      }
      return jobs;
    }

    private get transport(): DemoTransportControlsElement {
      const controls = this.querySelector<DemoTransportControlsElement>(
        "demo-transport-controls",
      );
      if (!controls) throw new Error("Missing queue transport controls.");
      return controls;
    }

    private render(status: string) {
      const queue = this.values().filter((value) => value.startsWith("Queue: ")).map((value) => value.slice(7));
      const held = this.heldJobs();
      this.fill("[data-queue]", queue, true);
      this.fill("[data-active]", [...held].map(([id, job]) => `${demoReplicaName(id)} · ${job}`));
      this.fill("[data-done]", this.done);
      for (const id of REPLICA_IDS) {
        const worker = this.querySelector<HTMLElement>(`[data-worker="${id}"]`)!;
        worker.querySelector<HTMLElement>("[data-held]")!.textContent = held.get(id) ?? "None";
      }
      this.querySelector<HTMLOutputElement>("[data-sequence]")!.textContent = `SN ${this.state.view.sequenceNumber}`;
      this.renderLog();
      this.querySelector<HTMLElement>("[data-status]")!.textContent = status;
      this.renderControls();
      const alert = this.querySelector<HTMLElement>("[data-error]")!;
      alert.hidden = true;
      alert.textContent = "";
    }

    private renderControls() {
      const queue = this.values().some((value) => value.startsWith("Queue: "));
      const held = this.heldJobs();
      const pendingAuthors = new Set(
        this.operations.filter(({ delivered }) => !delivered).map(({ author }) => author),
      );
      for (const id of REPLICA_IDS) {
        const worker = this.querySelector<HTMLElement>(`[data-worker="${id}"]`)!;
        worker.querySelector<HTMLButtonElement>('[data-queue-action="acquire"]')!.disabled =
          pendingAuthors.has(id) || held.has(id) || !queue;
        worker.querySelector<HTMLButtonElement>('[data-queue-action="complete"]')!.disabled =
          pendingAuthors.has(id) || !held.has(id);
        worker.querySelector<HTMLButtonElement>('[data-queue-action="release"]')!.disabled =
          pendingAuthors.has(id) || !held.has(id);
      }
      this.querySelector<HTMLButtonElement>("[data-worked-example]")!.disabled = this.delivering;
      this.querySelector<HTMLButtonElement>("[data-reset]")!.disabled = this.delivering;
    }

    private renderLog() {
      const target = this.querySelector<HTMLOListElement>("[data-log]")!;
      target.replaceChildren(...(this.operations.length ? this.operations : [null]).map((operation) => {
        const item = document.createElement("li");
        if (!operation) {
          item.textContent = "No operations accepted yet.";
          return item;
        }
        const action = operation.action === "acquire"
          ? "claim next"
          : `${operation.action} ${operation.held}`;
        const stamp = operation.sequenceNumber === undefined ? "" : `SN ${operation.sequenceNumber} · `;
        item.textContent = `${stamp}${demoReplicaName(operation.author)}: ${action} — ${operation.delivered ? "delivered" : "waiting"}`;
        return item;
      }));
    }

    private fill(selector: string, values: string[], ordered = false) {
      const target = this.querySelector<HTMLElement>(selector)!;
      const empty = selector === "[data-done]" ? "No completed jobs yet."
        : selector === "[data-active]" ? "No jobs in progress."
        : selector === "[data-log]" ? "No operations accepted yet."
        : "Queue empty.";
      target.replaceChildren(...(values.length ? values : [empty]).map((value, index) => {
        const item = document.createElement("li");
        item.textContent = ordered && values.length ? `${index + 1}. ${value}` : value;
        return item;
      }));
    }

    private reset() {
      for (const animation of this.activeAnimations) animation.cancel();
      this.activeAnimations.clear();
      this.querySelector<HTMLElement>("[data-operation-layer]")?.replaceChildren();
      this.state = createRemainingDemo("fifo-work-queue");
      this.done = [];
      this.operations = [];
      this.outboundArrivals = [];
      this.delivering = false;
      this.delivery = undefined;
      this.render("Ready: three jobs queued.");
    }
  }

  if (!customElements.get("fifo-work-queue-demo")) {
    customElements.define("fifo-work-queue-demo", FifoWorkQueueDemo);
  }
</script>
