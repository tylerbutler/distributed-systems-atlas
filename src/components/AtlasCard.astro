---
import type { SheetMeta } from "../lib/atlas/graph";

interface Props {
  sheet: Pick<SheetMeta, "id" | "title" | "summary" | "status">;
}

const { sheet } = Astro.props;
---

<li class="atlas-card">
  <h3>
    {sheet.status === "published"
      ? <a href={`/atlas/${sheet.id}/`}>{sheet.title}</a>
      : sheet.title}
  </h3>
  {sheet.status === "planned" && <span class="status">Planned</span>}
  {sheet.summary && <p>{sheet.summary}</p>}
</li>
