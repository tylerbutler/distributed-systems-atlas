---
import StationMark from "./StationMark.astro";
import {
  createRegisterDemo,
  registerUserName,
  type RegisterKind,
  type ReplicaId,
} from "../lib/structure-demo/register-demo";

interface Props {
  kind: RegisterKind;
  title: string;
  description: string;
  rule: string;
  raceLabel: string;
}

const { kind, title, description, rule, raceLabel } = Astro.props;
const initial = createRegisterDemo(kind);
const valueByReplica: Record<ReplicaId, string> = {
  A: "Trail open",
  B: "Trail closed",
  C: "Inspect bridge",
};
const statusOptions = ["Trail open", "Trail closed", "Inspect bridge"];

function raceNote(replica: ReplicaId): { body: string; evidence: string } {
  if (replica === "C") {
    return { body: "No note in this race", evidence: "Carol observes delivery" };
  }
  const body = `trail-status: ${valueByReplica[replica]}`;
  if (kind === "lww-register") {
    return {
      body,
      evidence: `sequence ${replica === "A" ? "1" : "2"} · writer ${replica}`,
    };
  }
  if (kind === "mv-register") {
    return {
      body,
      evidence: `write identity ${replica}:1 · no other note received`,
    };
  }
  return { body, evidence: "sequence number assigned at ranger station" };
}
---

<register-structure-demo data-kind={kind} data-testid={`${kind}-demo`}>
  <section class="register-instrument" aria-labelledby={`${kind}-demo-title`}>
    <div class="operation-layer" data-operation-layer aria-hidden="true"></div>
    <header class="register-heading">
      <div>
        <p class="instrument-kicker">One trail-status field</p>
        <h2 id={`${kind}-demo-title`}>{title}</h2>
        <p>{description}</p>
      </div>
      <p class="merge-rule">
        Conflict rule
        <strong>{rule}</strong>
      </p>
    </header>

    <div class="register-network">
      {initial.view.replicas.map((replica) => (
        <section
          class={`register-replica replica-${replica.id.toLowerCase()}`}
          data-client={replica.id}
          aria-label={`${registerUserName(replica.id)}'s register replica`}
        >
          <header>
            <StationMark station={replica.id} size="lg" />
            <div>
              <h3>{registerUserName(replica.id)}</h3>
              <p data-replica-state={replica.id}>No status received</p>
            </div>
          </header>
          <div class="register-values" data-register-values={replica.id}>
            <em>No status</em>
          </div>
          <p class="paper-note">
            <span>Field note</span>
            <strong>{raceNote(replica.id).body}</strong>
            <small>{raceNote(replica.id).evidence}</small>
          </p>
          <form class="register-write" data-register-form data-replica={replica.id}>
            <label>
              <span>Trail status</span>
              <select
                data-register-input={replica.id}
                disabled
              >
                {statusOptions.map((status) => <option value={status}>{status}</option>)}
              </select>
            </label>
            <button type="submit" data-register-write disabled>Write status</button>
          </form>
        </section>
      ))}

      <section class="register-relay" data-relay-node aria-label="Register message relay">
        <span>{kind === "mv-register" ? "Trail exchange" : "Ranger sequencer"}</span>
        <strong>
          {kind === "mv-register"
            ? "Does not choose by arrival order"
            : "Assigns sequence numbers"}
        </strong>
        <output data-message-count>0 writes shared</output>
      </section>
    </div>

    <div class="register-evidence">
      <p>
        <span>Decision evidence</span>
        <strong data-evidence>
          {kind === "lww-register"
            ? "No sequenced write yet."
            : kind === "mv-register"
              ? "No alternatives yet."
              : "No sequenced versions yet."}
        </strong>
      </p>
      <ol data-history aria-label="Register write log" reversed>
        <li>No writes shared yet.</li>
      </ol>
    </div>

    <div class="register-controls">
      <button type="button" data-action="race" disabled>{raceLabel}</button>
      <button type="button" data-action="reset" disabled>Reset</button>
      <p data-enhancement-note>
        Enable JavaScript to run the demo. The race and expected result remain
        in the lesson.
      </p>
    </div>

    <p class="register-result" role="status" aria-live="polite" aria-atomic="true">
      {initial.result}
    </p>
    <p class="register-error" role="alert" hidden></p>
  </section>
</register-structure-demo>

<script>
  import "../lib/structure-demo/register-demo-element";
</script>

<style>
  register-structure-demo {
    display: block;
    width: min(calc(100vw - 2rem), var(--content));
    max-width: none;
    margin-block: var(--space-7);
    margin-inline: 50%;
    transform: translateX(-50%);
  }

  .register-instrument {
    position: relative;
    padding: clamp(1rem, 3vw, 2rem);
    border: var(--rule-width) solid var(--instrument-deep);
    color: var(--clear);
    background: var(--instrument);
    --focus-color: var(--signal);
  }

  .operation-layer {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  :global(.register-operation-pulse) {
    position: absolute;
    top: 0;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--signal);
  }

  :global(.register-operation-pulse.shared) {
    background: var(--clear);
  }

  :global(.register-operation-label) {
    position: absolute;
    bottom: calc(100% + 5px);
    left: 50%;
    padding: 2px 5px;
    border-radius: 0;
    color: var(--instrument-deep);
    background: inherit;
    font: 700 0.6875rem/1 var(--font-data);
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .register-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
    gap: var(--space-6);
    align-items: end;
    padding-bottom: var(--space-5);
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, transparent);
  }

  .register-heading :is(h2, p),
  .register-replica :is(h3, p),
  .register-relay :is(span, strong, output) {
    margin: 0;
  }

  .instrument-kicker {
    color: var(--signal);
    font: 700 0.75rem/1 var(--font-data);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .register-heading h2 {
    margin-top: var(--space-2);
  }

  .register-heading h2 + p {
    margin-top: var(--space-3);
  }

  .merge-rule {
    padding: var(--space-4);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 45%, transparent);
    font: 0.875rem/1.45 var(--font-ui);
  }

  .merge-rule strong {
    display: block;
    margin-top: var(--space-2);
    color: var(--signal);
    font-size: 1rem;
  }

  .register-network {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas: "a relay b" "c c c";
    gap: var(--space-5);
    align-items: start;
    padding-block: var(--space-6);
  }

  .register-replica {
    min-width: 0;
    padding: var(--space-4);
    border: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, transparent);
  }

  .replica-a { grid-area: a; }
  .replica-b { grid-area: b; }
  .replica-c {
    grid-area: c;
    width: min(100%, 24rem);
    justify-self: center;
  }

  .register-replica header {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .register-replica header p {
    color: color-mix(in oklch, var(--clear) 70%, transparent);
    font: 0.75rem/1.35 var(--font-ui);
  }

  .register-values {
    display: grid;
    min-height: 5.5rem;
    margin-block: var(--space-4);
    padding: var(--space-3);
    border: var(--rule-width) solid color-mix(in oklch, var(--clear) 22%, transparent);
    align-content: start;
    gap: var(--space-2);
  }

  .paper-note {
    display: grid;
    margin: 0 0 var(--space-4);
    padding: var(--space-3);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, transparent);
    gap: var(--space-1);
    font-family: var(--font-ui);
  }

  .paper-note span,
  .paper-note small {
    color: color-mix(in oklch, var(--clear) 68%, transparent);
    font-size: 0.75rem;
  }

  .paper-note strong {
    color: var(--signal);
    font-family: var(--font-data);
    font-size: 0.8rem;
  }

  .register-values span {
    padding: 0.35rem 0.55rem;
    border-left: var(--rule-signal) solid var(--signal);
    color: var(--clear);
    background: color-mix(in oklch, var(--clear) 7%, transparent);
    font: 700 0.78rem/1.3 var(--font-data);
  }

  .register-values em {
    color: color-mix(in oklch, var(--clear) 58%, transparent);
    font-size: 0.875rem;
  }

  .register-instrument button {
    min-height: 2.75rem;
    border: var(--rule-width) solid var(--clear);
    color: var(--clear);
    background: transparent;
    font: 700 0.78rem/1 var(--font-ui);
  }

  .register-write {
    display: grid;
    gap: var(--space-2);
  }

  .register-write label {
    display: grid;
    gap: var(--space-1);
    color: color-mix(in oklch, var(--clear) 72%, transparent);
    font: 0.75rem/1.35 var(--font-ui);
  }

  .register-write select {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border: var(--rule-width) solid color-mix(in oklch, var(--clear) 55%, transparent);
    border-radius: 0;
    color: var(--instrument-deep);
    background: var(--clear);
    font: 0.875rem/1 var(--font-ui);
  }

  .register-write select:focus-visible {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
  }

  .register-instrument button:hover:not(:disabled) {
    color: var(--instrument-deep);
    background: var(--signal);
  }

  .register-relay {
    grid-area: relay;
    display: grid;
    min-height: 9rem;
    padding: var(--space-4);
    border: var(--rule-width) dashed var(--signal);
    place-content: center;
    gap: var(--space-2);
    text-align: center;
  }

  .register-relay span,
  .register-relay output {
    font: 0.72rem/1.3 var(--font-data);
    text-transform: uppercase;
  }

  .register-relay strong {
    color: var(--signal);
  }

  .register-evidence {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, transparent);
  }

  .register-evidence :is(p, ol) {
    margin: 0;
  }

  .register-evidence p span {
    display: block;
    color: color-mix(in oklch, var(--clear) 65%, transparent);
    font: 0.72rem/1.3 var(--font-data);
    text-transform: uppercase;
  }

  .register-evidence p strong {
    display: block;
    margin-top: var(--space-2);
    color: var(--signal);
  }

  .register-evidence ol {
    max-height: 8rem;
    padding-left: 1.25rem;
    overflow: auto;
    font: 0.75rem/1.45 var(--font-data);
  }

  .register-controls {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    padding-top: var(--space-4);
  }

  .register-controls [data-action="race"] {
    color: var(--instrument-deep);
    background: var(--signal);
    border-color: var(--signal);
  }

  .register-controls p {
    margin: 0;
    color: color-mix(in oklch, var(--clear) 68%, transparent);
    font: 0.75rem/1.4 var(--font-ui);
  }

  .register-result,
  .register-error {
    margin: var(--space-4) 0 0;
    font-family: var(--font-ui);
    font-weight: 700;
  }

  .register-error {
    color: var(--signal);
  }

  @media (max-width: 760px) {
    .register-heading,
    .register-evidence {
      grid-template-columns: 1fr;
    }

    .register-network {
      grid-template-columns: 1fr;
      grid-template-areas: "a" "b" "c" "relay";
    }

    .replica-c {
      width: auto;
    }

    .register-controls {
      align-items: stretch;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.register-operation-pulse) {
      display: none;
    }
  }
</style>
