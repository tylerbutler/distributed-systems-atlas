---
import DemoTransportControls from "./DemoTransportControls.astro";
import StationMark from "./StationMark.astro";
import { sequenceStopMarks, type RemainingStructure } from "../lib/structure-demo/remaining-structures";
import "../styles/remaining-structure-demo.css";

interface Props {
  structure: RemainingStructure;
}

const { structure } = Astro.props;
---

<remaining-structure-demo
  data-testid={`${structure.id}-demo`}
  data-kind={structure.id}
>
  <section class="remaining-demo instrument-panel" aria-labelledby={`${structure.id}-demo-title`}>
    <header>
      <div>
        <h2 id={`${structure.id}-demo-title`}>
          {structure.id === "shared-sequence" ? "Edit the inspection route" : `${structure.name} at Eagle Creek`}
        </h2>
        <p>
          {structure.id === "shared-sequence"
            ? "Alice and Bob add stops before Weir. Turn off Broadcast to see each notebook before their insertion notes arrive."
            : structure.story}
        </p>
      </div>
      <p class="remaining-rule"><span>Merge rule</span><strong>{structure.rule}</strong></p>
    </header>
    <div class:list={["remaining-clients", { "sequence-clients": structure.id === "shared-sequence" }]}>
      {(["A", "B", "C"] as const).map((id, index) => (
        <Fragment>
          <section data-client={id} aria-label={`${["Alice", "Bob", "Carol"][index]}'s replica`}>
            <header><StationMark station={id} size="lg" /><h3>{["Alice", "Bob", "Carol"][index]}</h3></header>
            <p class="remaining-local-record">
              <span>{structure.id === "shared-sequence" ? "Route in this notebook" : structure.recordLabel}</span>
              <strong data-local-record>{structure.initialRecord[id]}</strong>
            </p>
            <p class="remaining-paper-note">
              <span>{structure.id === "shared-sequence" && id === "C" ? "Observation" : structure.messageLabel}</span>
              <strong>{structure.local[id]}</strong>
              <small>
                {structure.id === "shared-sequence" && id !== "C"
                  ? <>{structure.evidence[id]}: <span class="dotted-value">{id === "A" ? "Falls" : "Marsh"}<sup>{id === "A" ? sequenceStopMarks.Falls : sequenceStopMarks.Marsh}</sup></span></>
                  : structure.evidence[id]}
              </small>
            </p>
            {(structure.id !== "shared-sequence" || id !== "C") && (
              <button type="button" data-client-action disabled>
                {structure.id === "shared-sequence" ? `Insert ${id === "A" ? "Falls" : "Marsh"}` : "Send note"}
              </button>
            )}
          </section>
          {structure.id === "shared-sequence" && index === 0 && (
            <section class="remaining-exchange" aria-label="Trail exchange">
              <h3>Trail exchange</h3>
              <output data-pending>0 notes waiting</output>
              <ol data-note-log aria-label="Insertion note log" reversed>
                <li>No insertion notes yet.</li>
              </ol>
            </section>
          )}
        </Fragment>
      ))}
    </div>
    <section class="remaining-state" aria-label={structure.id === "shared-sequence" ? "Carol's current route" : "Carol's current view"}>
      <span>{structure.id === "shared-sequence" ? "Carol's current route" : "Carol's current view"}</span>
      <ul data-state>{structure.initial.map((item) => <li>{item}</li>)}</ul>
    </section>
    <DemoTransportControls />

    <div class="remaining-controls">
      <div>
        <h3>Run the worked example</h3>
        <p>Queue the hikers' notes together, or reset and send one at a time.</p>
      </div>
      <button type="button" data-action="race" disabled>{structure.raceLabel}</button>
      <button type="button" data-action="reset" disabled>Reset</button>
      <p data-enhancement-note>Enable JavaScript to run the race. The expected result remains in the lesson.</p>
    </div>
    <p role="status" data-status>{`Ready: ${structure.initial.join(" · ")}`}</p>
    <p role="alert" data-error hidden></p>
  </section>
</remaining-structure-demo>

<script>
  import {
    actInRemainingDemo,
    createRemainingDemo,
    deliverRemainingRace,
    stageRemainingRace,
    type RemainingDemoState,
  } from "../lib/structure-demo/remaining-structure-demo";
  import {
    autoDeliveryChangeEvent,
    DemoTransportControlsElement,
  } from "../lib/structure-demo/demo-transport-controls";
  import { sequenceStopMarks } from "../lib/structure-demo/remaining-structures";

  class RemainingStructureDemo extends HTMLElement {
    private state!: RemainingDemoState;
    private delivering = false;
    private generation = 0;
    private acted = new Set<string>();
    private sequenceNotes: Array<"A" | "B"> = [];

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      const note = this.querySelector("[data-enhancement-note]");
      if (note instanceof HTMLElement) note.hidden = true;
      this.state = createRemainingDemo(this.kind);
      this.querySelectorAll<HTMLButtonElement>("[data-client-action]").forEach((button) => {
        button.addEventListener("click", () => {
          const client = button.closest<HTMLElement>("[data-client]")?.dataset.client;
          if (client !== "A" && client !== "B" && client !== "C") {
            this.showError("Missing client identity.");
            return;
          }
          try {
            const pendingBefore = this.state.view.pending;
            this.state = actInRemainingDemo(this.state, client);
            if (this.kind === "shared-sequence" && this.state.view.pending > pendingBefore) {
              if (client !== "A" && client !== "B") throw new Error("Unexpected sequence note author");
              this.sequenceNotes.unshift(client);
            }
            this.acted.add(client);
            this.clearError();
            this.render(this.state.view.pending > pendingBefore
              ? `Queued ${client}'s note. The other hikers can still send theirs.`
              : `${client} checked their notebook. No note was sent.`);
            if (this.transport.autoDeliver) void this.deliver(button);
          } catch (error) {
            this.showError(error);
          }
        });
      });
      this.race.addEventListener("click", () => {
        this.resetFlow();
        try {
          this.state = stageRemainingRace(this.state);
          this.acted = new Set(["A", "B", "C"]);
          if (this.kind === "shared-sequence") {
            if (this.state.view.pending !== 2) throw new Error("Expected Alice's and Bob's insertion notes");
            this.sequenceNotes = ["B", "A"];
          }
          this.clearError();
          this.render("Notes queued for delivery.");
          if (this.transport.autoDeliver) void this.deliver(this.race);
        } catch (error) {
          this.showError(error);
        }
      });
      this.querySelector('[data-action="reset"]')?.addEventListener("click", (event) => {
        this.resetFlow();
        this.clearError();
        this.render();
        (event.currentTarget as HTMLButtonElement).focus();
      });
      this.transport.addEventListener(autoDeliveryChangeEvent, () => {
        if (this.transport.autoDeliver && this.state.view.pending > 0) {
          void this.deliver(this.transport);
        }
      });
      this.render();
    }

    private get kind(): RemainingDemoState["kind"] {
      const kind = this.dataset.kind;
      if (
        kind === "shared-sequence"
        || kind === "shared-text"
        || kind === "claims"
        || kind === "ordered-collection"
        || kind === "task-manager"
        || kind === "pact-map"
        || kind === "json-ot"
        || kind === "shared-rich-text"
      ) return kind;
      throw new Error("Missing remaining demo kind");
    }

    private get race(): HTMLButtonElement {
      const button = this.querySelector<HTMLButtonElement>('[data-action="race"]');
      if (!button) throw new Error("Missing remaining demo race control");
      return button;
    }

    private get transport(): DemoTransportControlsElement {
      const controls = this.querySelector<DemoTransportControlsElement>(
        "demo-transport-controls",
      );
      if (!controls) throw new Error("Missing remaining demo transport controls");
      return controls;
    }

    private async deliver(focus: HTMLElement): Promise<void> {
      if (this.delivering || this.state.view.pending === 0) return;
      this.delivering = true;
      this.renderControls();
      const generation = this.generation;
      await new Promise((resolve) =>
        window.setTimeout(resolve, this.transport.nextDuration(800))
      );
      if (generation !== this.generation) return;
      try {
        this.state = deliverRemainingRace(this.state);
        this.clearError();
        this.render(this.state.view.pending > 0
          ? "Some notes still await delivery."
          : "Delivery complete.");
        focus.focus();
      } catch (error) {
        this.showError(error);
      } finally {
        if (generation !== this.generation) return;
        this.delivering = false;
        this.renderControls();
        if (this.transport.autoDeliver && this.state.view.pending > 0) {
          void this.deliver(focus);
        }
      }
    }

    private resetFlow(): void {
      this.generation += 1;
      this.delivering = false;
      this.acted.clear();
      this.sequenceNotes = [];
      this.state = createRemainingDemo(this.kind);
    }

    private render(statusText?: string): void {
      const shared = this.state.view.replicas.find(({ id }) => id === "C")
        ?? this.state.view.replicas[0];
      this.renderValues(
        this.querySelector<HTMLElement>("[data-state]"),
        shared?.values ?? [],
      );
      for (const replica of this.state.view.replicas) {
        const record = this.querySelector<HTMLElement>(
          `[data-client="${replica.id}"] [data-local-record]`,
        );
        if (record) {
          if (this.kind === "shared-sequence") {
            const nodes: Node[] = [];
            for (const [index, value] of replica.values.entries()) {
              if (index) nodes.push(document.createTextNode(" · "));
              nodes.push(this.sequenceValue(value));
            }
            record.replaceChildren(...nodes);
          } else {
            record.textContent = replica.values.join(" · ");
          }
        }
      }
      this.renderSequenceNotes();
      this.dataset.kernelSequence = String(this.state.view.sequenceNumber);
      const status = this.querySelector<HTMLElement>("[data-status]");
      if (status) {
        status.textContent = statusText
          ?? `Ready: ${(shared?.values ?? []).join(" · ")}`;
      }
      this.renderControls();
    }

    private renderSequenceNotes(): void {
      if (this.kind !== "shared-sequence") return;
      const pending = this.querySelector<HTMLOutputElement>("[data-pending]");
      const log = this.querySelector<HTMLOListElement>("[data-note-log]");
      if (!pending || !log) throw new Error("Missing trail exchange");
      const count = this.state.view.pending;
      pending.textContent = `${count} ${count === 1 ? "note" : "notes"} waiting`;
      log.replaceChildren(...(this.sequenceNotes.length
        ? this.sequenceNotes.map((id) => {
          const description = this.querySelector<HTMLElement>(
            `[data-client="${id}"] .remaining-paper-note strong`,
          )?.textContent;
          if (!description) throw new Error(`Missing ${id} insertion note`);
          const item = document.createElement("li");
          item.textContent = `${id === "A" ? "Alice" : "Bob"}: ${description} — ${count ? "waiting" : "delivered"}`;
          return item;
        })
        : [Object.assign(document.createElement("li"), { textContent: "No insertion notes yet." })]));
    }

    private renderValues(target: HTMLElement | null, values: string[]): void {
      if (!target) throw new Error("Missing remaining demo state");
      target.replaceChildren(...values.map((value) => {
        const item = document.createElement("li");
        item.append(this.kind === "shared-sequence" ? this.sequenceValue(value) : value);
        return item;
      }));
    }

    private sequenceValue(value: string): Node {
      const mark = value === "Falls"
        ? sequenceStopMarks.Falls
        : value === "Marsh" ? sequenceStopMarks.Marsh : null;
      if (!mark) return document.createTextNode(value);
      const labeled = document.createElement("span");
      labeled.className = "dotted-value";
      labeled.textContent = value;
      const sup = document.createElement("sup");
      sup.textContent = mark;
      labeled.append(sup);
      return labeled;
    }

    private renderControls(): void {
      for (const button of this.querySelectorAll<HTMLButtonElement>(
        "[data-client-action]",
      )) {
        const client = button.closest<HTMLElement>("[data-client]")?.dataset.client;
        button.disabled = client ? this.acted.has(client) : true;
      }
      this.race.disabled = this.delivering;
      const reset = this.querySelector<HTMLButtonElement>('[data-action="reset"]');
      if (reset) reset.disabled = false;
    }

    private showError(error: unknown): void {
      const message = error instanceof Error ? error.message : String(error);
      const alert = this.querySelector<HTMLElement>("[data-error]");
      if (alert) {
        alert.hidden = false;
        alert.textContent = `The change failed: ${message}`;
      }
      const status = this.querySelector<HTMLElement>("[data-status]");
      if (status) status.textContent = "The last valid kernel state is unchanged.";
      this.renderControls();
    }

    private clearError(): void {
      const alert = this.querySelector<HTMLElement>("[data-error]");
      if (alert) {
        alert.hidden = true;
        alert.textContent = "";
      }
    }
  }
  if (!customElements.get("remaining-structure-demo")) {
    customElements.define("remaining-structure-demo", RemainingStructureDemo);
  }
</script>
