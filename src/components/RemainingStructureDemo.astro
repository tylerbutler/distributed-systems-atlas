---
import DemoTransportControls from "./DemoTransportControls.astro";
import StationMark from "./StationMark.astro";
import { demoReplicaName, REPLICA_IDS } from "../lib/structure-demo/replicas";
import type { RemainingStructure } from "../lib/structure-demo/remaining-structures";
import "../styles/remaining-structure-demo.css";
import "../styles/structure-demo-shell.css";

interface Props {
  structure: RemainingStructure;
}

const { structure } = Astro.props;
const trailStopChoices = ["Falls", "Marsh", "Ridge", "Lookout"];
const isSharedText = structure.id === "shared-text";
const hasExchange = structure.id === "shared-sequence" || isSharedText;
---

<remaining-structure-demo
  class="structure-demo-root"
  data-testid={`${structure.id}-demo`}
  data-kind={structure.id}
>
  <section class="remaining-demo instrument-panel structure-demo-instrument" aria-labelledby={`${structure.id}-demo-title`}>
    {hasExchange && <div class="remaining-operation-layer structure-demo-operation-layer" data-operation-layer aria-hidden="true"></div>}
    <header>
      <div>
        <h2 id={`${structure.id}-demo-title`}>
          {structure.id === "shared-sequence"
            ? "Edit the inspection route"
            : isSharedText ? "Write the field note together" : `${structure.name} at Eagle Creek`}
        </h2>
        <p>
          {structure.id === "shared-sequence"
            ? "Each hiker can add trail stops to their notebook. Turn off Broadcast to see their routes before insertion notes arrive."
            : isSharedText
              ? "Type in any notebook. Turn off Broadcast to hold edits locally, then turn it on to watch every copy converge."
              : structure.story}
        </p>
      </div>
      <p class="remaining-rule"><span>Merge rule</span><strong>{structure.rule}</strong></p>
    </header>
    <div class:list={["remaining-clients", { "exchange-clients": hasExchange }]}>
      {REPLICA_IDS.map((id, index) => (
        <Fragment>
          <section data-client={id} aria-label={`${demoReplicaName(id)}'s replica`}>
            <header>
              <StationMark station={id} size="lg" />
              <h3>{demoReplicaName(id)}</h3>
              {isSharedText && <output class="remaining-pending-count" data-pending-count>0 pending</output>}
            </header>
            {isSharedText ? (
              <div class="remaining-local-record remaining-text-record">
                <label for={`shared-text-${id}`}>
                  <span>Field note in this notebook</span>
                  <textarea
                    id={`shared-text-${id}`}
                    data-text-editor
                    data-local-record
                    rows="5"
                    spellcheck="false"
                    autocomplete="off"
                    autocapitalize="off"
                    disabled
                  >{structure.initialRecord[id]}</textarea>
                </label>
              </div>
            ) : (
              <p class="remaining-local-record">
                <span>{structure.id === "shared-sequence" ? "Route in this notebook" : structure.recordLabel}</span>
                <strong data-local-record>{structure.initialRecord[id]}</strong>
              </p>
            )}
            <p class="remaining-paper-note">
              <span>{structure.id === "shared-sequence" ? "Latest insertion" : isSharedText ? "Latest local edit" : structure.messageLabel}</span>
              <strong data-client-note>
                {structure.id === "shared-sequence"
                  ? "No trail stop inserted yet."
                  : isSharedText ? "No local edit yet." : structure.local[id]}
              </strong>
              <small data-client-evidence>
                {structure.id === "shared-sequence"
                  ? "Each trail stop gets a unique ID."
                  : isSharedText ? "Edits name written-symbol positions, not raw code units." : structure.evidence[id]}
              </small>
            </p>
            {structure.id === "shared-sequence" ? (
              <form class="remaining-insert-controls" data-sequence-insert aria-label={`Insert a trail stop for ${demoReplicaName(id)}`}>
                <label>Trail stop name
                  <select data-insert-name required disabled>
                    <option value="" selected disabled>Choose a trail stop</option>
                    {trailStopChoices.map((stop) => <option value={stop}>{stop}</option>)}
                  </select>
                </label>
                <label>Position
                  <select data-insert-position disabled>
                    <option value="0">At start</option>
                    {structure.initial.slice(1).map((stop, position) => (
                      <option value={position + 1} data-before={stop} selected={position === 0}>Before {stop} (position {position + 2})</option>
                    ))}
                    <option value={structure.initial.length}>At end</option>
                  </select>
                </label>
                <button type="submit" data-insert-submit disabled>Insert trail stop</button>
              </form>
            ) : !isSharedText && (
              <button type="button" data-client-action disabled>
                Send note
              </button>
            )}
          </section>
          {hasExchange && index === 0 && (
            <section class="remaining-exchange" aria-label={isSharedText ? "Text edit exchange" : "Trail exchange"}>
              <div class="remaining-relay" data-relay-node>
                <h3>{isSharedText ? "Sequencer" : "Trail exchange"}</h3>
                <p>{isSharedText ? "Assigns one shared order to character operations" : "Insertion notes travel to all three hikers"}</p>
                {isSharedText && <output data-sequence-number>SN 0</output>}
                <output data-pending>0 notes waiting</output>
              </div>
              <ol data-note-log aria-label={`${isSharedText ? "Text edit" : "Insertion note"} log, newest first`} aria-live="polite" reversed>
                <li>{isSharedText ? "No text edits yet." : "No insertion notes yet."}</li>
              </ol>
            </section>
          )}
        </Fragment>
      ))}
    </div>
    <section class="remaining-state" aria-label={structure.id === "shared-sequence" ? "Carol's current route" : "Carol's current view"}>
      <span>{structure.id === "shared-sequence" ? "Carol's current route" : "Carol's current view"}</span>
      <ul data-state>{structure.initial.map((item) => <li>{item}</li>)}</ul>
    </section>
    <DemoTransportControls />

    <div class="remaining-controls">
      <div>
        <h3>Run the worked example</h3>
        <p>
          {structure.id === "shared-sequence"
            ? "Queue Alice's Falls and Bob's Marsh together, or insert trail stops from any notebook."
            : isSharedText
              ? "Crowd one position with two words, overlap edits to one word, or type your own changes above."
              : "Queue the hikers' notes together, or reset and send one at a time."}
        </p>
      </div>
      <button type="button" data-action="race" disabled>{structure.raceLabel}</button>
      {isSharedText && <button type="button" data-action="overlap" disabled>Overlap edits to “weir”</button>}
      <button type="button" data-action="reset" disabled>Reset</button>
      <p data-enhancement-note>Enable JavaScript to run the race. The expected result remains in the lesson.</p>
    </div>
    <p role="status" data-status>{`Ready: ${structure.initial.join(" · ")}`}</p>
    <p role="alert" data-error hidden></p>
  </section>
</remaining-structure-demo>

<script>
  import {
    actInRemainingDemo,
    createRemainingDemo,
    deliverRemainingRace,
    editSharedText,
    insertSequenceStop,
    stageRemainingRace,
    type RemainingDemoState,
  } from "../lib/structure-demo/remaining-structure-demo";
  import {
    autoDeliveryChangeEvent,
    DemoTransportControlsElement,
  } from "../lib/structure-demo/demo-transport-controls";
  import { animateDemoOperation } from "../lib/structure-demo/demo-operation-flight";
  import { demoReplicaName, REPLICA_IDS } from "../lib/structure-demo/replicas";
  import { sequenceStopMarks } from "../lib/structure-demo/remaining-structures";

  const graphemeSegmenter = new Intl.Segmenter(undefined, { granularity: "grapheme" });

  function graphemes(value: string): string[] {
    return Array.from(graphemeSegmenter.segment(value), ({ segment }) => segment);
  }

  function minimalTextEdit(before: string, after: string) {
    const oldText = graphemes(before);
    const newText = graphemes(after);
    let start = 0;
    while (start < oldText.length && start < newText.length && oldText[start] === newText[start]) start += 1;
    let oldEnd = oldText.length;
    let newEnd = newText.length;
    while (oldEnd > start && newEnd > start && oldText[oldEnd - 1] === newText[newEnd - 1]) {
      oldEnd -= 1;
      newEnd -= 1;
    }
    if (start === oldEnd && start === newEnd) return null;
    return { start, end: oldEnd, inserted: newText.slice(start, newEnd).join("") };
  }

  class RemainingStructureDemo extends HTMLElement {
    private state!: RemainingDemoState;
    private delivering = false;
    private generation = 0;
    private acted = new Set<string>();
    private exchangeNotes: Array<{
      author: "A" | "B" | "C";
      description: string;
      delivered: boolean;
      sequenceNumber?: number;
    }> = [];
    private markedExampleStops = new Set(["Falls", "Marsh"]);
    private outboundArrivals: Promise<void>[] = [];
    private activeAnimations = new Set<Animation>();

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      const note = this.querySelector("[data-enhancement-note]");
      if (note instanceof HTMLElement) note.hidden = true;
      this.state = createRemainingDemo(this.kind);
      this.querySelectorAll<HTMLFormElement>("[data-sequence-insert]").forEach((form) => {
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          try {
            const client = form.closest<HTMLElement>("[data-client]")?.dataset.client;
            const nameInput = form.querySelector<HTMLSelectElement>("[data-insert-name]");
            const positionInput = form.querySelector<HTMLSelectElement>("[data-insert-position]");
            if ((client !== "A" && client !== "B" && client !== "C") || !nameInput || !positionInput) {
              throw new Error("Missing trail stop controls.");
            }
            const name = nameInput.value.trim();
            if (!name) throw new Error("Enter a trail stop name.");
            const position = Number(positionInput.value);
            const current = this.state.view.replicas.find(({ id }) => id === client);
            if (!current) throw new Error("Missing client route.");
            const place = position === current.values.length
              ? "at the end"
              : `before ${current.values[position]}`;
            this.state = insertSequenceStop(this.state, client, position, name);
            this.markedExampleStops.delete(name);
            const description = `Insert ${name} ${place}`;
            this.exchangeNotes.unshift({ author: client, description, delivered: false });
            this.setSequenceSlip(client, description);
            nameInput.value = "";
            this.clearError();
            const hiker = demoReplicaName(client);
            this.render(`Queued ${hiker}'s insertion note.`);
            this.queueOutbound(client, name);
            if (this.transport.autoDeliver) void this.deliver(form.querySelector<HTMLButtonElement>("button") ?? form);
          } catch (error) {
            this.showError(error);
          }
        });
      });
      this.querySelectorAll<HTMLTextAreaElement>("[data-text-editor]").forEach((editor) => {
        editor.addEventListener("input", () => {
          const client = editor.closest<HTMLElement>("[data-client]")?.dataset.client;
          if (client !== "A" && client !== "B" && client !== "C") {
            this.showError("Missing text editor identity.");
            return;
          }
          try {
            const replica = this.state.view.replicas.find(({ id }) => id === client);
            const before = replica?.values[0];
            if (before === undefined) throw new Error("Missing SharedText value.");
            const edit = minimalTextEdit(before, editor.value);
            if (!edit) return;
            const labels = this.applyCharacterEdit(client, edit.start, edit.end, edit.inserted);
            const count = labels.length;
            this.setTextSlip(
              client,
              `${count} ${count === 1 ? "character operation" : "character operations"} queued`,
            );
            this.clearError();
            this.render(`Queued ${demoReplicaName(client)}'s text edit.`);
            for (const label of labels) this.queueOutbound(client, label);
            if (this.transport.autoDeliver) void this.deliver(editor);
          } catch (error) {
            this.showError(error);
          }
        });
      });
      this.querySelectorAll<HTMLButtonElement>("[data-client-action]").forEach((button) => {
        button.addEventListener("click", () => {
          const client = button.closest<HTMLElement>("[data-client]")?.dataset.client;
          if (client !== "A" && client !== "B" && client !== "C") {
            this.showError("Missing client identity.");
            return;
          }
          try {
            const pendingBefore = this.state.view.pending;
            this.state = actInRemainingDemo(this.state, client);
            this.acted.add(client);
            this.clearError();
            this.render(this.state.view.pending > pendingBefore
              ? `Queued ${client}'s note. The other hikers can still send theirs.`
              : `${client} checked their notebook. No note was sent.`);
            if (this.transport.autoDeliver) void this.deliver(button);
          } catch (error) {
            this.showError(error);
          }
        });
      });
      this.race.addEventListener("click", () => {
        this.resetFlow();
        try {
          if (this.kind === "shared-sequence") {
            this.state = stageRemainingRace(this.state);
            this.acted = new Set(REPLICA_IDS);
            if (this.state.view.pending !== 2) throw new Error("Expected Alice's and Bob's insertion notes");
            this.exchangeNotes = [
              { author: "B", description: "Insert Marsh before Weir", delivered: false },
              { author: "A", description: "Insert Falls before Weir", delivered: false },
            ];
            this.setSequenceSlip("A", "Insert Falls before Weir", "Falls");
            this.setSequenceSlip("B", "Insert Marsh before Weir", "Marsh");
          } else if (this.kind === "shared-text") {
            const aliceLabels = this.applyCharacterEdit("A", 4, 4, "still ");
            const bobLabels = this.applyCharacterEdit("B", 4, 4, "calm ");
            this.setTextSlip("A", "6 character operations queued for “still ”");
            this.setTextSlip("B", "5 character operations queued for “calm ”");
            this.clearError();
            this.render("Eleven concurrent character operations queued.");
            for (const label of aliceLabels) this.queueOutbound("A", label);
            for (const label of bobLabels) this.queueOutbound("B", label);
            if (this.transport.autoDeliver) void this.deliver(this.race);
            return;
          } else {
            this.state = stageRemainingRace(this.state);
            this.acted = new Set(REPLICA_IDS);
          }
          this.clearError();
          this.render("Notes queued for delivery.");
          if (this.kind === "shared-sequence") {
            this.queueOutbound("A", "Falls");
            this.queueOutbound("B", "Marsh");
          }
          if (this.transport.autoDeliver) void this.deliver(this.race);
        } catch (error) {
          this.showError(error);
        }
      });
      this.querySelector<HTMLButtonElement>('[data-action="overlap"]')?.addEventListener("click", (event) => {
        this.resetFlow();
        try {
          const aliceLabels = this.applyCharacterEdit("A", 4, 8, "levee");
          const bobLabels = this.applyCharacterEdit("B", 5, 7, "");
          this.setTextSlip("A", "1 deletion and 5 character insertions queued");
          this.setTextSlip("B", "1 deletion queued");
          this.clearError();
          this.render("Seven overlapping character operations queued.");
          for (const label of aliceLabels) this.queueOutbound("A", label);
          for (const label of bobLabels) this.queueOutbound("B", label);
          if (this.transport.autoDeliver) void this.deliver(event.currentTarget as HTMLButtonElement);
        } catch (error) {
          this.showError(error);
        }
      });
      this.querySelector('[data-action="reset"]')?.addEventListener("click", (event) => {
        this.resetFlow();
        this.clearError();
        this.render();
        (event.currentTarget as HTMLButtonElement).focus();
      });
      this.transport.addEventListener(autoDeliveryChangeEvent, () => {
        if (this.transport.autoDeliver && this.state.view.pending > 0) {
          void this.deliver(this.transport);
        }
      });
      this.render();
    }

    private get kind(): RemainingDemoState["kind"] {
      const kind = this.dataset.kind;
      if (
        kind === "shared-sequence"
        || kind === "shared-text"
        || kind === "claims"
        || kind === "ordered-collection"
        || kind === "task-manager"
        || kind === "pact-map"
        || kind === "json-ot"
        || kind === "shared-rich-text"
      ) return kind;
      throw new Error("Missing remaining demo kind");
    }

    private get race(): HTMLButtonElement {
      const button = this.querySelector<HTMLButtonElement>('[data-action="race"]');
      if (!button) throw new Error("Missing remaining demo race control");
      return button;
    }

    private get transport(): DemoTransportControlsElement {
      const controls = this.querySelector<DemoTransportControlsElement>(
        "demo-transport-controls",
      );
      if (!controls) throw new Error("Missing remaining demo transport controls");
      return controls;
    }

    private async deliver(focus: HTMLElement): Promise<void> {
      if (this.delivering || this.state.view.pending === 0) return;
      this.delivering = true;
      this.renderControls();
      const generation = this.generation;
      try {
        if (this.kind === "shared-sequence" || this.kind === "shared-text") {
          const relay = this.querySelector<HTMLElement>("[data-relay-node]");
          if (!relay) throw new Error("Missing exchange relay");
          const broadcastNotes = new Set<(typeof this.exchangeNotes)[number]>();
          while (true) {
            await Promise.all(this.outboundArrivals.splice(0));
            if (generation !== this.generation) return;
            const pendingNotes = [...this.exchangeNotes].reverse().filter(
              (note) => !note.delivered && !broadcastNotes.has(note),
            );
            for (const note of pendingNotes) broadcastNotes.add(note);
            await Promise.all(pendingNotes.flatMap((note) =>
              REPLICA_IDS.map((id) => {
                const recipient = this.querySelector<HTMLElement>(`[data-client="${id}"]`);
                if (!recipient) throw new Error(`Missing ${id} notebook`);
                return this.animateHop(
                  relay,
                  recipient,
                  `${demoReplicaName(note.author)} note`,
                  "shared",
                );
              })
            ));
            if (generation !== this.generation) return;
            if (this.outboundArrivals.length === 0) break;
          }
        } else {
          await new Promise((resolve) =>
            window.setTimeout(resolve, this.transport.nextDuration(800))
          );
        }
        if (generation !== this.generation) return;
        const sequenceNumber = this.state.view.sequenceNumber;
        this.state = deliverRemainingRace(this.state);
        if (this.kind === "shared-sequence" || this.kind === "shared-text") {
          let nextSequenceNumber = sequenceNumber;
          for (const note of [...this.exchangeNotes].reverse()) {
            if (note.delivered) continue;
            note.delivered = true;
            if (this.kind === "shared-text") {
              nextSequenceNumber += 1;
              note.sequenceNumber = nextSequenceNumber;
            }
          }
        }
        this.clearError();
        this.render(
          this.state.view.pending > 0
            ? "Some notes still await delivery."
            : this.kind === "shared-text"
              ? `Sequenced through SN ${this.state.view.sequenceNumber}.`
              : "Delivery complete.",
        );
        focus.focus();
      } catch (error) {
        this.showError(error);
      } finally {
        if (generation !== this.generation) return;
        this.delivering = false;
        this.renderControls();
        if (this.transport.autoDeliver && this.state.view.pending > 0) {
          void this.deliver(focus);
        }
      }
    }

    private queueOutbound(client: "A" | "B" | "C", label: string): void {
      const from = this.querySelector<HTMLElement>(`[data-client="${client}"]`);
      const relay = this.querySelector<HTMLElement>("[data-relay-node]");
      if (!from || !relay) throw new Error("Missing edit route");
      this.outboundArrivals.push(this.animateHop(from, relay, label, "outbound"));
    }

    private async animateHop(
      from: HTMLElement,
      to: HTMLElement,
      label: string,
      leg: "outbound" | "shared",
    ): Promise<void> {
      const layer = this.querySelector<HTMLElement>("[data-operation-layer]");
      if (!layer) throw new Error("Missing insertion animation layer");
      await animateDemoOperation({
        activeAnimations: this.activeAnimations,
        className: "remaining-operation-pulse",
        duration: this.transport.nextDuration(650),
        easing: "linear",
        from,
        label,
        labelClassName: "remaining-operation-label",
        layer,
        leg,
        to,
      });
    }

    private resetFlow(): void {
      this.generation += 1;
      this.delivering = false;
      this.acted.clear();
      this.exchangeNotes = [];
      this.markedExampleStops = new Set(["Falls", "Marsh"]);
      this.outboundArrivals = [];
      for (const animation of this.activeAnimations) animation.cancel();
      this.activeAnimations.clear();
      this.querySelector<HTMLElement>("[data-operation-layer]")?.replaceChildren();
      this.state = createRemainingDemo(this.kind);
      if (this.kind === "shared-sequence") {
        for (const id of REPLICA_IDS) this.setSequenceSlip(id, "No trail stop inserted yet.");
      } else if (this.kind === "shared-text") {
        for (const id of REPLICA_IDS) this.setTextSlip(id, "No local edit yet.");
      }
    }

    private render(statusText?: string): void {
      const shared = this.state.view.replicas.find(({ id }) => id === "C")
        ?? this.state.view.replicas[0];
      this.renderValues(
        this.querySelector<HTMLElement>("[data-state]"),
        shared?.values ?? [],
      );
      for (const replica of this.state.view.replicas) {
        const record = this.querySelector<HTMLElement>(
          `[data-client="${replica.id}"] [data-local-record]`,
        );
        if (record) {
          if (this.kind === "shared-sequence") {
            const nodes: Node[] = [];
            for (const [index, value] of replica.values.entries()) {
              if (index) nodes.push(document.createTextNode(" · "));
              nodes.push(this.sequenceValue(value));
            }
            record.replaceChildren(...nodes);
          } else if (this.kind === "shared-text" && record instanceof HTMLTextAreaElement) {
            if (record.value !== (replica.values[0] ?? "")) {
              const focused = document.activeElement === record;
              const start = record.selectionStart;
              const end = record.selectionEnd;
              record.value = replica.values[0] ?? "";
              if (focused) record.setSelectionRange(start, end);
            }
          } else {
            record.textContent = replica.values.join(" · ");
          }
        }
        if (this.kind === "shared-sequence") this.renderSequencePositions(replica.id, replica.values);
      }
      this.renderExchangeNotes();
      this.dataset.kernelSequence = String(this.state.view.sequenceNumber);
      const status = this.querySelector<HTMLElement>("[data-status]");
      if (status) {
        status.textContent = statusText
          ?? `Ready: ${(shared?.values ?? []).join(" · ")}`;
      }
      this.renderControls();
    }

    private renderExchangeNotes(): void {
      if (this.kind !== "shared-sequence" && this.kind !== "shared-text") return;
      const pending = this.querySelector<HTMLOutputElement>("[data-pending]");
      const log = this.querySelector<HTMLOListElement>("[data-note-log]");
      if (!pending || !log) throw new Error("Missing edit exchange");
      const count = this.state.view.pending;
      const noun = this.kind === "shared-text" ? "edit" : "note";
      pending.textContent = `${count} ${count === 1 ? noun : `${noun}s`} waiting`;
      const sequence = this.querySelector<HTMLOutputElement>("[data-sequence-number]");
      if (sequence) sequence.textContent = `SN ${this.state.view.sequenceNumber}`;
      log.replaceChildren(...(this.exchangeNotes.length
        ? this.exchangeNotes.map((note) => {
          const item = document.createElement("li");
          const name = demoReplicaName(note.author);
          const stamp = note.sequenceNumber === undefined ? "" : `SN ${note.sequenceNumber} · `;
          item.textContent = `${stamp}${name}: ${note.description} — ${note.delivered ? "delivered" : "waiting"}`;
          return item;
        })
        : [Object.assign(document.createElement("li"), {
          textContent: this.kind === "shared-text" ? "No text edits yet." : "No insertion notes yet.",
        })]));
      if (this.kind === "shared-text") {
        for (const id of REPLICA_IDS) {
          const authored = this.exchangeNotes.filter((note) => note.author === id && !note.delivered).length;
          const output = this.querySelector<HTMLOutputElement>(`[data-client="${id}"] [data-pending-count]`);
          if (output) output.textContent = `${authored} pending`;
        }
      }
    }

    private renderSequencePositions(client: string, values: string[]): void {
      const select = this.querySelector<HTMLSelectElement>(`[data-client="${client}"] [data-insert-position]`);
      if (!select) throw new Error(`Missing ${client} insertion position`);
      const selected = select.value || "1";
      const selectedOption = select.selectedOptions[0];
      const selectedStop = selectedOption?.dataset.before;
      const atEnd = selectedOption?.textContent === "At end";
      const options = values.map((value, index) => {
        const option = new Option(index === 0 ? "At start" : `Before ${value} (position ${index + 1})`, String(index));
        if (index > 0) option.dataset.before = value;
        return option;
      });
      options.push(new Option("At end", String(values.length)));
      select.replaceChildren(...options);
      const matching = options.filter((option) => option.dataset.before === selectedStop);
      select.value = atEnd
        ? String(values.length)
        : selectedStop && matching.length === 1
          ? matching[0].value
          : options.some(({ value }) => value === selected) ? selected : String(values.length);
    }

    private setSequenceSlip(client: "A" | "B" | "C", description: string, example?: "Falls" | "Marsh"): void {
      const note = this.querySelector<HTMLElement>(`[data-client="${client}"] [data-client-note]`);
      const evidence = this.querySelector<HTMLElement>(`[data-client="${client}"] [data-client-evidence]`);
      if (!note || !evidence) throw new Error(`Missing ${client} insertion slip`);
      note.textContent = description;
      evidence.replaceChildren(...(example
        ? ["Trail stop ID: ", this.sequenceValue(example)]
        : ["Each trail stop gets a unique ID."]));
    }

    private setTextSlip(client: "A" | "B" | "C", description: string): void {
      const note = this.querySelector<HTMLElement>(`[data-client="${client}"] [data-client-note]`);
      if (!note) throw new Error(`Missing ${client} text edit note`);
      note.textContent = description;
    }

    private applyCharacterEdit(
      client: "A" | "B" | "C",
      start: number,
      end: number,
      inserted: string,
    ): string[] {
      const labels: string[] = [];
      if (end > start) {
        this.state = editSharedText(this.state, client, start, end, "");
        const description = `Delete symbols ${start}–${end}`;
        this.exchangeNotes.unshift({ author: client, description, delivered: false });
        labels.push("delete");
      }
      for (const [offset, character] of graphemes(inserted).entries()) {
        const index = start + offset;
        this.state = editSharedText(this.state, client, index, index, character);
        const visible = character === " " ? "space" : character;
        const description = `Insert “${visible}” at symbol ${index}`;
        this.exchangeNotes.unshift({ author: client, description, delivered: false });
        labels.push(visible);
      }
      return labels;
    }

    private renderValues(target: HTMLElement | null, values: string[]): void {
      if (!target) throw new Error("Missing remaining demo state");
      target.replaceChildren(...values.map((value) => {
        const item = document.createElement("li");
        item.append(this.kind === "shared-sequence" ? this.sequenceValue(value) : value);
        return item;
      }));
    }

    private sequenceValue(value: string): Node {
      const mark = !this.markedExampleStops.has(value) ? null : value === "Falls"
        ? sequenceStopMarks.Falls
        : value === "Marsh" ? sequenceStopMarks.Marsh : null;
      if (!mark) return document.createTextNode(value);
      const labeled = document.createElement("span");
      labeled.className = "dotted-value";
      labeled.textContent = value;
      const sup = document.createElement("sup");
      sup.textContent = mark;
      labeled.append(sup);
      return labeled;
    }

    private renderControls(): void {
      this.querySelectorAll<HTMLSelectElement | HTMLButtonElement>(
        "[data-insert-name], [data-insert-position], [data-insert-submit]",
      ).forEach((control) => { control.disabled = false; });
      this.querySelectorAll<HTMLTextAreaElement>("[data-text-editor]").forEach((editor) => {
        editor.disabled = false;
      });
      for (const button of this.querySelectorAll<HTMLButtonElement>(
        "[data-client-action]",
      )) {
        const client = button.closest<HTMLElement>("[data-client]")?.dataset.client;
        button.disabled = client ? this.acted.has(client) : true;
      }
      this.race.disabled = this.kind === "shared-sequence" || this.kind === "shared-text"
        ? false
        : this.delivering;
      const overlap = this.querySelector<HTMLButtonElement>('[data-action="overlap"]');
      if (overlap) overlap.disabled = this.delivering;
      const reset = this.querySelector<HTMLButtonElement>('[data-action="reset"]');
      if (reset) reset.disabled = false;
    }

    private showError(error: unknown): void {
      const message = error instanceof Error ? error.message : String(error);
      const alert = this.querySelector<HTMLElement>("[data-error]");
      if (alert) {
        alert.hidden = false;
        alert.textContent = `The change failed: ${message}`;
      }
      const status = this.querySelector<HTMLElement>("[data-status]");
      if (status) status.textContent = "The last valid kernel state is unchanged.";
      this.renderControls();
    }

    private clearError(): void {
      const alert = this.querySelector<HTMLElement>("[data-error]");
      if (alert) {
        alert.hidden = true;
        alert.textContent = "";
      }
    }
  }
  if (!customElements.get("remaining-structure-demo")) {
    customElements.define("remaining-structure-demo", RemainingStructureDemo);
  }
</script>
