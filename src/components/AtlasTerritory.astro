---
import type { SheetMeta, Territory } from "../lib/atlas/graph";

interface Props {
  id: Territory;
  title: string;
  summary: string;
  sheets: (Pick<SheetMeta, "id" | "title" | "summary" | "status"> & {
    prerequisiteTitles: string[];
  })[];
}

const { id, title, summary, sheets } = Astro.props;
---

<section class="atlas-territory" id={id} aria-labelledby={`${id}-title`} data-testid={`territory-${id}`}>
  <header class="territory-index">
    <h2 id={`${id}-title`}>{title}</h2>
    <p>{summary}</p>
  </header>
  <div class="territory-field">
    <span class="territory-connector" aria-hidden="true"></span>
    {sheets.length > 0
      ? <ul class="territory-stations" aria-label={`${title} sheets`}>
          {sheets.map((sheet, index) => (
            <li class:list={["territory-station", { published: sheet.status === "published" }]}>
              {index > 0 && <span class="station-trace" aria-hidden="true"></span>}
              <span class="station-stop" aria-hidden="true"></span>
              <h3>
                {sheet.status === "published"
                  ? <a href={`/atlas/${sheet.id}/`}>{sheet.title}</a>
                  : sheet.title}
              </h3>
              <span class="status">{sheet.status === "published" ? "Read now" : "Planned"}</span>
              {sheet.summary && <p class="station-summary">{sheet.summary}</p>}
              {sheet.prerequisiteTitles.length > 0 && (
                <p class="incoming-label">Requires: {sheet.prerequisiteTitles.join(", ")}</p>
              )}
            </li>
          ))}
        </ul>
      : <p class="territory-empty">No sheets here yet.</p>}
  </div>
</section>

<style>
  .atlas-territory {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    padding-block: var(--space-6);
    border-top: var(--rule-width) solid var(--line);
    scroll-margin-top: var(--space-5);
  }

  .territory-index {
    padding-right: var(--space-6);
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-size: 1.75rem;
  }

  .territory-index p {
    margin: 0;
    font-size: 1rem;
  }

  .territory-field {
    position: relative;
    min-width: 0;
    padding-left: 2rem;
  }

  .territory-connector {
    position: absolute;
    top: -1rem;
    left: 0;
    width: 2rem;
    height: 1rem;
    border-left: var(--rule-width) solid var(--instrument);
    border-bottom: var(--rule-width) solid var(--instrument);
    border-bottom-left-radius: 1rem;
  }

  .territory-stations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    row-gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .territory-station {
    position: relative;
    padding: var(--space-5) var(--space-5) 0 0;
    border-top: var(--rule-width) solid var(--instrument);
  }

  .station-stop {
    position: absolute;
    top: -0.375rem;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    border: var(--rule-signal) solid var(--instrument);
    border-radius: 50%;
    background: var(--sky-sheet);
  }

  .station-trace {
    position: absolute;
    top: -1px;
    left: -2rem;
    width: 2rem;
    border-top: var(--rule-width) solid var(--instrument);
  }

  .published .station-stop {
    background: var(--signal);
  }

  h3 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
    text-wrap: auto;
  }

  h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .station-summary {
    margin: var(--space-3) 0 0;
    font-size: 1rem;
  }

  .incoming-label {
    margin: var(--space-4) 0 0;
    color: var(--muted);
    font: 0.875rem / 1.5 var(--font-ui);
  }

  .territory-empty {
    margin: 0;
    padding-top: var(--space-5);
    border-top: var(--rule-width) solid var(--line);
    color: var(--muted);
    font-family: var(--font-ui);
  }

  @media (width <= 64rem) {
    .atlas-territory {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .territory-index {
      padding-inline: 2rem 0;
    }
  }

  @media (width < 40rem) {
    .territory-index {
      padding: 0;
    }

    .territory-field {
      padding: 0;
    }

    .territory-connector,
    .station-trace {
      display: none;
    }

    .territory-stations {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .territory-station {
      margin-left: 0.375rem;
      padding: 0 0 var(--space-5) var(--space-5);
      border-top: 0;
      border-left: var(--rule-width) solid var(--line);
    }

    .territory-station:last-child {
      padding-bottom: 0;
      border-left-color: transparent;
    }

    .station-stop {
      top: 0.5rem;
      left: -0.375rem;
    }

    .territory-empty {
      padding: 0;
      border: 0;
    }
  }
</style>
