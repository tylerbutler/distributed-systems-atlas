---
import type { SheetMeta, Territory } from "../lib/atlas/graph";
import ComplexityBadge from "./ComplexityBadge.astro";

interface Props {
  id: Territory;
  title: string;
  summary: string;
  sheets: (Pick<SheetMeta, "id" | "title" | "summary" | "complexity"> & {
    prerequisites: Pick<SheetMeta, "id" | "title" | "status">[];
    lessons: { title: string; href: string }[];
  })[];
}

const { id, title, summary, sheets } = Astro.props;
---

<section class:list={["atlas-territory", { "systems-surface": id === "systems" }]} id={id} aria-labelledby={`${id}-title`} tabindex="-1" data-testid={`territory-${id}`}>
  <header class="territory-index">
    <h2 id={`${id}-title`}>{title}</h2>
    {id === "systems" && <p class="systems-context">Inside the Atlas</p>}
    <p>{summary}</p>
  </header>
  <ul class="territory-articles" aria-label={`${title} articles`}>
    {sheets.map((sheet) => (
      <li class="reference-article">
        <div class="article-heading">
          <h3><a href={`/atlas/${sheet.id}/`}>{sheet.title}</a></h3>
          <ComplexityBadge complexity={sheet.complexity} />
        </div>
        <p class="article-summary">{sheet.summary}</p>
        {sheet.prerequisites.length > 0 && (
          <p class="article-links">
            <span>Helpful background:</span>{" "}
            {sheet.prerequisites.map((reference, index) => (
              <>{index > 0 && ", "}{reference.status === "published"
                ? <a href={`/atlas/${reference.id}/`}>{reference.title}</a>
                : <>{reference.title} <span class="status">Planned</span></>}</>
            ))}
          </p>
        )}
        {sheet.lessons.length > 0 && (
          sheet.lessons.length > 3
            ? <details class="article-lessons">
                <summary>Structure lessons ({sheet.lessons.length})</summary>
                <p class="article-links">
                  {sheet.lessons.map((lesson, index) => (
                    <>{index > 0 && ", "}<a href={lesson.href}>{lesson.title}</a></>
                  ))}
                </p>
              </details>
            : <p class="article-links">
                <span>Structure lessons:</span>{" "}
                {sheet.lessons.map((lesson, index) => (
                  <>{index > 0 && ", "}<a href={lesson.href}>{lesson.title}</a></>
                ))}
              </p>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .atlas-territory {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-top: var(--rule-width) solid var(--line);
    scroll-margin-top: var(--space-5);
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-size: 1.75rem;
  }

  .territory-index p {
    margin: 0;
    font-size: 1rem;
  }

  .territory-articles {
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reference-article {
    padding-block: var(--space-5);
    border-top: var(--rule-width) solid var(--line);
  }

  .reference-article:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .reference-article:last-child {
    padding-bottom: 0;
  }

  .article-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  h3 {
    flex: 1 1 16rem;
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.3;
    text-wrap: auto;
  }

  h3 a,
  .article-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .article-summary {
    margin: var(--space-2) 0 0;
    font-size: 1rem;
  }

  .article-links,
  .article-lessons {
    margin: var(--space-2) 0 0;
    font: 0.9375rem / 1.5 var(--font-ui);
  }

  .article-links > span:first-child,
  .article-lessons summary {
    color: var(--muted);
  }

  .article-lessons summary {
    width: fit-content;
    min-height: 44px;
    align-content: center;
    cursor: pointer;
  }

  @media (width <= 64rem) {
    .atlas-territory {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
