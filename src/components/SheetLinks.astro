---
import type { SheetMeta } from "../lib/atlas/graph";

interface Props {
  heading: string;
  sheets: Pick<SheetMeta, "id" | "title" | "status">[];
  emptyText?: string;
}

const { heading, sheets, emptyText } = Astro.props;
---

{(sheets.length > 0 || emptyText) && (
  <nav class="sheet-links" aria-label={heading}>
    <h2>{heading}</h2>
    {sheets.length > 0 ? <ul>
      {sheets.map((sheet) => (
        <li>
          {sheet.status === "published"
            ? <a href={`/atlas/${sheet.id}/`}>{sheet.title}</a>
            : <><span>{sheet.title}</span> <span class="status">Planned</span></>}
        </li>
      ))}
    </ul> : <p class="sheet-empty">{emptyText}</p>}
  </nav>
)}
