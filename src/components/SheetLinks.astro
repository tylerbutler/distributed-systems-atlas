---
import type { SheetMeta } from "../lib/atlas/graph";

interface Props {
  heading: string;
  sheets: Pick<SheetMeta, "id" | "title" | "status" | "summary">[];
  emptyText?: string;
  showSummaries?: boolean;
}

const { heading, sheets, emptyText, showSummaries = false } = Astro.props;
---

{(sheets.length > 0 || emptyText) && (
  <nav class="sheet-links" aria-label={heading}>
    <h2>{heading}</h2>
    {sheets.length > 0 ? <ul>
      {sheets.map((sheet) => (
        <li>
          {sheet.status === "published"
            ? <a href={`/atlas/${sheet.id}/`}>{sheet.title}</a>
            : <><span>{sheet.title}</span> <span class="status">Planned</span></>}
          {showSummaries && <p class="sheet-link-summary">{sheet.summary}</p>}
        </li>
      ))}
    </ul> : <p class="sheet-empty">{emptyText}</p>}
  </nav>
)}

<style>
  .sheet-link-summary {
    margin: 0 0 var(--space-4);
    font-family: var(--font-reading);
  }

  .sheet-links:has(.sheet-link-summary) a {
    min-height: 44px;
    align-content: center;
  }
</style>
