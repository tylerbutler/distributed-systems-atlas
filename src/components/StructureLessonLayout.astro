---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ComplexityBadge from "./ComplexityBadge.astro";
import LessonIllustration from "./LessonIllustration.astro";
import SheetLinks from "./SheetLinks.astro";
import StructureNext from "./StructureNext.astro";
import { structureComplexity } from "../lib/learning-complexity";

interface Props {
  articleClass: string;
  description: string;
  illustrationId: string;
  territoryLabel?: string;
  title: string;
}

const {
  articleClass,
  description,
  illustrationId,
  territoryLabel = "Structures",
  title,
} = Astro.props;
const complexity = structureComplexity(Astro.url.pathname);
const slug = Astro.url.pathname.split("/").filter(Boolean).at(-1);
const referenceSheets = (await getCollection("sheet", ({ data }) =>
  data.status === "published" && data.structureLessons.some((lesson) => lesson === slug),
)).map(({ id, data }) => ({ id, ...data }))
  .sort((a, b) => a.title.localeCompare(b.title, "en"));
---

<BaseLayout
  title={title}
  description={description}
  territory="Structures"
  sheetTitle={title}
>
  <article class={articleClass}>
    <header class="page-intro">
      <div class="lesson-meta">
        <p class="territory-label">{territoryLabel}</p>
        <ComplexityBadge {complexity} />
      </div>
      <h1>{title}</h1>
      <p class="structure-summary"><slot name="summary" /></p>
      <slot name="navigation" />
      <LessonIllustration id={illustrationId} />
    </header>

    <slot />
    <div class="structure-references">
      <SheetLinks heading="Related reference sheets" sheets={referenceSheets} showSummaries />
    </div>
    <StructureNext />
  </article>
</BaseLayout>

<style>
  article {
    max-width: var(--measure-reading);
    margin-inline: auto;
  }

  article > :global(section) {
    margin-top: var(--space-7);
  }

  .structure-summary {
    font-size: 1.2rem;
  }

  .structure-references:has(nav) {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: var(--rule-width) solid var(--line);
  }

  .lesson-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
  }

  .lesson-meta p {
    margin: 0;
  }
</style>
