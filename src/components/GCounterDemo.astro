---
import StationMark from "./StationMark.astro";
import {
  createGCounterDemo,
  gCounterUserName,
  presentGCounterDemo,
} from "../lib/structure-demo/g-counter";

const initial = presentGCounterDemo(createGCounterDemo());
---

<g-counter-demo data-testid="g-counter-demo">
  <section class="gcounter-instrument" aria-labelledby="gcounter-demo-title">
    <div class="operation-layer" data-operation-layer aria-hidden="true"></div>
    <header class="gcounter-heading">
      <div>
        <h2 id="gcounter-demo-title">Let each user count</h2>
        <p>
          Add for Alice, Bob, or Carol and the sequencer delivers the operation
          automatically. Turn off Auto-deliver when you want to build a queue.
        </p>
      </div>
      <p class="merge-rule">
        Merge rule
        <strong>Keep the largest count reported by each client.</strong>
      </p>
    </header>

    <div class="operation-key" aria-label="Operation states">
      <p>
        <span class="operation-key-mark outbound" aria-hidden="true"></span>
        <span><strong>Unsequenced</strong> Client report traveling in</span>
      </p>
      <p>
        <span class="operation-key-mark sequenced" aria-hidden="true"></span>
        <span><strong>Sequenced</strong> Numbered broadcast traveling out</span>
      </p>
    </div>

    <div class="gcounter-network">
      {initial.replicas.map((replica) => (
        <section
          class={`gcounter-replica replica-${replica.id.toLowerCase()}`}
          data-client={replica.id}
          aria-label={`${gCounterUserName(replica.id)}'s replica`}
        >
          <header>
            <StationMark station={replica.id} size="lg" />
            <div>
              <h3>{gCounterUserName(replica.id)}</h3>
              <p data-replica-state={replica.id}>Connected to sequencer</p>
            </div>
          </header>
          <output class="gcounter-total observation-data" data-total={replica.id}>
            {replica.value}
          </output>
          <p>Total increments observed</p>
          <div class="replica-actions" aria-label={`Increment for ${gCounterUserName(replica.id)}`}>
            {[1, 3, 7].map((amount) => (
              <button
                type="button"
                data-replica={replica.id}
                data-increment={amount}
                aria-label={`Add ${amount} for ${gCounterUserName(replica.id)}`}
                disabled
              >
                +{amount}
              </button>
            ))}
          </div>
        </section>
      ))}

      <div class="sequencer-channel">
        <section class="sequencer-station" data-sequencer-node aria-label="Sequencer">
          <span class="sequencer-label">Sequencer</span>
          <output class="sequencer-counter" data-sequence-counter aria-label="Latest sequence number">
            SN 0
          </output>
        </section>
        <ol class="operation-log" data-deliveries aria-label="Operation log">
          <li>No operation delivered yet.</li>
        </ol>
      </div>
    </div>

    <section class="gcounter-controls" aria-label="Lesson controls">
      <label class="playback-speed">
        <span>Speed</span>
        <input
          type="range"
          min="0.25"
          max="2"
          step="0.25"
          value="1"
          data-pace
          title="Change playback speed without changing sequencer ordering."
          disabled
        />
        <output data-pace-output>1×</output>
      </label>
      <label class="auto-deliver-toggle">
        <input type="checkbox" data-auto-deliver checked disabled />
        <span>Auto-deliver</span>
      </label>
      <button type="button" data-action="race" disabled>
        Run Alice +7 and Bob +3 race
      </button>
      <button type="button" data-action="resend" disabled>
        Resend latest user's count
      </button>
      <button type="button" data-action="reset" disabled>Reset</button>
      <label class="guided-toggle">
        <input
          type="checkbox"
          data-guided-observations
          aria-controls="guided-observations"
          disabled
        />
        <span>Guided observations</span>
      </label>
      <p data-enhancement-note>
        Enable JavaScript to run the demo. The initial values and expected
        result remain available in the article.
      </p>
    </section>

    <p class="gcounter-result" role="status" aria-live="polite" aria-atomic="true">
      {initial.result}
    </p>
    <p class="gcounter-error" role="alert" hidden></p>

    <aside
      class="guided-observations"
      id="guided-observations"
      data-guided-panel
      hidden
    >
      <div>
        <h3>Inside the sequencer</h3>
        <p>
          Sluice is the in-memory server behind this demo. It accepts
          operations from the clients, puts them in one total order, and
          relays them to every connected replica.
        </p>
        <p>
          Some data structures use the sequence number in their conflict rule.
          The G-counter does not, but it still needs the relay so every replica
          receives each client's latest count. Peers could exchange operations
          directly instead; a server sequencer provides one transport for many
          kinds of data structure.
        </p>
      </div>
      <p class="guided-callout" data-guided-callout aria-live="polite">
        Turn off Auto-deliver to queue several operations before delivery.
      </p>
    </aside>

    <details class="gcounter-explanation">
      <summary>Explain why resending a user's count is safe</summary>
      <div>
        <p>
          Each client stores the largest count it has observed for Alice, Bob,
          and Carol. The sequencer orders and broadcasts each operation; the
          G-counter kernel keeps the largest count reported by each user.
        </p>
        <table aria-label="Reported counts by user">
          <thead>
            <tr>
              <th scope="col">User</th>
              <th scope="col">At Alice</th>
              <th scope="col">At Bob</th>
              <th scope="col">At Carol</th>
            </tr>
          </thead>
          <tbody>
            {(["A", "B", "C"] as const).map((user) => (
              <tr>
                <th scope="row">{gCounterUserName(user)}</th>
                {(["A", "B", "C"] as const).map((replica) => (
                  <td class="observation-data" data-user-count={`${replica}-${user}`}>0</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
        <p>
          Resend submits the latest user's current count again as a zero
          increment. The transport assigns a new sequence number, but every
          kernel compares the same cumulative count with itself. The maximum
          does not change.
        </p>
      </div>
    </details>
  </section>
</g-counter-demo>

<script>
  import "../lib/structure-demo/g-counter-element";
</script>

<style>
  g-counter-demo {
    display: block;
    width: min(calc(100vw - 2rem), var(--content));
    max-width: none;
    margin-block: var(--space-7);
    margin-inline: 50%;
    font-variant-numeric: tabular-nums;
    transform: translateX(-50%);
  }

  .gcounter-instrument {
    position: relative;
    padding: clamp(1rem, 3vw, 2rem);
    border: var(--rule-width) solid var(--instrument-deep);
    color: var(--clear);
    background: var(--instrument);
    --focus-color: var(--signal);
    --link-color: var(--clear);
  }

  .operation-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  :global(.operation-pulse) {
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    border: var(--rule-width) solid var(--instrument-deep);
    border-radius: 50%;
  }

  :global(.operation-pulse.outbound) {
    border-color: var(--signal);
    background: var(--signal);
  }

  :global(.operation-pulse.sequenced) {
    border-color: var(--clear);
    color: var(--instrument-deep);
    background: var(--clear);
  }

  :global(.operation-pulse-label) {
    position: absolute;
    bottom: calc(100% + var(--space-1));
    left: 50%;
    padding: 0.15rem 0.3rem;
    color: var(--instrument-deep);
    background: var(--signal);
    font-family: var(--font-data);
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  :global(.operation-pulse.sequenced .operation-pulse-label) {
    color: var(--instrument-deep);
    background: var(--clear);
  }

  .operation-key {
    display: flex;
    gap: var(--space-5);
    padding-block: var(--space-3);
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .operation-key p {
    display: flex;
    margin: 0;
    align-items: center;
    gap: var(--space-2);
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  .operation-key strong {
    display: block;
    color: var(--clear);
  }

  .operation-key-mark {
    width: 12px;
    height: 12px;
    border: var(--rule-width) solid var(--signal);
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .operation-key-mark.outbound {
    background: var(--signal);
  }

  .operation-key-mark.sequenced {
    border-color: var(--clear);
    background: var(--clear);
  }

  .gcounter-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
    gap: var(--space-6);
    align-items: end;
    padding-bottom: var(--space-5);
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .gcounter-heading h2,
  .gcounter-heading p,
  .gcounter-replica h3,
  .gcounter-replica p {
    margin: 0;
  }

  .gcounter-heading p {
    margin-top: var(--space-3);
  }

  .merge-rule {
    padding: var(--space-4);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 45%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }

  .merge-rule strong {
    display: block;
    margin-top: var(--space-2);
    color: var(--signal);
    font-size: 1.05rem;
  }

  .gcounter-network {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8rem, 0.45fr) minmax(0, 1fr);
    grid-template-areas:
      "a sequencer b"
      "c c c";
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: start;
    padding-block: var(--space-6);
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .gcounter-replica {
    min-width: 0;
    padding: var(--space-5);
    border: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
    background: color-mix(in oklch, var(--clear) 3%, var(--instrument));
  }

  .replica-a {
    grid-area: a;
  }

  .replica-b {
    grid-area: b;
  }

  .replica-c {
    grid-area: c;
    justify-self: center;
    width: min(100%, 24rem);
  }

  .gcounter-replica header {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .gcounter-replica h3 {
    font-size: 1.15rem;
  }

  .gcounter-replica header p,
  .gcounter-total + p {
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.825rem;
  }

  .gcounter-replica header p {
    font-size: 0.75rem;
  }

  .gcounter-total {
    display: block;
    margin-top: var(--space-4);
    color: var(--signal);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 650;
    line-height: 0.95;
  }

  .gcounter-total + p {
    margin-top: var(--space-2);
  }

  .replica-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .replica-actions button {
    padding-inline: var(--space-2);
    white-space: nowrap;
  }

  .sequencer-channel {
    grid-area: sequencer;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-top: clamp(var(--space-4), 4vw, var(--space-6));
  }

  .sequencer-station {
    display: flex;
    width: fit-content;
    padding: var(--space-3) var(--space-5);
    border: var(--rule-width) solid var(--clear);
    border-radius: 999px;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    background: var(--instrument);
    text-align: center;
  }

  .sequencer-label {
    margin: 0;
    color: var(--signal);
    font-family: var(--font-ui);
    font-size: 1.15rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .sequencer-counter {
    color: var(--clear);
    font-family: var(--font-data);
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }

  .sequencer-counter.stamped {
    animation: sequencer-stamp 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes sequencer-stamp {
    from {
      color: var(--signal);
      transform: scale(1.12);
    }
  }

  .operation-log {
    display: flex;
    width: min(100%, 12rem);
    max-height: 8rem;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    mask-image: linear-gradient(black 58%, transparent 100%);
  }

  .operation-log :global(li) {
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-data);
    font-size: 0.68rem;
    line-height: 1.45;
    text-align: center;
  }

  .playback-speed {
    display: grid;
    grid-area: speed;
    grid-template-columns: 1fr auto;
    gap: var(--space-2) var(--space-3);
    align-items: center;
    min-width: 0;
    font-family: var(--font-ui);
  }

  .playback-speed input {
    grid-column: 1;
    width: 100%;
    accent-color: var(--signal);
  }

  .playback-speed output {
    grid-column: 2;
    grid-row: 1 / 3;
    color: var(--signal);
    font-family: var(--font-data);
  }

  .gcounter-controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      "speed auto guided"
      "race resend reset";
    gap: var(--space-3);
    align-items: end;
    padding-block: var(--space-5);
  }

  .guided-toggle {
    display: flex;
    grid-area: guided;
    width: fit-content;
    min-height: 44px;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    cursor: pointer;
  }

  .auto-deliver-toggle {
    display: flex;
    grid-area: auto;
    min-height: 44px;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    white-space: nowrap;
    cursor: pointer;
  }

  .auto-deliver-toggle input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--signal);
  }

  .guided-toggle input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--signal);
  }

  :is(.replica-actions, .gcounter-controls) button {
    min-height: 2.75rem;
    padding: 0.65rem 0.85rem;
    border: var(--rule-width) solid currentColor;
    border-radius: 0;
    color: inherit;
    background: transparent;
    font-family: var(--font-ui);
    line-height: 1.4;
    cursor: pointer;
  }

  .gcounter-controls [data-action="race"] {
    grid-area: race;
    color: var(--instrument-deep);
    background: var(--signal);
    font-weight: 650;
  }

  .gcounter-controls [data-action="resend"] {
    grid-area: resend;
  }

  .gcounter-controls [data-action="reset"] {
    grid-area: reset;
  }

  :is(.replica-actions, .gcounter-controls) button:hover:not(:disabled) {
    color: var(--instrument-deep);
    background: var(--signal);
  }

  :is(.replica-actions, .gcounter-controls) button:active:not(:disabled) {
    color: var(--instrument-deep);
    background: var(--clear);
  }

  :is(.replica-actions, .gcounter-controls) button:disabled {
    border-style: dashed;
    color: color-mix(in oklch, var(--clear) 58%, var(--instrument));
    background: transparent;
    cursor: not-allowed;
  }

  [data-enhancement-note] {
    grid-column: 1 / -1;
    margin: 0;
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }

  .gcounter-result,
  .gcounter-error {
    max-width: none;
    margin: 0;
    padding: var(--space-4);
    color: var(--instrument-deep);
    background: var(--signal);
    font-family: var(--font-ui);
    font-weight: 650;
  }

  .gcounter-error {
    margin-top: var(--space-3);
    color: var(--clear);
    background: var(--interference);
  }

  .guided-observations {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(14rem, 0.6fr);
    gap: var(--space-5);
    margin-top: var(--space-4);
    padding: var(--space-5);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
    background: color-mix(in oklch, var(--clear) 6%, var(--instrument));
  }

  .guided-observations h3,
  .guided-observations p {
    margin-top: 0;
  }

  .guided-observations p:last-child {
    margin-bottom: 0;
  }

  .guided-callout {
    align-self: start;
    padding: var(--space-4);
    border: var(--rule-width) solid var(--signal);
    color: var(--signal);
    font-family: var(--font-ui);
    font-weight: 650;
  }

  :global(.guided-circle) {
    outline: var(--rule-signal) solid var(--signal);
    outline-offset: var(--space-2);
    border-radius: 50%;
  }

  :global(.guided-box) {
    outline: var(--rule-signal) solid var(--signal);
    outline-offset: var(--space-2);
  }

  [hidden] {
    display: none;
  }

  .gcounter-explanation {
    margin-top: var(--space-5);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .gcounter-explanation summary {
    min-height: 44px;
    padding-block: var(--space-4);
    font-family: var(--font-ui);
    font-weight: 650;
    cursor: pointer;
  }

  .gcounter-explanation summary:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .gcounter-explanation > div {
    padding-bottom: var(--space-5);
  }

  .gcounter-explanation table {
    width: 100%;
    margin-block: var(--space-4);
    border-collapse: collapse;
  }

  .gcounter-explanation :is(th, td) {
    padding: var(--space-3);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
    text-align: left;
  }

  .gcounter-explanation th {
    font-family: var(--font-ui);
  }

  @media (width < 48rem) {
    .gcounter-heading,
    .gcounter-controls,
    .gcounter-network,
    .guided-observations {
      grid-template-columns: 1fr;
    }

    .gcounter-controls {
      grid-template-areas:
        "speed"
        "auto"
        "race"
        "resend"
        "reset"
        "guided";
    }

    .gcounter-network {
      grid-template-areas:
        "a"
        "sequencer"
        "b"
        "c";
      gap: var(--space-5);
    }

    .operation-key {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }

    .replica-c {
      justify-self: stretch;
      width: auto;
    }

    .sequencer-channel {
      padding-block: var(--space-3);
    }
  }
</style>
