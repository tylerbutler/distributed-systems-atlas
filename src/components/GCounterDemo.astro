---
import DemoTransportControls from "./DemoTransportControls.astro";
import StationMark from "./StationMark.astro";
import {
  createGCounterDemo,
  gCounterUserName,
  presentGCounterDemo,
} from "../lib/structure-demo/g-counter";

const initial = presentGCounterDemo(createGCounterDemo());
---

<g-counter-demo data-testid="g-counter-demo">
  <section class="gcounter-instrument" aria-labelledby="gcounter-demo-title">
    <div class="operation-layer" data-operation-layer aria-hidden="true"></div>
    <header class="gcounter-heading">
      <div>
        <h2 id="gcounter-demo-title">Record sightings on three hikes</h2>
        <p>
          Use the controls in each notebook to explore the counter. Each hiker
          leaves their running count at a known checkpoint. Turn off
          Auto-deliver to hold several notes before delivery.
        </p>
      </div>
      <p class="merge-rule">
        Merge rule
        <strong>Keep the largest bird count left by each hiker.</strong>
      </p>
    </header>

    <div class="operation-key" aria-label="Checkpoint note states">
      <p>
        <span class="operation-key-mark outbound" aria-hidden="true"></span>
        <span><strong>New note</strong> In transit to a checkpoint</span>
      </p>
      <p>
        <span class="operation-key-mark sequenced" aria-hidden="true"></span>
        <span><strong>Shared note</strong> Being delivered to the other hikers</span>
      </p>
    </div>

    <div class="gcounter-network">
      {initial.replicas.map((replica, index) => (
        <Fragment>
          <section
            class={`gcounter-replica replica-${replica.id.toLowerCase()}`}
            data-client={replica.id}
            aria-label={`${gCounterUserName(replica.id)}'s replica`}
          >
            <header>
              <StationMark station={replica.id} size="lg" />
              <div>
                <h3>{gCounterUserName(replica.id)}</h3>
                <p data-replica-state={replica.id}>Connected to checkpoint network</p>
              </div>
            </header>
            <output class="gcounter-total observation-data" data-total={replica.id}>
              {replica.value}
            </output>
            <p>Birds in this hiker's view</p>
            <div class="replica-actions" aria-label={`Record birds for ${gCounterUserName(replica.id)}`}>
              {[1, 3, 7].map((amount) => (
                <button
                  type="button"
                  data-replica={replica.id}
                  data-increment={amount}
                  aria-label={`Record ${amount} ${amount === 1 ? "bird" : "birds"} for ${gCounterUserName(replica.id)}`}
                  disabled
                >
                  +{amount}
                </button>
              ))}
            </div>
          </section>
          {index === 0 && (
            <div class="sequencer-channel">
              <section class="sequencer-station" data-sequencer-node aria-label="Known checkpoint">
                <span class="sequencer-label">Known checkpoint</span>
                <output class="sequencer-counter" data-sequence-counter aria-label="Notes left at checkpoint">
                  0 notes
                </output>
              </section>
              <ol class="operation-log" data-deliveries aria-label="Checkpoint note log" reversed>
                <li>No checkpoint note shared yet.</li>
              </ol>
            </div>
          )}
        </Fragment>
      ))}
    </div>

    <p class="gcounter-result" role="status" aria-live="polite" aria-atomic="true">
      {initial.result}
    </p>
    <p class="gcounter-error" role="alert" hidden></p>

    <DemoTransportControls />

    <section class="gcounter-controls" aria-label="Worked example controls">
      <h3>Run the worked example</h3>
      <p>
        Reset the sandbox and leave Alice's and Bob's notes together, or adjust
        how the notes travel.
      </p>
      <button type="button" data-action="race" disabled>
        Leave Alice +7 and Bob +3 together
      </button>
      <button type="button" data-action="resend" disabled>
        Repeat latest checkpoint note
      </button>
      <button type="button" data-action="reset" disabled>Reset</button>
      <label class="guided-toggle">
        <input
          type="checkbox"
          data-guided-observations
          aria-controls="guided-observations"
          disabled
        />
        <span>Guided observations</span>
      </label>
      <p data-enhancement-note>
        Enable JavaScript to run the demo. The initial values and expected
        result remain available in the article.
      </p>
    </section>

    <aside
      class="guided-observations"
      id="guided-observations"
      data-guided-panel
      hidden
    >
      <div>
        <h3>How checkpoint notes merge</h3>
        <p>
          Each note contains a hiker's name and cumulative bird count. When a
          replica receives a note, it keeps the larger count already stored for
          that hiker.
        </p>
        <p>
          The network can deliver notes in any order or more than once. Alice's 7 still
          replaces Alice's 4, and another copy of Alice's 7 changes nothing.
        </p>
      </div>
      <p class="guided-callout" data-guided-callout aria-live="polite">
        Turn off Auto-deliver to hold several checkpoint notes.
      </p>
    </aside>

    <details class="gcounter-explanation">
      <summary>Open the hikers' count tables</summary>
      <div>
        <p>
          Each hiker's notebook has one row for Alice, Bob, and Carol. A row
          stores the largest count received from that hiker. Checkpoint notes
          can be delivered in any order.
        </p>
        <table aria-label="Largest counts in each hiker's notebook">
          <thead>
            <tr>
              <th scope="col">Hiker</th>
              <th scope="col">Alice's view</th>
              <th scope="col">Bob's view</th>
              <th scope="col">Carol's view</th>
            </tr>
          </thead>
          <tbody>
            {(["A", "B", "C"] as const).map((user) => (
              <tr>
                <th scope="row">{gCounterUserName(user)}</th>
                {(["A", "B", "C"] as const).map((replica) => (
                  <td class="observation-data" data-user-count={`${replica}-${user}`}>0</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
        <p>
          A repeated or older note cannot lower a row. Each hiker compares the
          note with the count already in the table and keeps the larger value.
        </p>
      </div>
    </details>
  </section>
</g-counter-demo>

<script>
  import "../lib/structure-demo/g-counter-element";
</script>

<style>
  g-counter-demo {
    display: block;
    width: min(calc(100vw - 2rem), var(--content));
    max-width: none;
    margin-block: var(--space-7);
    margin-inline: 50%;
    font-variant-numeric: tabular-nums;
    transform: translateX(-50%);
  }

  .gcounter-instrument {
    position: relative;
    padding: clamp(1rem, 3vw, 2rem);
    border: var(--rule-width) solid var(--instrument-deep);
    color: var(--clear);
    background: var(--instrument);
    --focus-color: var(--signal);
    --link-color: var(--clear);
  }

  .operation-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  :global(.operation-pulse) {
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  :global(.operation-pulse.outbound) {
    background: var(--signal);
  }

  :global(.operation-pulse.sequenced) {
    color: var(--instrument-deep);
    background: var(--clear);
  }

  :global(.operation-pulse-label) {
    position: absolute;
    bottom: calc(100% + var(--space-1));
    left: 50%;
    padding: 2px 5px;
    border-radius: 0;
    color: var(--instrument-deep);
    background: var(--signal);
    font-family: var(--font-data);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  :global(.operation-pulse.sequenced .operation-pulse-label) {
    color: var(--instrument-deep);
    background: var(--clear);
  }

  .operation-key {
    display: flex;
    gap: var(--space-5);
    padding-block: var(--space-3);
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .operation-key p {
    display: flex;
    margin: 0;
    align-items: center;
    gap: var(--space-2);
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  .operation-key strong {
    display: block;
    color: var(--clear);
  }

  .operation-key-mark {
    width: 12px;
    height: 12px;
    border: var(--rule-width) solid var(--signal);
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .operation-key-mark.outbound {
    background: var(--signal);
  }

  .operation-key-mark.sequenced {
    border-color: var(--clear);
    background: var(--clear);
  }

  .gcounter-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
    gap: var(--space-6);
    align-items: end;
    padding-bottom: var(--space-5);
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .gcounter-heading h2,
  .gcounter-heading p,
  .gcounter-replica h3,
  .gcounter-replica p {
    margin: 0;
  }

  .gcounter-heading p {
    margin-top: var(--space-3);
  }

  .merge-rule {
    padding: var(--space-4);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 45%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }

  .merge-rule strong {
    display: block;
    margin-top: var(--space-2);
    color: var(--signal);
    font-size: 1.05rem;
  }

  .gcounter-network {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(11rem, 0.45fr) minmax(0, 1fr);
    grid-template-areas:
      "a sequencer b"
      "c c c";
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: start;
    padding-block: var(--space-6);
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .gcounter-replica {
    min-width: 0;
    padding: var(--space-5);
    border: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
    background: color-mix(in oklch, var(--clear) 3%, var(--instrument));
  }

  .replica-a {
    grid-area: a;
  }

  .replica-b {
    grid-area: b;
  }

  .replica-c {
    grid-area: c;
    justify-self: center;
    width: min(100%, 24rem);
  }

  .gcounter-replica header {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .gcounter-replica h3 {
    font-size: 1.15rem;
  }

  .gcounter-replica header p,
  .gcounter-total + p {
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.825rem;
  }

  .gcounter-replica header p {
    font-size: 0.75rem;
  }

  .gcounter-total {
    display: block;
    width: fit-content;
    margin-top: var(--space-4);
    color: var(--signal);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 650;
    line-height: 0.95;
  }

  .gcounter-total + p {
    margin-top: var(--space-2);
  }

  .replica-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .sequencer-channel {
    grid-area: sequencer;
    display: flex;
    min-width: 0;
    align-self: stretch;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-top: clamp(var(--space-4), 4vw, var(--space-6));
  }

  .sequencer-station {
    display: flex;
    width: fit-content;
    padding: var(--space-3) var(--space-5);
    border: var(--rule-width) solid var(--clear);
    border-radius: 999px;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    background: var(--instrument);
    text-align: center;
  }

  .sequencer-label {
    margin: 0;
    color: var(--signal);
    font-family: var(--font-ui);
    font-size: 1.15rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .sequencer-counter {
    color: var(--clear);
    font-family: var(--font-data);
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }

  .sequencer-counter.stamped {
    animation: sequencer-stamp 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes sequencer-stamp {
    from {
      color: var(--signal);
      transform: scale(1.12);
    }
  }

  .operation-log {
    display: flex;
    width: min(100%, 12rem);
    min-height: 10rem;
    flex: 1;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    scrollbar-color: var(--signal) var(--instrument);
  }

  .operation-log :global(li) {
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-data);
    font-size: 0.68rem;
    line-height: 1.45;
    text-align: center;
  }

  .gcounter-controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      "heading heading heading"
      "intro intro intro"
      "race resend reset"
      "guided guided guided";
    gap: var(--space-3);
    align-items: end;
    padding-block: var(--space-5);
  }

  .gcounter-controls > h3 {
    grid-area: heading;
    margin: 0;
    font-size: 1.4rem;
  }

  .gcounter-controls > p:not([data-enhancement-note]) {
    grid-area: intro;
    margin: 0;
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
  }

  .guided-toggle {
    display: flex;
    grid-area: guided;
    width: fit-content;
    min-height: 44px;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    cursor: pointer;
  }

  .guided-toggle input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--signal);
  }

  :is(.replica-actions, .gcounter-controls) button {
    min-height: 2.75rem;
    padding: 0.65rem 0.85rem;
    border: var(--rule-width) solid currentColor;
    border-radius: 0;
    color: inherit;
    background: transparent;
    font-family: var(--font-ui);
    line-height: 1.4;
    cursor: pointer;
  }

  .replica-actions button {
    padding-inline: var(--space-2);
    color: var(--signal);
    font-weight: 650;
    white-space: nowrap;
  }

  .gcounter-controls [data-action="race"] {
    grid-area: race;
    font-weight: 650;
  }

  .gcounter-controls [data-action="resend"] {
    grid-area: resend;
  }

  .gcounter-controls [data-action="reset"] {
    grid-area: reset;
  }

  :is(.replica-actions, .gcounter-controls) button:hover:not(:disabled) {
    color: var(--instrument-deep);
    background: var(--signal);
  }

  :is(.replica-actions, .gcounter-controls) button:active:not(:disabled) {
    color: var(--instrument-deep);
    background: var(--clear);
  }

  :is(.replica-actions, .gcounter-controls) button:disabled {
    border-style: dashed;
    color: color-mix(in oklch, var(--clear) 58%, var(--instrument));
    background: transparent;
    cursor: not-allowed;
  }

  [data-enhancement-note] {
    grid-column: 1 / -1;
    margin: 0;
    color: color-mix(in oklch, var(--clear) 76%, var(--instrument));
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }

  .gcounter-result,
  .gcounter-error {
    max-width: none;
    margin: 0;
    padding: var(--space-4);
    color: var(--instrument-deep);
    background: var(--signal);
    font-family: var(--font-ui);
    font-weight: 650;
  }

  .gcounter-error {
    margin-top: var(--space-3);
    color: var(--clear);
    background: var(--interference);
  }

  .guided-observations {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(14rem, 0.6fr);
    gap: var(--space-5);
    margin-top: var(--space-4);
    padding: var(--space-5);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
    background: color-mix(in oklch, var(--clear) 6%, var(--instrument));
  }

  .guided-observations h3,
  .guided-observations p {
    margin-top: 0;
  }

  .guided-observations p:last-child {
    margin-bottom: 0;
  }

  .guided-callout {
    align-self: start;
    padding: var(--space-4);
    border: var(--rule-width) solid var(--signal);
    color: var(--signal);
    font-family: var(--font-ui);
    font-weight: 650;
  }

  [hidden] {
    display: none;
  }

  .gcounter-explanation {
    margin-top: var(--space-5);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
  }

  .gcounter-explanation summary {
    min-height: 44px;
    padding-block: var(--space-4);
    font-family: var(--font-ui);
    font-weight: 650;
    cursor: pointer;
  }

  .gcounter-explanation summary:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .gcounter-explanation > div {
    padding-bottom: var(--space-5);
    overflow-x: auto;
  }

  .gcounter-explanation table {
    width: 100%;
    min-width: 36rem;
    margin-block: var(--space-4);
    border-collapse: collapse;
  }

  .gcounter-explanation :is(th, td) {
    padding: var(--space-3);
    border-block: var(--rule-width) solid color-mix(in oklch, var(--clear) 35%, var(--instrument));
    text-align: left;
  }

  .gcounter-explanation th {
    font-family: var(--font-ui);
  }

  @media (width < 64rem) {
    .gcounter-heading {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (width < 48rem) {
    .gcounter-heading,
    .gcounter-controls,
    .gcounter-network,
    .guided-observations {
      grid-template-columns: 1fr;
    }

    .gcounter-controls {
      grid-template-areas:
        "heading"
        "intro"
        "race"
        "resend"
        "reset"
        "guided";
    }

    .gcounter-network {
      grid-template-areas:
        "a"
        "sequencer"
        "b"
        "c";
      gap: var(--space-5);
    }

    .operation-key {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }

    .replica-c {
      justify-self: stretch;
      width: auto;
    }

    .sequencer-channel {
      padding-block: var(--space-3);
    }

    .operation-log {
      min-height: 6rem;
      max-height: 8rem;
      flex: none;
    }
  }
</style>
