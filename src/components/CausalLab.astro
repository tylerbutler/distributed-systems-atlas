---
import TraceFallback from "./TraceFallback.astro";
import { createEngine } from "../lib/lab/engine-registry";
import { presentFrame } from "../lib/lab/present-frame";
import { scenarioById } from "../lib/lab/scenarios";
import "../styles/lab.css";

interface Props {
  scenario: string;
}

const { scenario } = Astro.props;
const definition = scenarioById(scenario);
const engine = createEngine(definition);
const frame = presentFrame(engine.current(), engine.history(), definition.presentation);
---

<causal-lab scenario={scenario} data-testid="causal-lab">
  <TraceFallback frame={frame} />
</causal-lab>

<script>
  import "../lib/lab/causal-lab-element";
</script>
