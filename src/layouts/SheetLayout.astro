---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import ComplexityBadge from "../components/ComplexityBadge.astro";
import CorrectnessWarning from "../components/CorrectnessWarning.astro";
import LessonIllustration from "../components/LessonIllustration.astro";
import SheetLinks from "../components/SheetLinks.astro";
import { entryAnchor, sheetReferenceId, type SheetMeta, type SheetReference } from "../lib/atlas/graph";
import { pairedLessonForSheet } from "../lib/atlas/trail";
import type { MarkdownHeading } from "astro";

interface Props {
  entry: CollectionEntry<"sheet">;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const isSystems = entry.data.territory === "systems";
const contentsLabel = isSystems ? "In this note" : "On this sheet";
const termsLabel = isSystems ? "Terms in this note" : "Terms on this sheet";
const contents = headings.filter(({ depth }) => depth === 2);
const prose = (entry.body ?? "")
  .replace(/```[\s\S]*?```/g, "")
  .replace(/^import .+$/gm, "")
  .replace(/<[^>]+>/g, "")
  .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1");
const wordCount = prose.match(/\b[\w]+(?:['’-][\w]+)*\b/g)?.length ?? 0;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));
const sheets: SheetMeta[] = (await getCollection("sheet")).map(
  (sheet) => ({ id: sheet.id, ...sheet.data }),
);
const byId = new Map(sheets.map((sheet) => [sheet.id, sheet]));
const resolve = (reference: SheetReference): SheetMeta => {
  const id = sheetReferenceId(reference);
  const sheet = byId.get(id);
  if (!sheet) throw new Error(`Sheet ${entry.id} references missing sheet ${id}`);
  return sheet;
};
const territories = {
  mechanisms: "Mechanisms",
  structures: "Structures",
  failures: "Failure modes",
  systems: "Systems",
};
const pairedLesson = pairedLessonForSheet(entry.id);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  territory={territories[entry.data.territory]}
  sheetTitle={entry.data.title}
>
  <article class:list={["sheet", { "systems-sheet": isSystems }]}>
    <header class="sheet-header">
      <h1>{entry.data.title}</h1>
      {entry.data.showCorrectnessWarning && <CorrectnessWarning />}
      {isSystems ? (
        <p class="territory-label systems-context">
          <a href="/atlas/#systems">Systems</a>
          <span>Inside the Atlas</span>
        </p>
      ) : (
        <p class="territory-label">
          Territory: <a href={`/atlas/#${entry.data.territory}`}>{territories[entry.data.territory]}</a>
        </p>
      )}
      <p class="sheet-summary">{entry.data.summary}</p>
      <p class="sheet-reading-meta">
        <ComplexityBadge complexity={entry.data.complexity} />
        <span>{readingMinutes} min read</span>
        <span>{entry.data.scenarios.length > 0 ? "Lab available" : "No embedded lab"}</span>
      </p>
      {entry.data.requires.length > 0
        ? <SheetLinks heading="Helpful background" sheets={entry.data.requires.map(resolve)} />
        : <p class="sheet-prerequisites">No background sheet listed</p>}
      <LessonIllustration id={`atlas-${entry.id}`} />
    </header>
    {[
      { section: "opening", label: contentsLabel },
      { section: "continuation", label: "Continue reading" },
    ].map(({ section, label }) => (
      <div class={`sheet-local sheet-local-${section}`}>
        <div class="sheet-local-inner">
          <details class="sheet-contents">
            <summary>{label}</summary>
            <nav aria-label={label}>
              <h2>{label}</h2>
              <ul>
                {contents.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}
              </ul>
            </nav>
          </details>
        </div>
      </div>
    ))}
    {entry.data.terms.length > 0 && (
      <aside class="sheet-terms" aria-label={termsLabel}>
        <h2>{termsLabel}</h2>
        <dl>
          {entry.data.terms.map(({ term, definition }) => (
            <><dt><a href={`/glossary/#${entryAnchor(term)}`}>{term}</a></dt><dd>{definition}</dd></>
          ))}
        </dl>
      </aside>
    )}
    <div class="sheet-body"><slot /></div>
    <footer class="sheet-end">
      {pairedLesson && (
        <p>
          Prefer a focused simulation?{" "}
          <a href={`/structures/${pairedLesson[0]}/`}>
            Open the {pairedLesson[1].lesson} lesson and simulation
          </a>.
        </p>
      )}
      {entry.data.references.length > 0 && (
        <section class="sheet-references" aria-labelledby="sheet-references">
          <h2 id="sheet-references">References</h2>
          <ol>
            {entry.data.references.map(({ key, title }) => (
              <li id={`reference-${key}`}>
                <a href={`/bibliography/#${entryAnchor(key)}`}>{title}</a>
              </li>
            ))}
          </ol>
        </section>
      )}
      <SheetLinks heading="Related sheets" sheets={entry.data.related.map(resolve)} emptyText="No related sheets" />
    </footer>
  </article>
</BaseLayout>
