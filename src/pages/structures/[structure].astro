---
import RemainingStructureDemo from "../../components/RemainingStructureDemo.astro";
import FifoWorkQueueDemo from "../../components/FifoWorkQueueDemo.astro";
import NaiveTextMergeDemo from "../../components/NaiveTextMergeDemo.astro";
import StructureFacts from "../../components/StructureFacts.astro";
import StructureLessonLayout from "../../components/StructureLessonLayout.astro";
import TermCallout from "../../components/TermCallout.astro";
import {
  remainingFamilies,
  remainingStructures,
  sequenceStopMarks,
  structureById,
} from "../../lib/structure-demo/remaining-structures";

export function getStaticPaths() {
  return remainingStructures.map((structure) => ({
    params: { structure: structure.id },
  }));
}

const structure = structureById(Astro.params.structure ?? "");
if (!structure) throw new Error("Unknown structure");
const family = remainingFamilies[structure.family];
const isSharedSequence = structure.id === "shared-sequence";
const isSharedText = structure.id === "shared-text";
const isClaims = structure.id === "claims";
const isFifoWorkQueue = structure.id === "fifo-work-queue";
const operationNames = structure.operations.length === 1
  ? structure.operations[0]
  : `${structure.operations.slice(0, -1).join(", ")}, and ${structure.operations.at(-1)}`;
---

<StructureLessonLayout
  title={structure.name}
  description={structure.tagline}
  articleClass={`structure-lesson${isSharedSequence || isSharedText || isClaims || isFifoWorkQueue ? " structure-page" : ""}`}
  illustrationId={`structures-${structure.id}`}
  territoryLabel={`Structures · ${family.name}`}
>
      <Fragment slot="summary">{structure.tagline}</Fragment>

      {(isSharedSequence || isSharedText) && (
        <nav class="lesson-map" aria-label={`${structure.name} lesson map`}>
          <a href={isSharedText ? "#offset-problem" : "#route-setup"}>
            {isSharedText ? "See why offsets fail" : "Compare the notebooks"}
          </a>
          <a href={isSharedText ? "#text-mechanics" : "#shared-sequence-demo-title"}>
            {isSharedText ? "Follow the mechanics" : "Try the route sandbox"}
          </a>
          <a href={isSharedText ? "#shared-text-demo-title" : "#route-result"}>
            {isSharedText ? "Try the shared editor" : "Read the result"}
          </a>
        </nav>
      )}

      <section class="structure-story">
        <h2>
          {isSharedSequence
            ? "Two hikers edit the route"
            : isSharedText
              ? "Three hikers edit one field note"
              : "At Eagle Creek"}
        </h2>
        <p>{structure.story}</p>
        {isSharedSequence ? (
          <p>
            The ranger's route begins Bridge, Weir, North gate. Alice adds Falls
            before Weir in her notebook. Bob adds Marsh before Weir in his.
            Carol has not received either insertion slip, so her route is unchanged.
          </p>
        ) : isSharedText ? (
          <p>
            Alice inserts “still” while Bob inserts “calm” at the same place.
            Carol has not received either edit. Each written symbol has its own
            identity, so all three notebooks can later keep both changes in the
            same order.
          </p>
        ) : isClaims ? (
          <p>
            Each hiker's ledger begins with <code>gate-key: unclaimed</code>.
            They send separate requests to the ranger, who can accept only one.
            Until he numbers the requests and announces the result, every ledger
            still shows the key as unclaimed.
          </p>
        ) : isFifoWorkQueue ? (
          <p>
            The list is not a set of cards that workers choose from. A worker
            asks for the next job, and the queue gives that worker the oldest
            available entry.
          </p>
        ) : <p>
          Each hiker keeps a {structure.recordLabel.toLowerCase()}. They write each
          change on a {structure.messageLabel.toLowerCase()} to send to the others.
          The slip includes the details they need to agree on the result. In the
          demo, you can see both the hiker's copy and the slip they send.
        </p>}
        {!isSharedText && !isClaims && !isFifoWorkQueue && (
          <p>
            Another hiker may act before the slip arrives. Each hiker uses the
            rule to record the other's work when they receive it.
          </p>
        )}
        {structure.localVisibility && !isClaims && <p>{structure.localVisibility}</p>}
      </section>

      {isSharedText && (
        <>
          <section id="offset-problem" aria-labelledby="offset-problem-title">
            <h2 id="offset-problem-title">A character offset is only local</h2>
            <p>
              A basic text editor can describe one character insertion with a
              number: <code>insert("s", 4)</code>. The number means “put this
              symbol before the symbol that is currently at position 4.” It
              works while one copy owns the string.
            </p>
            <p>
              The number becomes stale when separate copies change. Alice and Bob
              both start with <code>The weir is clear.</code>. Alice inserts
              <code>still </code> as six character operations at positions 4
              through 9. Bob inserts <code>calm </code> as five operations at
              positions 4 through 8. If a replica applies those raw offsets in
              arrival order, the result depends on which message arrives first.
            </p>
            <figure class="text-order-example">
              <div class="route-table-scroll">
                <table aria-label="Different results from applying the same raw character offsets in different orders">
                  <thead>
                    <tr><th scope="col">Arrival order</th><th scope="col">Naive result</th></tr>
                  </thead>
                  <tbody>
                    <tr>
                      <th scope="row">Alice, then Bob</th>
                      <td><code>The calm still weir is clear.</code></td>
                    </tr>
                    <tr>
                      <th scope="row">Bob, then Alice</th>
                      <td><code>The still calm weir is clear.</code></td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <figcaption>
                Both runs begin at position 4. Their character operations do not
                provide a common order for two insertions into the same gap.
              </figcaption>
            </figure>
            <p>
              A stale range is more dangerous. An instruction such as
              <code> delete(4, 8)</code> names “weir” only in the version where
              the instruction was created. A concurrent insertion can move those
              offsets, so another replica can remove different symbols. Sending
              raw offsets is not enough to preserve intent or convergence.
            </p>
          </section>

          <NaiveTextMergeDemo />

          <section aria-labelledby="grapheme-title">
            <h2 id="grapheme-title">Text is a sequence of graphemes</h2>
            <p>
              SharedText first divides a string into
              <dfn><a href="/glossary/#grapheme"> graphemes</a></dfn>. A grapheme
              is one visible written symbol. It can contain more than one Unicode
              code point, such as a letter plus a combining accent or a family
              emoji joined from several code points.
            </p>
            <p>
              This boundary matters because an editor must not put a cursor
              inside one visible symbol. Watershed counts graphemes, not UTF-16
              code units. Insert, delete, and replace ranges therefore use the
              same units that a reader sees.
            </p>
            <TermCallout
              term="grapheme"
              definition="One visible written symbol. A grapheme can contain one or more Unicode code points."
            />
          </section>

          <section id="text-mechanics" aria-labelledby="text-mechanics-title">
            <h2 id="text-mechanics-title">SharedText uses the SharedSequence rule</h2>
            <p>
              The order resolution is not merely similar. It is the same
              sequence CRDT. Watershed's text value wraps a
              <code> Sequence(String)</code>. Each grapheme is a sequence item
              with a stable identity, and concurrent insertions use the same
              deterministic order as SharedSequence.
            </p>
            <p>
              SharedText adds a text layer around that sequence. The layer
              segments strings into graphemes, joins the visible items back into
              a string, and builds range operations for deletion and replacement.
              It does not add a second ordering rule.
            </p>
            <ol class="text-mechanics">
              <li>
                <strong>Describe the local edit.</strong> The editor compares the
                old and new strings and finds one insertion, deletion, or
                replacement in local grapheme indexes. This demo sends each
                inserted grapheme as its own operation, so inserting a word
                creates several character operations.
              </li>
              <li>
                <strong>Create a sequence delta.</strong> The text layer converts
                each operation into a
                <dfn><a href="/glossary/#delta"> delta</a></dfn> that names
                stable sequence items and the new item created by this replica.
              </li>
              <li>
                <strong>Update the local copy.</strong> The author sees the edit
                at once. The operation keeps the numeric indexes for diagnostics,
                but the delta is the authoritative payload.
              </li>
              <li>
                <strong>Sequence and deliver the operation.</strong> The
                sequencer gives each accepted operation one sequence number.
                The author acknowledges its pending operation, and the other
                replicas apply it as a remote operation. They merge the delta;
                they do not run the author's old index against the current
                string.
              </li>
            </ol>
            <TermCallout
              term="delta"
              definition="The part of a CRDT state created by one change. Replicas merge the delta instead of replaying a stale local offset."
            />
          </section>

          <aside class="perspective-note text-perspective" aria-labelledby="text-perspective-title">
            <h3 class="term-callout-label" id="text-perspective-title">Alternative perspective</h3>
            <div>
              <p>
                Text makes the need for item identities easy to see. Values are
                not identities. The word <code>letter</code> contains two
                <code>t</code> values and two <code>e</code> values. An operation
                that says “delete <code>t</code>” does not say which
                <code>t</code> it means.
              </p>
              <div class="text-identity-example" aria-label="Conceptual identity view of the word letter">
                <span>Visible text</span>
                <code>l e t t e r</code>
                <span>Identity view</span>
                <code>{"l{id-1} e{id-2} t{id-3} t{id-4} e{id-5} r{id-6}"}</code>
              </div>
              <p>
                The IDs are conceptual labels, not Watershed's wire format. If
                Alice deletes <code>id-3</code>, every replica can remove the
                same <code>t</code> even after another edit moves it to a new
                visible index. SharedSequence needs IDs for the same reason:
                equal values can still be different items.
              </p>
            </div>
          </aside>

          <section aria-labelledby="text-ranges-title">
            <h2 id="text-ranges-title">Delete and replace target observed symbols</h2>
            <p>
              An insertion creates new sequence items. A deletion records the
              identities of the graphemes that the author observed in the range.
              Applying the same deletion twice has no extra effect, and a
              recipient can identify those graphemes even if other edits changed
              their visible indexes.
            </p>
            <p>
              A replacement combines both operations: remove the observed
              graphemes, then insert new graphemes at that place. In the demo,
              Alice replaces “weir” with “levee” while Bob deletes “ei” from the
              original word. Both operations refer to the original grapheme
              identities. Every notebook therefore reaches
              <code>The levee is clear.</code>, regardless of delivery order.
            </p>
            <p>
              The naive panel omits both stable identities and a sequencer. A
              sequencer can make replicas process raw-offset messages in one
              order, but the offsets can still be stale against an author's
              optimistic local text. SharedText preserves the intended items in
              the delta, while the sequencer supplies the accepted operation
              order and acknowledgements.
            </p>
          </section>
        </>
      )}

      {isSharedSequence && (
        <section id="route-setup" aria-labelledby="route-setup-title">
          <h2 id="route-setup-title">Three notebooks before the notes arrive</h2>
          <figure class="route-notebooks">
            <div class="route-table-scroll">
              <table aria-label="Each hiker's inspection route before and after sharing">
                <thead><tr><th scope="col">Hiker</th><th scope="col">Before sharing</th><th scope="col">After sharing</th></tr></thead>
                <tbody>
                  <tr><th scope="row">Alice</th><td>Bridge · <ins data-stop="falls"><span class="dotted-value">Falls<sup>{sequenceStopMarks.Falls}</sup></span></ins> · Weir · North gate</td><td>Bridge · <span class="dotted-value">Falls<sup>{sequenceStopMarks.Falls}</sup></span> · <ins data-stop="marsh"><span class="dotted-value">Marsh<sup>{sequenceStopMarks.Marsh}</sup></span></ins> · Weir · North gate</td></tr>
                  <tr><th scope="row">Bob</th><td>Bridge · <ins data-stop="marsh"><span class="dotted-value">Marsh<sup>{sequenceStopMarks.Marsh}</sup></span></ins> · Weir · North gate</td><td>Bridge · <ins data-stop="falls"><span class="dotted-value">Falls<sup>{sequenceStopMarks.Falls}</sup></span></ins> · <span class="dotted-value">Marsh<sup>{sequenceStopMarks.Marsh}</sup></span> · Weir · North gate</td></tr>
                  <tr><th scope="row">Carol</th><td>Bridge · Weir · North gate</td><td>Bridge · <ins data-stop="falls"><span class="dotted-value">Falls<sup>{sequenceStopMarks.Falls}</sup></span></ins> · <ins data-stop="marsh"><span class="dotted-value">Marsh<sup>{sequenceStopMarks.Marsh}</sup></span></ins> · Weir · North gate</td></tr>
                </tbody>
              </table>
            </div>
            <figcaption>
              <span class="route-key" data-stop="falls">Yellow: Falls (Alice)</span>{" "}
              <span class="route-key" data-stop="marsh">Blue: Marsh (Bob)</span>
              <span>Each highlight shows a trail stop new to that notebook.</span>
            </figcaption>
          </figure>
          <p>
            The starting trail stops already have IDs. Alice's new Falls gets <code>{sequenceStopMarks.Falls}</code>,
            and Bob's new Marsh gets <code>{sequenceStopMarks.Marsh}</code>. Each replica-and-counter
            pair has the form of a <dfn><a href="/glossary/#dot">dot</a></dfn>. It gives a trail stop
            a unique name, so insertion notes can refer to that stop even when others are added nearby.
            The sequence also uses these IDs to place new stops between existing ones and put
            concurrent insertions in the same order after the notebooks exchange notes.
          </p>
          <TermCallout
            term="dot"
            definition="A unique replica-and-counter pair. Here, the pair identifies a trail stop."
          />
        </section>
      )}

      {isClaims && (
        <>
          <section id="claims-map-model" aria-labelledby="claims-map-model-title">
            <h2 id="claims-map-model-title">Translate the story into a map</h2>
            <p>
              In the data model, the gate key becomes the key
              <code> gate-key</code>, and the winning hiker becomes its value. A
              <dfn><a href="/glossary/#claims"> Claims</a></dfn> value is a map
              of these named, write-once entries.
            </p>
            <TermCallout
              term="Claims"
              definition="A sequenced shared map of named, write-once entries. The first accepted claim for each key becomes permanent, and later claims for that key are rejected."
            />
            <p>
              This makes
              <a href="/structures/shared-map/"> SharedMap</a> the closest
              structure by shape: both structures are sequenced maps whose keys
              can change independently.
            </p>
            <p>
              Their update rules are opposite. SharedMap keeps the last numbered
              change for a key and can later replace or clear that value. Claims
              accepts only the first numbered claim for a key. That value is
              permanent. A later claim cannot overwrite it, and there is no
              release, delete, or reset operation.
            </p>
            <p>
              This rule is often called
              <dfn><a href="/glossary/#first-writer-wins"> first-writer-wins</a></dfn>.
              In Claims, “first” means the first operation accepted by the
              sequencer. It does not mean the earliest client clock, the first
              button press, or the first message to reach an arbitrary replica.
            </p>
            <TermCallout
              term="first-writer-wins"
              definition="A conflict rule that keeps the first accepted write and rejects or ignores later writes to the same location. The system must define how it decides which write is first."
            />
            <div class="route-table-scroll claims-comparison">
              <table aria-label="Claims and SharedMap mechanics">
                <thead>
                  <tr>
                    <th scope="col">Mechanic</th>
                    <th scope="col">Claims</th>
                    <th scope="col">SharedMap</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row">Shape</th>
                    <td>Named key to claimant</td>
                    <td>Named key to value</td>
                  </tr>
                  <tr>
                    <th scope="row">Winner</th>
                    <td>First numbered claim</td>
                    <td>Last numbered change</td>
                  </tr>
                  <tr>
                    <th scope="row">Later write</th>
                    <td>Rejected</td>
                    <td>Replaces the value</td>
                  </tr>
                  <tr>
                    <th scope="row">Delete</th>
                    <td>Not supported</td>
                    <td>Supported</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <StructureFacts
            structure="Claims"
            family="DDS"
            model="Sequenced map of write-once entries"
            updates="Claim an empty key once"
            merge="The first accepted claim for each key wins permanently"
            delivery="One sequencer-ordered operation stream"
            bestFor="Permanent ownership, election, and one-time assignment"
            cost="One accepted claimant per key plus pending claims"
          />

          <section aria-labelledby="claims-mechanics-title">
            <h2 id="claims-mechanics-title">From three pending claims to one permanent entry</h2>
            <ol class="text-mechanics">
              <li>
                <strong>Submit against an empty key.</strong> Alice, Bob, and
                Carol can each create a pending claim for <code>gate-key</code>.
                A pending claim does not yet make its author the owner.
              </li>
              <li>
                <strong>Assign the accepted order.</strong> The sequencer gives
                each operation a sequence number. The lowest accepted number
                for this empty key determines the winner.
              </li>
              <li>
                <strong>Apply one decision everywhere.</strong> The author
                receives an acknowledgement, and the other replicas receive
                the numbered operation. All replicas record the same claimant.
              </li>
              <li>
                <strong>Reject later claims.</strong> After the key is filled,
                <code>claim_once</code> returns <code>AlreadyClaimed</code>.
                Starting again requires a new key, a new claim namespace, or a
                new Claims state.
              </li>
            </ol>
            <p>
              The demo's Reset button creates a new demo room. It does not
              delete or release a claim through the Claims API.
            </p>
          </section>

          <aside class="perspective-note" aria-labelledby="claims-perspective-title">
            <h3 class="term-callout-label" id="claims-perspective-title">Alternative perspective</h3>
            <div>
              <p>
                Claims shares an irreversible quality with grow-only structures.
                A <a href="/structures/g-counter/">G-counter</a> cannot lower an
                accepted component, and a <a href="/structures/g-set/">GSet</a>
                cannot remove an accepted member. Claims likewise cannot remove
                an accepted key or change its claimant.
              </p>
              <p>
                The mechanics are different. G-counters and GSets are CRDTs:
                replicas combine concurrent state with maximum or union. Claims
                is a DDS. It does not merge competing claimants. The sequencer
                chooses one claim, and every replica applies that decision.
              </p>
              <p>
                <a href="/structures/task-manager/">TaskManager</a> is closer in
                purpose because it also assigns one client to a named task.
                TaskManager retains an ordered volunteer queue and can promote
                the next connected client when the active worker leaves. Claims
                retains only the permanent winner; it has no waiting queue,
                release, or promotion.
              </p>
            </div>
          </aside>
        </>
      )}

      {isSharedSequence && (
        <StructureFacts
          structure="SharedSequence"
          family="CRDT"
          model="Replicated sequence with stable item identities"
          updates="Insert trail stops into an ordered route"
          merge="Keep both concurrent inserts before the same trail stop."
          delivery="The hikers can exchange insertion notes later"
          bestFor="Routes and ordered lists edited on separate copies"
          cost="An identity and ordering mark for each trail stop"
        />
      )}

      {isSharedText && (
        <StructureFacts
          structure="SharedText"
          family="CRDT"
          model="SharedSequence of Unicode graphemes"
          updates="Insert, delete, replace, or append grapheme ranges"
          merge="Merge identity-based sequence deltas, not raw character offsets"
          delivery="A sequencer numbers accepted character operations"
          bestFor="Collaborative plain-text fields and editors"
          cost="Sequence metadata and stable identity for each grapheme"
        />
      )}

      {isFifoWorkQueue && (
        <>
          <StructureFacts
            structure="FifoWorkQueue"
            family="DDS"
            model="Sequenced FIFO queue with acquired jobs"
            updates="Add, acquire next, complete, or release"
            merge="The sequencer applies one accepted operation order"
            delivery="Clients wait for a numbered result"
            bestFor="Dispatching independent jobs to competing workers"
            cost="Queued jobs, held jobs, and sequenced operations"
          />
          <section aria-labelledby="queue-mechanics-title">
            <h2 id="queue-mechanics-title">From queued work to one active holder</h2>
            <ol class="text-mechanics">
              <li><strong>Add at the tail.</strong> New work joins the back of the queue.</li>
              <li><strong>Acquire the head.</strong> A worker asks for the next job, not a named job. The oldest queued entry becomes that worker's held job.</li>
              <li><strong>Complete or release.</strong> Completion removes held work. Release returns it to the tail, after jobs that were already waiting.</li>
              <li><strong>Recover from worker loss.</strong> The runtime can remove a disconnected client and return its held work to the tail. Another worker can then run it.</li>
            </ol>
            <p>
              This rule gives one active holder, but it does not guarantee
              exactly-once execution. A worker can perform part of a job and
              fail before completion is accepted. The returned job can then run
              again, so job handlers should tolerate retries.
            </p>
            <p>
              The queue does not keep a completed-job archive. The demo's Done
              column is a separate session history, like Watershed's example.
            </p>
          </section>
        </>
      )}

      {!isClaims && !isFifoWorkQueue && (
        <>
          <p>
            A <dfn><a href={`/glossary/#${structure.glossaryId}`}>{structure.name}</a></dfn>
            uses this rule to keep the shared record in agreement.
          </p>
          <TermCallout term={structure.name} definition={structure.rule} />
        </>
      )}

      <section>
        <h2>Run the conflict</h2>
        <p>
          {isSharedText
            ? "Type in any notebook, or run a worked conflict. Pause Broadcast to compare local copies before the edits travel."
            : isClaims
              ? "Pause Broadcast, submit concurrent claims, and inspect the pending requests. Resume Broadcast to let the sequencer choose the permanent value."
              : isFifoWorkQueue
                ? "Follow several jobs through queued, in progress, released, and done states."
            : "Alice and Bob act before either receives the other's slip. Carol receives their notes too and checks that all three copies agree."}
        </p>
      </section>

      {isFifoWorkQueue
        ? <FifoWorkQueueDemo />
        : <RemainingStructureDemo structure={structure} />}

      <section aria-labelledby="route-result">
        <h2 id="route-result">Read the result</h2>
        <p>{structure.result}</p>
      </section>

      <section aria-labelledby="source-title">
        <h2 id="source-title">Sources and implementation</h2>
        <p>
          <strong>Sources:</strong>{" "}
          {structure.sources.map((source, index) => (
            <>
              {index > 0 ? " and " : ""}
              <a href={`https://github.com/tylerbutler/watershed/blob/4a8739323ee491f353fcaa8ccfb0488419c1cd43/src/watershed/${source.path}`}>
                Watershed's <code>{source.name}</code>{index === structure.sources.length - 1 ? "." : ""}
              </a>
            </>
          ))}
        </p>
        <p>
          <strong>Implementation:</strong> The demo calls <code>{operationNames}</code>
          {" "}through the Gleam toolkit. The displayed client records and shared
          view come from those kernel results.
        </p>
      </section>

</StructureLessonLayout>

<style>
  .lesson-map {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-block: var(--space-5) var(--space-7);
    border-block: var(--rule-width) solid var(--line);
    font-family: var(--font-ui);
    font-weight: 650;
  }

  .lesson-map a {
    display: flex;
    min-height: 44px;
    padding: var(--space-3);
    align-items: center;
  }

  .lesson-map a + a {
    border-inline-start: var(--rule-width) solid var(--line);
  }

  .route-notebooks {
    margin-block: var(--space-5);
  }

  .route-table-scroll {
    overflow-x: auto;
  }

  .route-notebooks table {
    min-width: 36rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .route-notebooks :is(th, td) {
    padding: var(--space-2) var(--space-3);
    border-block: var(--rule-width) solid var(--line);
    text-align: left;
  }

  .route-notebooks th {
    font-family: var(--font-ui);
  }

  .route-notebooks th:first-child {
    width: 6rem;
    white-space: nowrap;
  }

  .route-notebooks :is(ins, .route-key) {
    padding-inline: 0.15em;
    font-weight: 700;
    text-decoration: none;
  }

  .route-notebooks [data-stop="falls"] {
    color: var(--instrument-deep);
    background: var(--signal);
  }

  .route-notebooks [data-stop="marsh"] {
    color: var(--clear);
    background: var(--instrument);
  }

  .route-notebooks ins sup {
    color: inherit;
  }

  .route-notebooks .route-key {
    display: inline-block;
    margin-inline-end: var(--space-2);
  }

  .route-notebooks figcaption {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: 0.875rem;
