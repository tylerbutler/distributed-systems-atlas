---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LessonIllustration from "../../components/LessonIllustration.astro";
import RemainingStructureDemo from "../../components/RemainingStructureDemo.astro";
import StructureKindTag from "../../components/StructureKindTag.astro";
import TermCallout from "../../components/TermCallout.astro";
import {
  remainingFamilies,
  remainingStructures,
  structureById,
} from "../../lib/structure-demo/remaining-structures";

export function getStaticPaths() {
  return remainingStructures.map((structure) => ({
    params: { structure: structure.id },
  }));
}

const structure = structureById(Astro.params.structure ?? "");
if (!structure) throw new Error("Unknown structure");
const family = remainingFamilies[structure.family];
const operationNames = structure.operations.length === 1
  ? structure.operations[0]
  : `${structure.operations.slice(0, -1).join(", ")}, and ${structure.operations.at(-1)}`;
---

<BaseLayout title={`${structure.name} | Distributed Systems Atlas`} description={structure.tagline}>
  <main id="main-content" tabindex="-1">
    <article class="structure-lesson">
      <header class="page-intro">
        <p class="territory-label">Structures · {family.name}</p>
        <h1>{structure.name}</h1>
        <p class="structure-summary">{structure.tagline}</p>
        <StructureKindTag kind={structure.kind} />
        <LessonIllustration id={`structures-${structure.id}`} />
      </header>

      <section class="structure-story">
        <h2>Set the Eagle Creek problem first</h2>
        <p>{structure.story}</p>
        <p>
          Each person carries a {structure.recordLabel.toLowerCase()}. When a person makes a
          change, they copy it onto a {structure.messageLabel.toLowerCase()} with the
          identity, path, sequence, or acceptance evidence that the rule needs. The demo
          shows both the local record and the note that travels.
        </p>
        <p>
          An ordinary local edit refers to a position or value. That reference can become
          stale while another client works. Watershed's <code>{structure.module}</code>
          uses this structure's rule to produce one shared result.
        </p>
      </section>

      <p>
        A <dfn><a href={`/glossary/#${structure.glossaryId}`}>{structure.name}</a></dfn>
        applies this rule to the shared record.
      </p>
      <TermCallout term={structure.name} definition={structure.rule} />

      <section>
        <h2>Run the conflict</h2>
        <p>
          Alice and Bob act before either receives the other operation. Carol
          stays connected as the third replica and confirms the converged view.
        </p>
      </section>

      <RemainingStructureDemo structure={structure} />

      <section>
        <h2>Read the result</h2>
        <p>{structure.result}</p>
      </section>

      <section aria-labelledby="source-title">
        <h2 id="source-title">Sources and implementation</h2>
        <p>
          <strong>Sources:</strong>{" "}
          {structure.sources.map((source, index) => (
            <>
              {index > 0 ? " and " : ""}
              <a href={`https://github.com/tylerbutler/watershed/blob/4a8739323ee491f353fcaa8ccfb0488419c1cd43/src/watershed/${source.path}`}>
                Watershed's <code>{source.name}</code>{index === structure.sources.length - 1 ? "." : ""}
              </a>
            </>
          ))}
        </p>
        <p>
          <strong>Implementation:</strong> Atlas calls <code>{operationNames}</code>
          {" "}through its Gleam toolkit. The displayed client records and shared
          view come from those kernel results.
        </p>
      </section>

      <nav class="structure-next" aria-label={`Continue through ${family.name}`}>
        <a href={`/structures/${structure.family}/`}>Browse {family.name}</a>
        {structure.next
          ? <a href={`/structures/${structure.next}/`}>Continue to {structureById(structure.next)?.name}</a>
          : structure.family === "sequences"
            ? <a href="/structures/coordination/">Continue to Coordination</a>
            : structure.family === "coordination"
              ? <a href="/structures/transforms/">Continue to Transforms</a>
              : <a href="/structures/">Return to structures</a>}
      </nav>
    </article>
  </main>
</BaseLayout>
