---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StructureNext from "../../components/StructureNext.astro";
import LessonIllustration from "../../components/LessonIllustration.astro";
import StructureKindTag from "../../components/StructureKindTag.astro";
import ComplexityBadge from "../../components/ComplexityBadge.astro";
import { structureComplexity } from "../../lib/learning-complexity";
import { remainingFamilies, structuresForFamily } from "../../lib/structure-demo/remaining-structures";
import "../../styles/remaining-family.css";

const family = remainingFamilies.transforms;
const structures = structuresForFamily("transforms");
---

<BaseLayout title="Transforms" description={family.tagline} territory="Structures" sheetTitle="Transforms">
  <article class="structure-family">
    <header class="page-intro">
      <p class="territory-label">Structure family</p>
      <h1>{family.name}</h1>
      <p>{family.intro}</p>
      <LessonIllustration id="structures-transforms" />
    </header>
    {structures.map((structure) => (
      <section aria-labelledby={`${structure.id}-title`}>
        <header>
          <div>
            <StructureKindTag kind={structure.kind} />
            <ComplexityBadge complexity={structureComplexity(structure.id)} />
            <h2 id={`${structure.id}-title`}>{structure.name}</h2>
            <p>{structure.tagline}</p>
          </div>
          <code>{structure.module}</code>
        </header>
        <p class="structure-rule"><strong>Rule:</strong> {structure.rule}</p>
        <a class="structure-link" href={`/structures/${structure.id}/`}>Open the {structure.name} lesson</a>
      </section>
    ))}
    <StructureNext />
  </article>
</BaseLayout>
