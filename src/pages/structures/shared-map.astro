---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LessonIllustration from "../../components/LessonIllustration.astro";
import MapStructureDemo from "../../components/MapStructureDemo.astro";
import StructureFacts from "../../components/StructureFacts.astro";
import TermCallout from "../../components/TermCallout.astro";
import { sharedMapTerm } from "../../lib/atlas/standalone-terms";
import "../../styles/set-lesson.css";
---

<BaseLayout title="SharedMap" description="The ranger numbers changes to named lines in each hiker's trail report table." territory="Structures" sheetTitle="SharedMap">
  <article class="register-lesson">
    <header class="page-intro">
      <p class="territory-label">Structures</p>
      <h1>SharedMap</h1>
      <p class="structure-summary">
        Each hiker copies the ranger's trail report table into a notebook.
        One line says "gate-status: Report pending"; another says
        "bridge-status: Inspection due." Alice and Bob change the gate line
        before either sees the other's note. The bridge line stays as it was.
      </p>
      <LessonIllustration id="structures-shared-map" />
    </header>
    <StructureFacts structure="SharedMap" family="DDS" model="Sequenced operation-based map" updates="Write, cross out, or clear named entries" merge="Use the last numbered change for each name." delivery="One server-ordered operation stream" bestFor="Shared JSON settings with one service to number changes" cost="Accepted entries plus notes awaiting a number" />
    <section aria-labelledby="order-title">
      <h2 id="order-title">The ranger numbers each change</h2>
      <p>
        In a <dfn><a href="/glossary/#sharedmap">SharedMap</a></dfn>, the ranger
        numbers every accepted change. Each named line has its own answer:
        changing gate-status does not erase bridge-status. When two hikers
        change the same line, all three hikers copy the answer from the
        higher-numbered note after delivery.
      </p>
      <p>
        Alice sees her own note as soon as she writes it. She keeps it in her
        notebook while she waits for the ranger's number. Even if Bob's note
        arrives first, Alice still sees her own answer until the ranger sends
        back the numbered changes.
      </p>
      <TermCallout {...sharedMapTerm} />
      <figure><table aria-label="SharedMap trail report table after the gate-status race"><thead><tr><th scope="col">Line</th><th scope="col">Before</th><th scope="col">After Alice and Bob's notes</th></tr></thead><tbody><tr><th scope="row">gate-status</th><td>Report pending</td><td>Trail closed</td></tr><tr><th scope="row">bridge-status</th><td>Inspection due</td><td>Inspection due</td></tr></tbody></table><figcaption>The ranger numbers Alice's gate note before Bob's. All three hikers record Bob's answer on the gate line; neither note changes the bridge line.</figcaption></figure>
    </section>
    <MapStructureDemo kind="shared-map" title="Update a shared trail report table" description="Alice and Bob change gate-status while bridge-status stays put. Any hiker can change the bridge line separately." rule="Use the highest ledger number for each line." raceLabel="Race the two gate-status notes" />
    <section aria-labelledby="limit-title"><h2 id="limit-title">One answer remains on each line</h2><p>Each hiker keeps the last numbered answer on each line. They replace Alice's gate answer when Bob's numbered note arrives; the bridge line is unchanged. If hikers should compare the dates on offline notes instead, use LWWMap. If they must keep a new note after crossing out an older line, use OR-map.</p></section>
    <section aria-labelledby="source-title">
      <h2 id="source-title">Sources and implementation</h2>
      <p>
        <strong>Sources:</strong> Watershed's{" "}
        <a href="https://github.com/tylerbutler/watershed/blob/4a8739323ee491f353fcaa8ccfb0488419c1cd43/src/watershed/map_kernel.gleam">SharedMap kernel</a>.
      </p>
      <p>
        <strong>Implementation:</strong> The demo calls Watershed through the Gleam toolkit
        and connects three clients in a <a href="/glossary/#sluice">Sluice</a> room.
        Each client uses the last numbered change for each key.
      </p>
    </section>
    <nav class="structure-next" aria-label="Continue through map structures"><a href="/structures/maps/">Back to map family</a><a href="/structures/lww-map/">Continue to LWWMap</a></nav>
  </article>
</BaseLayout>
