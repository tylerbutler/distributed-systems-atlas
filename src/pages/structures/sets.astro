---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StructureNext from "../../components/StructureNext.astro";
import LessonIllustration from "../../components/LessonIllustration.astro";
import StructureKindTag from "../../components/StructureKindTag.astro";
---

<BaseLayout
  title="Sets"
  description="Compare sets where items stay forever, leave forever, or can return."
  territory="Structures"
  sheetTitle="Sets"
>
  <article class="set-family">
    <header class="page-intro">
      <p class="territory-label">Structure family</p>
      <h1>Sets</h1>
      <p>
        A set is a collection of unique items. The main question is what should
        happen after someone removes an item. Can it return later, or is the
        removal permanent?
      </p>
      <LessonIllustration id="structures-sets" />
    </header>

    <section aria-labelledby="g-set-title">
      <header>
        <div>
          <StructureKindTag kind="CRDT" />
          <h2 id="g-set-title">GSet</h2>
          <p>A set where added items stay forever.</p>
        </div>
        <code>g_set_kernel</code>
      </header>
      <div class="structure-body">
        <div>
          <p>
            A GSet can add items but cannot remove them. When people share
            their lists, the set keeps every item that appears on any list.
          </p>
          <h3>Best for</h3>
          <ul>
            <li>Recorded event IDs, observed devices, and permanent labels</li>
            <li>Membership that must only grow</li>
          </ul>
        </div>
        <dl>
          <div><dt>Updates</dt><dd>Add only</dd></div>
          <div><dt>How copies combine</dt><dd>Keep every listed item</dd></div>
          <div><dt>What it remembers</dt><dd>Every item ever added</dd></div>
        </dl>
      </div>
      <a class="structure-link" href="/structures/g-set/">
        Open the GSet lesson
      </a>
    </section>

    <section aria-labelledby="two-p-set-title">
      <header>
        <div>
          <StructureKindTag kind="CRDT" />
          <h2 id="two-p-set-title">TwoPSet</h2>
          <p>A set where removed items cannot return.</p>
        </div>
        <code>two_p_set_kernel</code>
      </header>
      <div class="structure-body">
        <div>
          <p>
            A TwoPSet keeps one list of added items and another list of removed
            items. Once an item appears on the removed list, nobody can add the
            same item again.
          </p>
          <h3>Best for</h3>
          <ul>
            <li>Revoked credentials and decommissioned equipment</li>
            <li>Membership where removal must win permanently</li>
          </ul>
        </div>
        <dl>
          <div><dt>Updates</dt><dd>Add once, remove once</dd></div>
          <div><dt>How copies combine</dt><dd>Keep every addition and removal</dd></div>
          <div><dt>What it remembers</dt><dd>Items and permanent removals</dd></div>
        </dl>
      </div>
      <a class="structure-link" href="/structures/two-p-set/">
        Open the TwoPSet lesson
      </a>
    </section>

    <section aria-labelledby="or-set-title">
      <header>
        <div>
          <StructureKindTag kind="CRDT" />
          <h2 id="or-set-title">Observed-remove set</h2>
          <p>A set where an item can be removed and added again.</p>
        </div>
        <code>or_set_kernel</code>
      </header>
      <div class="structure-body">
        <div>
          <p>
            This set gives each addition its own identity. A removal affects
            only the additions that person has already seen. An addition made
            at the same time, or later, can stay in the set.
          </p>
          <h3>Best for</h3>
          <ul>
            <li>Collaborative selections, tags, rosters, and carts</li>
            <li>Membership that must support remove and re-add</li>
          </ul>
        </div>
        <dl>
          <div><dt>Updates</dt><dd>Add, remove, and re-add</dd></div>
          <div><dt>How copies combine</dt><dd>Keep additions that were not removed</dd></div>
          <div><dt>What it remembers</dt><dd>Each addition and known removals</dd></div>
        </dl>
      </div>
      <a class="structure-link" href="/structures/observed-remove-set/">
        Open the observed-remove set lesson
      </a>
    </section>

    <section class="family-comparison" aria-labelledby="set-choice-title">
      <h2 id="set-choice-title">Choose what removal means</h2>
      <table aria-label="Set comparison">
        <thead>
          <tr>
            <th scope="col">Need</th>
            <th scope="col">Choose</th>
            <th scope="col">Cost</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">No item removal</th>
            <td>GSet</td>
            <td>Remember each item</td>
          </tr>
          <tr>
            <th scope="row">Removal is permanent</th>
            <td>TwoPSet</td>
            <td>Remember every removed item</td>
          </tr>
          <tr>
            <th scope="row">Items can return</th>
            <td>Observed-remove set</td>
            <td>Remember each addition and removal</td>
          </tr>
        </tbody>
      </table>
    </section>

    <StructureNext />
  </article>
</BaseLayout>

<style>
  .set-family {
    max-width: var(--measure-reading);
    margin-inline: auto;
  }

  .page-intro {
    margin-bottom: var(--space-7);
  }

  .page-intro > p:last-of-type {
    font-size: 1.2rem;
  }

  .set-family > section:not(.family-comparison) {
    position: relative;
    margin-top: var(--space-7);
    padding: var(--space-5);
    border: var(--rule-width) solid var(--line);
    background: var(--clear);
  }

  section > header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: var(--rule-width) solid var(--line);
  }

  section h2,
  section header p {
    margin: 0;
  }

  section h2 {
    margin-block: var(--space-1);
  }

  section header code {
    color: var(--muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .structure-body {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(15rem, 0.7fr);
    gap: var(--space-6);
    padding-block: var(--space-5);
  }

  .structure-body p,
  .structure-body h3 {
    margin-top: 0;
  }

  .structure-body h3 {
    margin-bottom: var(--space-2);
    font-size: 1rem;
  }

  .structure-body ul {
    margin-bottom: 0;
  }

  dl {
    margin: 0;
    border-block: var(--rule-width) solid var(--line);
  }

  dl div {
    padding-block: var(--space-3);
  }

  dl div + div {
    border-top: var(--rule-width) solid var(--line-faint);
  }

  dt {
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 700;
  }

  dd {
    margin: var(--space-1) 0 0;
  }

  .structure-link {
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 700;
  }

  .family-comparison {
    margin-top: var(--space-7);
  }

  table {
    width: 100%;
    margin-block: var(--space-4);
    border-collapse: collapse;
  }

  :is(th, td) {
    padding: var(--space-3);
    border-block: var(--rule-width) solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  th {
    font-family: var(--font-ui);
  }

  @media (width < 42rem) {
    .set-family > section:not(.family-comparison) {
      padding: var(--space-4);
    }

    section > header,
    .structure-body {
      grid-template-columns: 1fr;
    }

    section > header {
      display: grid;
      gap: var(--space-2);
    }

    .family-comparison {
      overflow-x: auto;
    }
  }
</style>
