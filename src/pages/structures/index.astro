---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { structureGroup, structureGroups } from "../../lib/structure-demo/structure-navigation";
---

<BaseLayout
  title="Structures"
  description="Learn how shared data can handle changes from several people."
  sheetTitle="Structures"
>
  <header class="page-intro">
    <h1>Structures</h1>
    <p>
      Compare replicated data structures by the updates they support and the
      rules they use to combine shared state.
    </p>
    <a class="atlas-entry" href="/structures/models/">
      Compare CRDT, DDS, and OT structures
    </a>
  </header>

  <nav class="structure-guide" aria-label="Choose by need">
    <h2>Compare by need</h2>
    <p>A changing total? <a href={structureGroup("counters").href}>Compare counters</a>.
      Membership with removals? <a href={structureGroup("sets").href}>Compare sets</a>.
      Several answers to one question? <a href={structureGroup("registers").href}>Compare registers</a>.</p>
  </nav>

  <ul class="structure-index" aria-label="Structure lessons">
    {structureGroups.map((group) => (
      <li><a href={group.href}>
        <h2>{group.title}</h2>
        <p>{group.summary}</p>
      </a></li>
    ))}
  </ul>
</BaseLayout>

<style>
  .page-intro,
  .structure-guide,
  .structure-index {
    max-width: var(--measure-reading);
    margin-inline: auto;
  }

  .structure-guide {
    padding-block: var(--space-4);
    border-block: var(--rule-width) solid var(--line);
  }

  .structure-guide h2,
  .structure-guide p {
    margin-block: 0 var(--space-2);
  }

  .structure-index {
    padding: 0;
    list-style: none;
  }

  .structure-index li {
    border-top: var(--rule-width) solid var(--line);
  }

  .structure-index li > a {
    display: grid;
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-4);
    min-height: 44px;
    align-items: baseline;
    padding-block: var(--space-5);
    color: inherit;
    text-decoration-color: var(--line);
  }

  .structure-index h2,
  .structure-index p {
    margin: 0;
  }

  @media (width < 48rem) {
    .structure-index li > a {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
