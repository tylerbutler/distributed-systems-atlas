---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Structures"
  description="Learn replicated data structures through focused family and structure lessons."
  sheetTitle="Structures"
>
  <header class="page-intro">
    <h1>Structures</h1>
    <p>
      Start with the value you need to share. Each lesson introduces the
      metadata only when its merge rule needs it.
    </p>
  </header>

  <ol class="structure-index" aria-label="Structure lessons">
    <li>
      <a href="/structures/counters/">
        <h2>Counters</h2>
        <p>Compare grow-only, correcting, and sequenced counters.</p>
        <span class="status">Read now</span>
      </a>
    </li>
    <li>
      <a href="/structures/sets/">
        <h2>Sets</h2>
        <p>Compare add-only, permanent-removal, and observed-removal rules.</p>
        <span class="status">Read now</span>
      </a>
    </li>
    <li>
      <a href="/structures/registers/">
        <h2>Registers</h2>
        <p>Compare clock-selected, conflict-preserving, and sequenced registers.</p>
        <span class="status">Read now</span>
      </a>
    </li>
    <li>
      <a href="/structures/maps/">
        <h2>Maps</h2>
        <p>Compare sequenced, timestamped, observed-remove, and hierarchical maps.</p>
        <span class="status">Read now</span>
      </a>
    </li>
    <li>
      <a href="/structures/sequences/">
        <h2>Sequences</h2>
        <p>Keep ordered items and graphemes stable through concurrent edits.</p>
        <span class="status">Read now</span>
      </a>
    </li>
    <li>
      <a href="/structures/coordination/">
        <h2>Coordination</h2>
        <p>Choose one owner, worker, assignee, or accepted value.</p>
        <span class="status">Read now</span>
      </a>
    </li>
    <li>
      <a href="/structures/transforms/">
        <h2>Transforms</h2>
        <p>Transform concurrent JSON and rich-text operations.</p>
        <span class="status">Read now</span>
      </a>
    </li>
  </ol>
</BaseLayout>

<style>
  .page-intro,
  .structure-index {
    max-width: var(--measure-reading);
    margin-inline: auto;
  }

  .structure-index {
    padding: 0;
    list-style: none;
    counter-reset: structures;
  }

  .structure-index li {
    border-top: var(--rule-width) solid var(--line);
    counter-increment: structures;
  }

  .structure-index li > a {
    display: grid;
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.3fr) auto;
    gap: var(--space-4);
    min-height: 44px;
    align-items: baseline;
    padding-block: var(--space-5);
    color: inherit;
    text-decoration-color: var(--line);
  }

  .structure-index h2,
  .structure-index p {
    margin: 0;
  }

  .structure-index h2::before {
    content: counter(structures) ". ";
    color: var(--muted);
    font-family: var(--font-data);
    font-size: 0.875rem;
  }

  @media (width < 48rem) {
    .structure-index li > a {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
