---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LessonIllustration from "../../components/LessonIllustration.astro";
import StructureFacts from "../../components/StructureFacts.astro";
import SetStructureDemo from "../../components/SetStructureDemo.astro";
import TermCallout from "../../components/TermCallout.astro";
import "../../styles/set-lesson.css";

type NotebookEntry = { element: string; dot: string };
type NotebookRow = {
  name: string;
  additions: NotebookEntry[];
  removals: NotebookEntry[];
  counter: number;
  dots: string[];
};

const notebookCheckpoints: Array<{
  title: string;
  label: string;
  note: string;
  rows: NotebookRow[];
}> = [
  {
    title: "Before contact is lost",
    label: "Observed-remove notebooks before contact is lost",
    note: "Alice's original note has reached all three notebooks.",
    rows: [
      {
        name: "Alice",
        additions: [{ element: "Eagle Creek", dot: "A:1" }],
        removals: [],
        counter: 1,
        dots: ["A:1"],
      },
      {
        name: "Bob",
        additions: [{ element: "Eagle Creek", dot: "A:1" }],
        removals: [],
        counter: 1,
        dots: ["A:1"],
      },
      {
        name: "Carol",
        additions: [{ element: "Eagle Creek", dot: "A:1" }],
        removals: [],
        counter: 1,
        dots: ["A:1"],
      },
    ],
  },
  {
    title: "While notes are blocked",
    label: "Observed-remove notebooks before records meet",
    note: "Alice records the removal while Bob records the replacement. Carol still has the earlier page.",
    rows: [
      {
        name: "Alice",
        additions: [],
        removals: [{ element: "Eagle Creek", dot: "A:1" }],
        counter: 1,
        dots: [],
      },
      {
        name: "Bob",
        additions: [
          { element: "Eagle Creek", dot: "A:1" },
          { element: "Eagle Creek", dot: "B:2" },
        ],
        removals: [],
        counter: 2,
        dots: ["A:1", "B:2"],
      },
      {
        name: "Carol",
        additions: [{ element: "Eagle Creek", dot: "A:1" }],
        removals: [],
        counter: 1,
        dots: ["A:1"],
      },
    ],
  },
  {
    title: "After every note arrives",
    label: "Observed-remove notebooks after records meet",
    note: "All three notebooks retain the replacement dot and the old dot's removal.",
    rows: [
      {
        name: "Alice",
        additions: [{ element: "Eagle Creek", dot: "B:2" }],
        removals: [{ element: "Eagle Creek", dot: "A:1" }],
        counter: 2,
        dots: ["B:2"],
      },
      {
        name: "Bob",
        additions: [{ element: "Eagle Creek", dot: "B:2" }],
        removals: [{ element: "Eagle Creek", dot: "A:1" }],
        counter: 2,
        dots: ["B:2"],
      },
      {
        name: "Carol",
        additions: [{ element: "Eagle Creek", dot: "B:2" }],
        removals: [{ element: "Eagle Creek", dot: "A:1" }],
        counter: 2,
        dots: ["B:2"],
      },
    ],
  },
];
---

<BaseLayout
  title="Observed-remove set"
  description="Alice removes an old beacon while Bob concurrently adds its replacement under a fresh identity."
  territory="Structures"
  sheetTitle="Observed-remove set"
>
  <article class="set-lesson">
    <header class="page-intro">
      <p class="territory-label">Structures</p>
      <h1>Observed-remove set</h1>
      <p class="structure-summary">
        Alice must remove the old Eagle Creek beacon while Bob reports its
        replacement from another trail. Carol still has an older notebook and
        may receive their records in either order. The ranger needs the
        replacement to remain without restoring the old installation.
      </p>
      <LessonIllustration id="structures-observed-remove-set" />
    </header>

    <StructureFacts
      structure="Observed-remove set"
      family="CRDT"
      model="State-based observed-remove set"
      updates="Add, remove, and re-add"
      merge="Union addition dots, then subtract observed removals."
      delivery="Safe under repeated and out-of-order delivery"
      bestFor="Collaborative membership where values can return"
      cost="Live addition dots plus retained removal knowledge"
    />

    <section aria-labelledby="identity-title">
      <h2 id="identity-title">A replacement needs a new identity</h2>
      <p>
        Alice's original report gave the old beacon a{" "}
        <dfn><a href="/glossary/#dot">dot</a></dfn>: <code>A:1</code>. A dot
        combines the writer's replica ID with a local counter. After Alice
        observes that installation, her removal targets <code>A:1</code>. It
        does not remove every future beacon called Eagle Creek.
      </p>
      <TermCallout
        term="dot"
        definition="A unique event identifier made from a replica ID and a local counter."
      />
      <p>
        Before the stations lose contact, both Bob and Carol receive Alice's
        <code>A:1</code> note. They copy it into their additions pages and
        record <code>1</code> as the highest dot counter seen. Carol makes no
        later change, so her notebook remains a stale copy of that original
        state. Losing contact stops new notes; it does not erase what anyone
        already wrote.
      </p>
      <p>
        Bob then adds the replacement while his station and Alice's station
        cannot exchange notes. He increments the stored counter from
        <code>1</code> to <code>2</code> and combines it with his replica ID,
        so the replacement receives <code>B:2</code>. An{" "}
        <dfn><a href="/glossary/#observed-remove-set">observed-remove set</a></dfn>
        {" "}removes only the addition identities that the removing replica
        observed.
      </p>
      <TermCallout
        term="observed-remove set"
        definition="A replicated set whose remove operation targets only addition dots observed by the removing replica."
      />
      <p>
        Each additions-page row pairs a beacon name with its dot. Each
        removals-page row copies the same pair, so an old note cannot restore
        that installation. The notebook also keeps the highest dot counter seen.
        The counter is shared across the dots in this set, not restarted for
        each writer.
      </p>
      <div class="notebook-checkpoints">
        {notebookCheckpoints.map((checkpoint) => (
          <figure>
            <h3>{checkpoint.title}</h3>
            <p>{checkpoint.note}</p>
            <div class="notebook-table-scroll">
              <table aria-label={checkpoint.label}>
                <thead>
                  <tr>
                    <th scope="col">Notebook</th>
                    <th scope="col">Additions page</th>
                    <th scope="col">Removals page</th>
                    <th scope="col">Highest dot counter seen</th>
                    <th scope="col">Visible list</th>
                  </tr>
                </thead>
                <tbody>
                  {checkpoint.rows.map((row) => (
                    <tr>
                      <th scope="row">{row.name}</th>
                      <td>
                        {row.additions.length
                          ? row.additions.map((entry) => (
                              <span>{entry.element}: <code>{entry.dot}</code><br /></span>
                            ))
                          : "empty"}
                      </td>
                      <td>
                        {row.removals.length
                          ? row.removals.map((entry) => (
                              <span>{entry.element}: <code>{entry.dot}</code><br /></span>
                            ))
                          : "empty"}
                      </td>
                      <td><code>{row.counter}</code></td>
                      <td>
                        {row.dots.length
                          ? <span class="visible-member">Eagle Creek{row.dots.map((dot) => <sup>{dot}</sup>)}</span>
                          : "empty"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </figure>
        ))}
      </div>
    </section>

    <SetStructureDemo
      kind="or-set"
      title="Keep the replacement, not the old beacon"
      description="Alice removes the installation she observed while Bob concurrently installs a replacement under a fresh identity."
      rule="Remove observed dots; keep concurrent fresh dots."
      raceLabel="Race removal against replacement"
    />

    <section aria-labelledby="add-wins-title">
      <h2 id="add-wins-title">The concurrent replacement wins</h2>
      <p>
        Alice had not seen <code>B:2</code> when she removed the old beacon,
        so her removal applies only to <code>A:1</code>, the dot she had seen.
        Bob's concurrent addition survives. This is the set's add-wins rule.
      </p>
      <aside class="term-callout perspective-note" aria-labelledby="perspective-title">
        <h3 class="term-callout-label" id="perspective-title">Alternative perspective</h3>
        <p>
          The dots make the two Eagle Creek installations separate entries.
          Alice can remove the <code>A:1</code> entry she saw. Bob's
          <code>B:2</code> entry is not in her notebook yet, so she cannot
          remove it.
        </p>
      </aside>
      <p>
        A delayed copy of <code>A:1</code> does not return. The replicas retain
        removal knowledge for that exact dot. The visible value is still Eagle
        Creek, but the notebook's surviving <code>B:2</code> identity proves
        that it is the replacement.
      </p>
      <p>
        The full reference lesson lets you temporarily block notes between
        Alice and Bob, preserve a stale copy, exchange the conflicting deltas,
        and inspect the live dots and tombstones.
      </p>
      <p class="lesson-entry">
        <a href="/atlas/observed-remove-sets/">Open the interactive observed-remove set lesson</a>
      </p>
    </section>

    <section aria-labelledby="notes-title">
      <h2 id="notes-title">Sources and implementation</h2>
      <p>
        The interactive lesson calls Watershed's{" "}
        <a href="https://github.com/tylerbutler/watershed/blob/4a8739323ee491f353fcaa8ccfb0488419c1cd43/src/watershed/or_set_kernel.gleam">OR-set kernel</a>
        {" "}through the stable Atlas toolkit.
      </p>
    </section>

    <nav class="structure-next" aria-label="Continue through set structures">
      <a href="/structures/two-p-set/">Back to TwoPSet</a>
      <a href="/structures/sets/">Browse set family</a>
      <a href="/structures/registers/">Continue to registers</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .notebook-checkpoints {
    display: grid;
    margin-block: var(--space-6);
    gap: var(--space-6);
  }

  .notebook-checkpoints figure {
    margin: 0;
  }

  .notebook-checkpoints h3 {
    margin-bottom: var(--space-1);
  }

  .notebook-checkpoints figure > p {
    margin-top: 0;
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }

  .notebook-table-scroll {
    overflow-x: auto;
  }

  .visible-member {
    white-space: nowrap;
  }

  .visible-member sup {
    margin-left: 0.2rem;
    color: var(--instrument-deep);
    font-size: 0.72em;
    font-weight: 750;
  }

  .visible-member sup + sup {
    margin-left: 0;
  }

  .visible-member sup + sup::before {
    content: ", ";
  }

  .lesson-entry {
    margin-top: var(--space-5);
    font-family: var(--font-ui);
    font-weight: 700;
  }
</style>
