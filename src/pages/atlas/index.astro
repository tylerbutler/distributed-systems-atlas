---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtlasTerritory from "../../components/AtlasTerritory.astro";
import ComplexityBadge from "../../components/ComplexityBadge.astro";
import {
  sheetReferenceId,
  validateSheetGraph,
  type SheetMeta,
  type Territory,
} from "../../lib/atlas/graph";
import { buildAtlasEntries, buildTrail } from "../../lib/atlas/trail";
import { scenarioIds } from "../../lib/lab/scenarios";

const sheets = await getCollection("sheet");
const metadata: SheetMeta[] = sheets.map((entry) => ({ id: entry.id, ...entry.data }));
const issues = validateSheetGraph(metadata, scenarioIds());
if (issues.length > 0) {
  throw new Error(
    `Invalid atlas content graph:\n${issues
      .map((issue) => `${issue.sheet}.${issue.field}: ${issue.problem} ${issue.target}`)
      .join("\n")}`,
  );
}

const entries = buildAtlasEntries(metadata);
const trail = buildTrail(metadata);
const territories = [
  ["structures", "Structures", "Replicated data types and the tradeoffs they make."],
  ["mechanisms", "Mechanisms", "The causal bookkeeping that explains each structure's behavior."],
  ["failures", "Failure modes", "Reproducible bugs and the mechanisms that cause or prevent them."],
  ["systems", "Systems", "Individual mechanisms connected into larger architectures."],
] as const satisfies readonly (readonly [Territory, string, string])[];
---

<BaseLayout title="Reference atlas" description="Find replicated structures, causal mechanisms, failure modes, and systems by topic.">
  <header class="page-intro">
    <h1>Reference atlas</h1>
    <p>Use this map to find a structure, mechanism, failure mode, or system by topic.</p>
    <p>New to the subject? <a href="/structures/">Explore the structure lessons.</a></p>
  </header>
  <nav class="first-trail" id="trail" aria-labelledby="first-trail-title">
    <h2 id="first-trail-title">Causal evidence trail</h2>
    <p>
      Begin with two structures, then inspect the causal evidence behind them.
      Open the background links on each sheet when you need more detail.
    </p>
    <ol class="first-trail-steps">
      {trail.map((step) => (
        <li>{step.status === "published"
          ? <><a href={`/atlas/${step.id}/`}>{step.title}</a> <ComplexityBadge complexity={step.complexity} /></>
          : <>{step.title} <span class="status">Planned</span> <ComplexityBadge complexity={step.complexity} /></>}</li>
      ))}
    </ol>
    <a class="trail-overview" href="#territories">Browse topics by territory</a>
  </nav>
  <div class="territory-chart" id="territories" data-testid="territory-chart">
    {territories.map(([id, title, summary]) => (
      <AtlasTerritory
        {id}
        {title}
        {summary}
        sheets={entries.filter((entry) => entry.territory === id).map((sheet) => ({
          ...sheet,
          prerequisiteTitles: sheet.requires.map((required) =>
            metadata.find((entry) => entry.id === sheetReferenceId(required))!.title
          ),
        }))}
      />
    ))}
  </div>
  <p class="publication-note">Only completed sheets link to routes. Planned sheets mark the next stops, not unfinished pages.</p>
</BaseLayout>

<style>
  .first-trail {
    padding-block: var(--space-5);
    margin-bottom: var(--space-7);
    border-block: var(--rule-width) solid var(--line);
  }

  .first-trail h2 {
    margin: 0 0 var(--space-4);
    font-size: 1.25rem;
  }

  .first-trail p {
    margin-bottom: var(--space-3);
  }

  .first-trail-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-3) var(--space-6);
    padding-inline-start: 1.5rem;
  }

  .first-trail-steps li {
    padding-inline-start: var(--space-2);
  }

  .first-trail a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .trail-overview {
    font-family: var(--font-ui);
    font-weight: 650;
  }

  .territory-chart {
    position: relative;
  }

  .territory-chart::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 14rem;
    border-left: var(--rule-width) solid var(--instrument);
  }

  .publication-note {
    margin: var(--space-5) 0 0;
    color: var(--muted);
    font: 1rem / 1.6 var(--font-ui);
  }

  @media (width <= 64rem) {
    .territory-chart::before {
      left: 0;
    }
  }

  @media (width < 40rem) {
    .territory-chart::before {
      display: none;
    }
  }
</style>
