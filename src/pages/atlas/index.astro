---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtlasTerritory from "../../components/AtlasTerritory.astro";
import {
  sheetReferenceId,
  validateSheetGraph,
  type SheetMeta,
  type Territory,
} from "../../lib/atlas/graph";
import { buildAtlasEntries, buildTrail } from "../../lib/atlas/trail";
import { scenarioIds } from "../../lib/lab/scenarios";

const sheets = await getCollection("sheet");
const metadata: SheetMeta[] = sheets.map((entry) => ({ id: entry.id, ...entry.data }));
const issues = validateSheetGraph(metadata, scenarioIds());
if (issues.length > 0) {
  throw new Error(
    `Invalid atlas content graph:\n${issues
      .map((issue) => `${issue.sheet}.${issue.field}: ${issue.problem} ${issue.target}`)
      .join("\n")}`,
  );
}

const entries = buildAtlasEntries(metadata);
const trail = buildTrail(metadata);
const territories = [
  ["structures", "Structures", "Replicated data types and the tradeoffs they make."],
  ["mechanisms", "Mechanisms", "The causal bookkeeping that explains each structure's behavior."],
  ["failures", "Failure modes", "Reproducible bugs and the mechanisms that cause or prevent them."],
  ["systems", "Systems", "Individual mechanisms connected into larger architectures."],
] as const satisfies readonly (readonly [Territory, string, string])[];
---

<BaseLayout title="Atlas" description="Browse replicated data structures first, then open the causal mechanisms, failure modes, and systems that explain their behavior.">
  <header class="page-intro">
    <h1>Atlas</h1>
    <p>Start with the state you need to share: a counter, register, set, map, sequence, or larger system.</p>
    <p>Open the causal machinery when a structure's merge rule raises a question.</p>
  </header>
  <nav class="first-trail" aria-labelledby="first-trail-title">
    <h2 id="first-trail-title">Structure-first trail</h2>
    <ol aria-label="Structure-first trail">
      {trail.map((sheet) => (
        <li>
          {sheet.status === "published"
            ? <a href={`/atlas/${sheet.id}/`}>{sheet.title}</a>
            : <span>{sheet.title}</span>}
          {" "}<span class="status">{sheet.status === "published" ? "Read now" : "Planned"}</span>
        </li>
      ))}
    </ol>
  </nav>
  <div class="territory-chart" data-testid="territory-chart">
    {territories.map(([id, title, summary]) => (
      <AtlasTerritory
        {id}
        {title}
        {summary}
        sheets={entries.filter((entry) => entry.territory === id).map((sheet) => ({
          ...sheet,
          prerequisiteTitles: sheet.requires.map((required) =>
            metadata.find((entry) => entry.id === sheetReferenceId(required))!.title
          ),
        }))}
      />
    ))}
  </div>
  <p class="publication-note">Only completed sheets link to routes. Planned sheets mark the next stops, not unfinished pages.</p>
</BaseLayout>

<style>
  .first-trail {
    padding-block: var(--space-5);
    margin-bottom: var(--space-7);
    border-block: var(--rule-width) solid var(--line);
  }

  .first-trail h2 {
    margin: 0 0 var(--space-4);
    font-size: 1.25rem;
  }

  .first-trail ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin: 0;
    padding-left: 1.5rem;
    font-size: 1rem;
  }

  .first-trail li {
    flex: 0 1 10rem;
    padding-right: var(--space-3);
  }

  .first-trail li::marker {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .first-trail .status {
    display: block;
  }

  .first-trail a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .territory-chart {
    position: relative;
  }

  .territory-chart::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 14rem;
    border-left: var(--rule-width) solid var(--instrument);
  }

  .publication-note {
    margin: var(--space-5) 0 0;
    color: var(--muted);
    font: 1rem / 1.6 var(--font-ui);
  }

  @media (width <= 64rem) {
    .territory-chart::before {
      left: 0;
    }
  }

  @media (width < 40rem) {
    .first-trail ol {
      display: block;
    }

    .first-trail li + li {
      margin-top: var(--space-3);
    }

    .first-trail .status {
      display: inline;
      margin-left: var(--space-2);
    }

    .territory-chart::before {
      display: none;
    }
  }
</style>
