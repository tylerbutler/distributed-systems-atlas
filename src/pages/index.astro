---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingSignal from "../components/LandingSignal.astro";
import type { SheetMeta } from "../lib/atlas/graph";
import { buildTrail } from "../lib/atlas/trail";

const sheets: SheetMeta[] = (await getCollection("sheet")).map(
  (entry) => ({ id: entry.id, ...entry.data }),
);
const trail = buildTrail(sheets);
---

<BaseLayout description="Start with counters, registers, sets, and maps. Use illustrated essays and deterministic labs to see which causal machinery each replicated data structure needs.">
  <LandingSignal />

  <div class="landing-reading">
    <section aria-labelledby="structure-title">
      <h2 id="structure-title">Learn the behavior before the bookkeeping</h2>
      <p>
        A counter, set, register, and map each makes a different promise when
        updates are delivered late or in a different order. Start with that promise.
        Then open the metadata that makes it possible.
      </p>
      <dl>
        <div>
          <dt>Counters</dt>
          <dd>Independent increments can combine because addition does not need a winner.</dd>
        </div>
        <div>
          <dt>Sets</dt>
          <dd>Removal needs a rule for additions that were observed, concurrent, or replayed later.</dd>
        </div>
        <div>
          <dt>Registers</dt>
          <dd>Concurrent writes force a choice: select one value or preserve every sibling.</dd>
        </div>
        <div>
          <dt>Maps</dt>
          <dd>Each key composes one of those conflict rules into a larger state model.</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="trail-title">
      <h2 id="trail-title">Go deeper when a merge rule raises a question</h2>
      <p>
        The reference atlas connects structures to dots, histories, orders,
        and clocks. Each sheet includes an article and a deterministic lab.
      </p>
      <details class="learning-trail-disclosure">
        <summary>See the seven-sheet causal evidence trail</summary>
        <ol class="learning-trail" aria-label="Causal evidence trail">
          {trail.map((sheet) => (
            <li>
              {sheet.status === "published"
                ? <a href={`/atlas/${sheet.id}/`}>{sheet.title}</a>
                : <>
                    <span>{sheet.title}</span>
                    <span class="status">Planned</span>
                  </>}
            </li>
          ))}
        </ol>
      </details>
    </section>

    <section aria-labelledby="read-title">
      <h2 id="read-title">Open the machinery when you need it</h2>
      <p>
        When a structure keeps a concurrent value or rejects a stale replay,
        inspect the dots, causal context, and clocks behind that result. The
        mechanism is attached to a concrete question instead of presented as
        vocabulary to memorize first.
      </p>
      <p>
        You can read the lessons and view their static illustrations without
        JavaScript. The interactive demos need JavaScript to delay messages,
        make concurrent updates, and inspect replica state.
      </p>
    </section>

  </div>
</BaseLayout>

<style>
  .landing-reading {
    max-width: var(--measure-reading);
    margin-inline: auto;
  }

  section {
    margin-top: var(--space-8);
  }

  h2 {
    max-width: 24ch;
    margin-top: 0;
  }

  dl {
    margin-block: var(--space-6) 0;
  }

  dl > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: var(--rule-width) solid var(--line);
  }

  dt {
    font-family: var(--font-ui);
    font-weight: 650;
  }

  dd {
    margin: 0;
  }

  .learning-trail {
    padding-inline-start: 1.5rem;
    margin-block: var(--space-3) 0;
    font-family: var(--font-ui);
  }

  .learning-trail-disclosure {
    margin-top: var(--space-5);
    border-block: var(--rule-width) solid var(--line);
  }

  .learning-trail-disclosure summary {
    min-height: 44px;
    padding-block: var(--space-3);
    font-family: var(--font-ui);
    font-weight: 650;
    cursor: pointer;
  }

  .learning-trail li {
    border-bottom: var(--rule-width) solid var(--line);
  }

  .learning-trail a {
    display: flex;
    min-height: 44px;
    padding: var(--space-3);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .learning-trail li::marker {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .learning-trail .status {
    display: inline-block;
    flex: 0 0 auto;
  }

  @media (width < 48rem) {
    :global(.site-main:has(> .landing-signal)) {
      padding-block-start: var(--space-4);
    }

    dl > div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
